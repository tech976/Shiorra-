<%- include('./_styles') %>
<div class="admin">
    <%- include('./_nav') %>
    <div class="admin__main">

        <div class="adm-hero">
            <div class="adm-crumbs">
                <a href="/admin">Admin</a>
                <span class="sep">/</span>
                <a href="/admin/orders">Orders</a>
                <span class="sep">/</span>
                <strong><%= order.orderNumber %></strong>
            </div>
            <div class="adm-hero__row">
                <div>
                    <h1>Order <%= order.orderNumber %></h1>
                    <div class="adm-hero__sub adm-hero__sub--inline">
                        <span><%= order.createdAt.toISOString().slice(0,16).replace('T',' ') %></span>
                        <span class="adm-hero__sep">·</span>
                        <span class="badge badge--<%= order.status.toLowerCase() %>"><%= order.status %></span>
                        <span class="badge badge--<%= order.paymentStatus.toLowerCase() %>"><%= order.paymentStatus %></span>
                    </div>
                </div>
                <div class="adm-hero__actions">
                    <a href="/admin/orders" class="btn btn--ghost btn--sm">All orders</a>
                    <a href="/admin/orders/<%= order.id %>/invoice" target="_blank" class="btn btn--sm">Print invoice</a>
                </div>
            </div>
        </div>

        <div class="admin__panels">
            <section class="admin__panel">
                <div class="adm-card__head">
                    <h3>Items</h3>
                    <small><%= order.items.length %> line<%= order.items.length === 1 ? '' : 's' %></small>
                </div>
                <div class="adm-table-scroll">
                <table class="data-table">
                    <thead><tr><th>Product</th><th class="adm-num">Qty</th><th class="adm-num">Unit</th><th class="adm-num">Total</th></tr></thead>
                    <tbody>
                    <% order.items.forEach(function(it) { %>
                        <tr>
                            <td><strong><%= it.name %></strong></td>
                            <td class="adm-num"><%= it.quantity %></td>
                            <td class="adm-num"><%= formatINR(it.priceInPaise) %></td>
                            <td class="adm-num adm-money"><%= formatINR(it.totalInPaise) %></td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
                </div>

                <div class="adm-totals">
                    <div class="cart__row"><span>Subtotal</span><span class="adm-money"><%= formatINR(order.subtotalInPaise) %></span></div>
                    <div class="cart__row"><span>Shipping</span><span class="adm-money"><%= formatINR(order.shippingInPaise) %></span></div>
                    <% if (order.discountInPaise > 0) { %>
                        <div class="cart__row"><span>Discount<% if (order.couponCode) { %> · 🎟 <%= order.couponCode %><% } %></span><span class="adm-cell-discount">-<%= formatINR(order.discountInPaise) %></span></div>
                    <% } %>
                    <div class="cart__row cart__row--total"><span>Total</span><span class="adm-money"><%= formatINR(order.totalInPaise) %></span></div>
                </div>

                <hr class="adm-divider">

                <div class="adm-card__head">
                    <h3>Admin notes</h3>
                    <small>Private · Internal only</small>
                </div>
                <form action="/admin/orders/<%= order.id %>/notes" method="post" class="form-grid form-grid--admin" style="padding:18px">
                    <label class="form-grid__full">Internal notes
                        <textarea name="adminNotes" rows="3" placeholder="e.g. customer requested gift wrap; out of stock — restock by Fri…"><%= order.adminNotes || '' %></textarea>
                    </label>
                    <div class="form-grid__full" style="text-align:right"><button class="btn btn--sm">Save notes</button></div>
                </form>
            </section>

            <section class="admin__panel">
                <div class="adm-card__head">
                    <h3>Customer</h3>
                    <% if (order.user) { %>
                        <small><a href="/admin/users/<%= order.user.id %>" class="adm-link-accent">Profile</a></small>
                    <% } else { %>
                        <small>Guest checkout</small>
                    <% } %>
                </div>
                <% if (order.user) { %>
                <p class="adm-customer-block">
                    <strong><%= order.user.name || order.user.email %></strong><br>
                    <span class="adm-customer-block__email"><%= order.user.email %></span><br>
                    <span class="adm-customer-block__phone"><%= order.user.phone || '—' %></span>
                </p>
                <% } else { %>
                <p class="adm-customer-block">
                    <strong>Guest</strong><br>
                    <span class="adm-customer-block__email"><%= order.guestEmail || '—' %></span><br>
                    <span class="adm-customer-block__phone"><%= (order.shippingAddress && order.shippingAddress.phone) || '—' %></span>
                </p>
                <% } %>

                <% if (order.shippingAddress) { %>
                    <h4 class="adm-side-label">Shipping to</h4>
                    <address class="adm-address-block">
                        <%= order.shippingAddress.fullName %><br>
                        <%= order.shippingAddress.line1 %><br>
                        <% if (order.shippingAddress.line2) { %><%= order.shippingAddress.line2 %><br><% } %>
                        <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postcode %><br>
                        <%= order.shippingAddress.country %><br>
                        <%= order.shippingAddress.phone %>
                    </address>
                <% } %>

                <hr class="adm-divider">

                <div class="adm-card__head">
                    <h3>Update status</h3>
                </div>
                <form action="/admin/orders/<%= order.id %>/status" method="post" class="adm-inline-form">
                    <select name="status">
                        <% ['PENDING','PAID','PROCESSING','SHIPPED','DELIVERED','CANCELLED','REFUNDED'].forEach(function(s) { %>
                            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
                        <% }); %>
                    </select>
                    <button class="btn btn--sm">Update</button>
                </form>

                <hr class="adm-divider">

                <div class="adm-card__head">
                    <h3>Payment</h3>
                </div>
                <dl class="kvp">
                    <dt>Razorpay order</dt>
                    <dd><code><%= order.razorpayOrderId || '—' %></code></dd>
                    <dt>Payment id</dt>
                    <dd><code><%= order.razorpayPaymentId || '—' %></code></dd>
                    <dt>Status</dt>
                    <dd><span class="badge badge--<%= order.paymentStatus.toLowerCase() %>"><%= order.paymentStatus %></span></dd>
                    <% if (order.refundedInPaise > 0) { %>
                      <dt>Refunded</dt>
                      <dd><strong>₹<%= (order.refundedInPaise/100).toFixed(2) %></strong>
                        <% if (order.razorpayRefundId) { %><br><code><%= order.razorpayRefundId %></code><% } %>
                        <% if (order.refundReason) { %><br><small><%= order.refundReason %></small><% } %>
                      </dd>
                    <% } %>
                </dl>
                <% if (order.notes) { %>
                    <p class="adm-note-block"><em><%= order.notes %></em></p>
                <% } %>
            </section>
        </div>
    </div>
</div>


<!-- ============ FULFILMENT ============ -->
<section class="card" style="margin-top:22px">
  <h3 style="margin-top:0">Fulfilment</h3>
  <% if (order.awbNumber) { %>
    <dl class="kv">
      <dt>Courier</dt><dd><%= order.courier || 'Delhivery' %></dd>
      <dt>Waybill</dt><dd><code><%= order.awbNumber %></code></dd>
      <dt>Status</dt><dd><%= order.shipmentStatus || '—' %></dd>
      <% if (order.shippedAt) { %><dt>Shipped</dt><dd><%= order.shippedAt.toLocaleString('en-IN') %></dd><% } %>
      <% if (order.deliveredAt) { %><dt>Delivered</dt><dd><%= order.deliveredAt.toLocaleString('en-IN') %></dd><% } %>
      <% if (order.trackingUrl) { %><dt>Track</dt><dd><a href="<%= order.trackingUrl %>" target="_blank" rel="noopener">Open tracking ↗</a></dd><% } %>
    </dl>
    <form action="/admin/orders/<%= order.id %>/track" method="post" style="margin-top:12px">
      <button class="btn" type="submit">Refresh tracking</button>
    </form>
  <% } else { %>
    <% if (order.paymentStatus === 'CAPTURED') { %>
      <p style="color:#6B6B6B;font-size:14px">Not shipped yet. This hands the order to Delhivery and stores the waybill.</p>
      <form action="/admin/orders/<%= order.id %>/ship" method="post">
        <button class="btn" type="submit">Ship with Delhivery</button>
      </form>
    <% } else { %>
      <p style="color:#6B6B6B;font-size:14px">Shipping becomes available once the payment is captured.</p>
    <% } %>
  <% } %>
</section>

<!-- ============ REFUND ============ -->
<% var _refundable = (order.totalInPaise || 0) - (order.refundedInPaise || 0); %>
<section class="card" style="margin-top:22px">
  <h3 style="margin-top:0">Refund</h3>
  <% if (order.paymentStatus !== 'CAPTURED' && order.paymentStatus !== 'REFUNDED') { %>
    <p style="color:#6B6B6B;font-size:14px">Only a captured online payment can be refunded.</p>
  <% } else if (_refundable <= 0) { %>
    <p style="color:#6B6B6B;font-size:14px">Fully refunded — nothing outstanding.</p>
  <% } else { %>
    <p style="color:#6B6B6B;font-size:14px">
      Up to <strong>₹<%= (_refundable/100).toFixed(2) %></strong> can still be refunded.
      This moves real money through Razorpay and cannot be undone.
    </p>
    <form action="/admin/orders/<%= order.id %>/refund" method="post"
          onsubmit="return confirm('Refund this payment? Money leaves the account and this cannot be undone.')">
      <label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">Amount (₹) — blank refunds everything outstanding</label>
      <input name="amount" type="number" step="0.01" min="0.01" max="<%= (_refundable/100).toFixed(2) %>"
             placeholder="<%= (_refundable/100).toFixed(2) %>"
             style="padding:10px 12px;border:1px solid #E5E5E7;border-radius:8px;width:180px">
      <input name="reason" type="text" placeholder="Reason (optional)"
             style="padding:10px 12px;border:1px solid #E5E5E7;border-radius:8px;width:260px;margin-left:8px">
      <button class="btn" type="submit" style="margin-left:8px">Refund</button>
    </form>
  <% } %>
</section>
