<%# Site footer, shared by the homepage and the product pages.
    Base styling lives in style.css (.site-footer / .footer__*); only the
    responsive stacking and the year fill live here so every page that
    includes this gets them without copying anything. %>
<style>
  /* Footer — columns stack, tappable links */
  @media (max-width: 720px){
    .footer__top{grid-template-columns:1fr 1fr!important;gap:28px!important}
    .footer__brand{grid-column:1/-1}
    /* Tap-target sizing for the footer's TEXT links only. This used to read
       `.site-footer a`, which also caught the social circles and replaced
       their display:inline-flex with inline-block — killing the
       align-items/justify-content that centres the icon and dropping the SVG
       onto a 36px text baseline instead. That is why the glyphs sat low and
       left of centre. */
    .footer__col a,.footer__bottom a{min-height:36px;display:inline-block;line-height:36px}
    /* Re-assert the circles as centring flex boxes so no later or wider
       selector can knock the icon off-centre again. */
    .footer__social a{display:inline-flex;align-items:center;justify-content:center;line-height:1;min-height:0}
    /* inline SVGs sit on the text baseline by default, which leaves a few px
       of descender space under the glyph even inside a flex box */
    .footer__social svg{display:block}
    .footer__bottom{flex-direction:column;align-items:flex-start;gap:8px;text-align:left}
  }
  @media (max-width: 420px){
    .footer__top{grid-template-columns:1fr!important;gap:24px!important}
  }
</style>
    <footer class="site-footer" id="contact">
        <div class="container">
            <div class="footer__top">
                <div class="footer__brand">
                    <img src="/img/logo/logo-green.png" alt="Shiōrra">
                    <p>Shiōrra is a science-backed holistic wellness brand delivering effective nutrition for lasting everyday health support.</p>
                    <div class="footer__social">
                        <a href="#" aria-label="Instagram"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
                        <a href="#" aria-label="LinkedIn"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
                        <a href="#" aria-label="Email"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
                    </div>
                </div>

                <div class="footer__col">
                    <h5>Shop</h5>
                    <ul>
                        <li><a href="/product/advanced-iron">Advanced Iron+</a></li>
                        <li><a href="/product/advanced-iron#composition">Ingredients</a></li>
                        <li><a href="#">Subscriptions</a></li>
                        <li><a href="#">Bundles</a></li>
                    </ul>
                </div>

                <div class="footer__col">
                    <h5>Brand</h5>
                    <ul>                        <li><a href="/about">Founders</a></li>
                        
                        <li><a href="/reviews">Reviews</a></li>
                    </ul>
                </div>

                <div class="footer__col">
                    <h5>Support</h5>
                    <ul>
                        <li><a href="/faq">FAQ</a></li>
                        <li><a href="#">Shipping</a></li>
                        <li><a href="#">Returns</a></li>
                        <li><a href="#">Privacy &amp; Terms</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer__bottom">
                <span>© <span id="year"></span> Shiōrra™ · A trademark of K.C. Laboratories · Made in India</span>
                <span><a href="#">Privacy</a> · <a href="#">Terms</a></span>
            </div>
        </div>
    </footer>
<%# The markup ships an empty <span id="year">; nothing was filling it, so the
    copyright line rendered as "©  Shiōrra". Fill it here so every page that
    includes the footer gets a year. %>
<script>(function(){var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();})();</script>
