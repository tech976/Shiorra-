<!-- ============================================================
     Journey timeline — the "Evidence-Backed Formulation" section.

     Replaces the old chart-and-figures layout, which led with clinical
     notation (+2.12 g/dl, 87%, "Ferrous Bisglycinate") that a shopper
     has no way to parse. Here the surface is plain language on a track
     the reader clicks through; the figures survive, demoted into the
     "About these figures" note so substantiation is still one tap away.

     Self-contained (markup + CSS + JS), included once per product page.
     Every stage's copy must already be substantiated elsewhere on that
     page or on the pack — this component invents no onset claims.

     Expects a `jt` object:
       jt.eyebrow  small label above the title
       jt.title    heading (HTML — <em> gets the page accent)
       jt.lede     one-line intro (HTML)
       jt.stages   [{ k, h, s, points:[], proof? }]  k = track label
       jt.note     HTML for the collapsible evidence note
     Colours come from the host page's --honey / --ink / --line vars,
     so the same partial takes each product's accent automatically.
     ============================================================ -->
<section class="jt-sec" aria-labelledby="jtTitle">
  <style>
    .jt-sec{background:#FBF4F7;padding:82px 0}
    .jt-head{max-width:62ch;margin:0 0 40px}
    .jt-title{font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:clamp(28px,3.2vw,40px);font-weight:700;line-height:1.08;letter-spacing:-0.025em;color:var(--ink);margin:0 0 12px}
    .jt-title em{font-style:italic;font-weight:500;color:var(--honey)}
    .jt-lede{font-size:16px;line-height:1.6;color:var(--ink-soft);margin:0;max-width:52ch}

    /* ---- the track ----
       The filled line is its own element rather than a gradient on the track,
       so it can transition. Its length is --len, measured in JS from the
       active marker's real position: a percentage cannot work here, because
       the dots sit at the START of their grid cells, so the last dot's centre
       is not at 100%. Measuring also survives a label wrapping to two lines. */
    .jt-track{position:relative;display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:0;margin:0 0 34px}
    .jt-track::before,.jt-line{content:'';position:absolute;top:11px;height:2px;border-radius:2px}
    .jt-track::before{left:0;right:0;background:rgba(0,0,0,.10)}
    .jt-line{left:0;width:var(--len,0px);background:var(--honey);transition:width .45s cubic-bezier(.2,.7,.3,1)}

    .jt-dot{position:relative;z-index:1;display:flex;flex-direction:column;align-items:flex-start;gap:11px;
      background:none;border:0;padding:0 10px 0 0;cursor:pointer;text-align:left;font:inherit;color:inherit}
    .jt-dot__m{width:24px;height:24px;border-radius:50%;background:#FBF4F7;border:2px solid rgba(0,0,0,.16);
      display:grid;place-items:center;transition:border-color .3s ease,background .3s ease,transform .3s ease}
    .jt-dot__m::after{content:'';width:8px;height:8px;border-radius:50%;background:transparent;transition:background .3s ease}
    .jt-dot__k{font-size:12.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-soft);transition:color .3s ease}
    /* stages already passed read as done, the current one as current */
    .jt-dot.is-done .jt-dot__m{border-color:var(--honey);background:var(--honey)}
    .jt-dot.is-done .jt-dot__m::after{background:#fff}
    .jt-dot.is-active .jt-dot__m{border-color:var(--honey);transform:scale(1.16)}
    .jt-dot.is-active .jt-dot__m::after{background:var(--honey)}
    .jt-dot.is-active .jt-dot__k{color:var(--honey-deep)}
    .jt-dot:hover .jt-dot__m{border-color:var(--honey)}
    .jt-dot:focus-visible{outline:2px solid var(--honey);outline-offset:4px;border-radius:6px}

    /* ---- the panel ---- */
    .jt-panels{position:relative}
    .jt-panel{display:none;background:#fff;border:1px solid var(--line);border-radius:20px;padding:34px 36px;
      box-shadow:0 18px 44px rgba(107,34,85,.07)}
    .jt-panel.is-active{display:block;animation:jtIn .42s cubic-bezier(.2,.7,.3,1) both}
    @keyframes jtIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
    .jt-panel h3{font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:clamp(20px,2.1vw,26px);font-weight:700;letter-spacing:-0.02em;color:var(--ink);margin:0 0 8px}
    .jt-panel__s{font-size:15.5px;line-height:1.6;color:var(--ink-soft);margin:0 0 22px;max-width:56ch}

    .jt-points{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px 26px}
    .jt-points li{position:relative;padding-left:26px;font-size:14.5px;line-height:1.5;color:var(--ink)}
    .jt-points li::before{content:'';position:absolute;left:0;top:6px;width:14px;height:14px;border-radius:50%;
      background:color-mix(in srgb,var(--honey) 18%,transparent)}
    .jt-points li::after{content:'';position:absolute;left:4.6px;top:10.2px;width:5px;height:2.4px;border-radius:1px;background:var(--honey)}

    .jt-proof{margin:24px 0 0;padding:14px 16px;border-radius:12px;background:#FBF4F7;
      font-size:13px;line-height:1.5;color:var(--ink-soft)}
    .jt-proof b{color:var(--honey-deep);font-weight:700}

    /* ---- evidence note ---- */
    .jt-note{margin:22px 0 0;max-width:70ch}
    .jt-note summary{cursor:pointer;font-size:13px;font-weight:700;color:var(--ink-soft);list-style:none}
    .jt-note summary::-webkit-details-marker{display:none}
    .jt-note summary::before{content:'▸ ';color:var(--honey)}
    .jt-note[open] summary::before{content:'▾ '}
    .jt-note p{font-size:13px;line-height:1.6;color:var(--ink-soft);margin:10px 0 0}
    .jt-note ul{margin:10px 0 0;padding-left:18px;font-size:13px;line-height:1.75;color:var(--ink-soft)}

    @media (max-width: 860px){
      .jt-sec{padding:56px 0}
      .jt-head{margin-bottom:28px}
      /* Track goes vertical — 4 labels side by side is unreadable on a phone,
         and a horizontal scroller hides stages the reader never discovers. */
      .jt-track{grid-auto-flow:row;grid-auto-columns:auto;gap:0;margin-bottom:22px}
      .jt-track::before{left:11px;right:auto;top:0;bottom:0;width:2px;height:auto}
      .jt-line{left:11px;top:0;width:2px;height:var(--len,0px);transition:height .45s cubic-bezier(.2,.7,.3,1)}
      .jt-dot{flex-direction:row;align-items:center;gap:12px;padding:9px 0}
      .jt-panel{padding:24px 22px;border-radius:16px}
      .jt-points{grid-template-columns:1fr;gap:10px}
    }
    @media (prefers-reduced-motion: reduce){
      .jt-line,.jt-dot__m{transition:none}
      .jt-panel.is-active{animation:none}
    }
  </style>

  <div class="wrap">
    <div class="jt-head">
      <span class="s-eyebrow"><%= jt.eyebrow %></span>
      <h2 class="jt-title" id="jtTitle"><%- jt.title %></h2>
      <p class="jt-lede"><%- jt.lede %></p>
    </div>

    <%# Real buttons in a tablist: click, Tab and arrow keys all work, and a
        screen reader announces "tab 2 of 4" without extra scaffolding. %>
    <div class="jt-track" role="tablist" aria-label="Stages" id="jtTrack">
      <span class="jt-line" aria-hidden="true"></span>
      <% jt.stages.forEach(function (st, i) { %>
        <button type="button" role="tab" class="jt-dot<%= i === 0 ? ' is-active' : '' %>"
                id="jtTab<%= i %>" aria-controls="jtPanel<%= i %>"
                aria-selected="<%= i === 0 ? 'true' : 'false' %>" tabindex="<%= i === 0 ? '0' : '-1' %>">
          <span class="jt-dot__m" aria-hidden="true"></span>
          <span class="jt-dot__k"><%- st.k %></span>
        </button>
      <% }); %>
    </div>

    <div class="jt-panels">
      <% jt.stages.forEach(function (st, i) { %>
        <div class="jt-panel<%= i === 0 ? ' is-active' : '' %>" id="jtPanel<%= i %>"
             role="tabpanel" aria-labelledby="jtTab<%= i %>"<%= i === 0 ? '' : ' hidden' %>>
          <h3><%- st.h %></h3>
          <p class="jt-panel__s"><%- st.s %></p>
          <ul class="jt-points">
            <% st.points.forEach(function (p) { %><li><%- p %></li><% }); %>
          </ul>
          <% if (st.proof) { %><p class="jt-proof"><%- st.proof %></p><% } %>
        </div>
      <% }); %>
    </div>

    <details class="jt-note"><summary>About these figures</summary><%- jt.note %></details>
  </div>

  <script>
  (function () {
    const track = document.getElementById('jtTrack');
    if (!track) return;
    const tabs = Array.from(track.querySelectorAll('.jt-dot'));
    let cur = 0;
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')));
    if (!tabs.length) return;

    const show = (i, focus) => {
      tabs.forEach((t, n) => {
        const on = n === i;
        t.classList.toggle('is-active', on);
        // everything before the current stage reads as already travelled
        t.classList.toggle('is-done', n < i);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        if (panels[n]) {
          panels[n].classList.toggle('is-active', on);
          panels[n].hidden = !on;
        }
      });
      cur = i;
      measure();
      if (focus) tabs[i].focus();
    };

    // Run the line to the CENTRE of the active marker. Vertical below 860px,
    // where the track flips to a column — same measurement, other axis.
    function measure() {
      const m = tabs[cur] && tabs[cur].querySelector('.jt-dot__m');
      if (!m) return;
      const t = track.getBoundingClientRect();
      const r = m.getBoundingClientRect();
      const vertical = window.matchMedia('(max-width: 860px)').matches;
      const len = vertical ? (r.top + r.height / 2 - t.top) : (r.left + r.width / 2 - t.left);
      track.style.setProperty('--len', Math.max(0, Math.round(len)) + 'px');
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    track.addEventListener('keydown', (e) => {
      const i = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      if (i < 0) return;
      const last = tabs.length - 1;
      let n = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = i === last ? 0 : i + 1;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = i === 0 ? last : i - 1;
      else if (e.key === 'Home') n = 0;
      else if (e.key === 'End') n = last;
      if (n !== null) { e.preventDefault(); show(n, true); }
    });

    show(0);
    // The measured length is in px, so it has to be re-taken when the track
    // is re-laid out — including the flip between the row and column tracks.
    let rt;
    window.addEventListener('resize', function () {
      clearTimeout(rt);
      rt = setTimeout(measure, 120);
    });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  })();
  </script>
</section>
