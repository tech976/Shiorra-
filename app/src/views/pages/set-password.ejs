<style>
  .sp-page { background:#FAFAFA; padding:64px 20px 96px; min-height:calc(100vh - 160px); display:flex; justify-content:center; align-items:flex-start; }
  .sp-card { width:100%; max-width:448px; background:#fff; border:1px solid rgba(0,0,0,.06); border-radius:16px; padding:44px 40px 36px;
             box-shadow:0 1px 2px rgba(15,23,42,.04), 0 12px 32px -8px rgba(15,23,42,.08); }
  .sp-card h1 { font-family:'Helvetica Neue',Arial,sans-serif; font-size:26px; letter-spacing:-.02em; margin:0 0 8px; }
  .sp-card p.sp-sub { color:#6B6B6B; font-size:14.5px; line-height:1.6; margin:0 0 26px; }
  .sp-card p.sp-sub strong { color:#282828; }
  .sp-field { margin-bottom:18px; }
  .sp-field label { display:block; font-size:13px; font-weight:600; margin-bottom:7px; color:#3A3A3A; }
  .sp-field input { width:100%; padding:12px 14px; border:1px solid #E5E5E7; border-radius:10px; font-size:15px; font-family:inherit; background:#fff; }
  .sp-field input:focus { outline:2px solid rgba(35,134,127,.35); outline-offset:1px; border-color:#23867F; }
  .sp-hint { font-size:12.5px; color:#8A8A8A; margin-top:6px; }
  .sp-btn { width:100%; min-height:50px; background:#23867F; color:#fff; border:0; border-radius:12px; font-weight:700; font-size:15px; cursor:pointer; font-family:inherit; }
  .sp-btn:hover { background:#1d6f69; }
  @media (max-width:520px){ .sp-card { padding:32px 22px 28px; } }
</style>

<section class="sp-page">
  <div class="sp-card">
    <h1>Set your password</h1>
    <p class="sp-sub">
      Your account <strong><%= email %></strong> is ready — choose a password and
      you can track this order and see your history any time.
    </p>

    <form action="/set-password" method="post" novalidate>
      <input type="hidden" name="token" value="<%= token %>">
      <div class="sp-field">
        <label for="sp-pass">New password</label>
        <input id="sp-pass" name="password" type="password" minlength="8" required autocomplete="new-password" autofocus>
        <p class="sp-hint">At least 8 characters.</p>
      </div>
      <div class="sp-field">
        <label for="sp-confirm">Confirm password</label>
        <input id="sp-confirm" name="confirm" type="password" minlength="8" required autocomplete="new-password">
      </div>
      <button type="submit" class="sp-btn">Set password &amp; view my orders</button>
    </form>
  </div>
</section>
