                <svg class="cert__fb" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"<%- c.img ? '' : ' style="display:block"' %>><%- c.svg %></svg>
              </span>
              <span class="cert__t"><%= c.t %></span>
            </li>
          <% }); %>
        </ul>
      <% }); %>
    </div>
  </div>
</section>

