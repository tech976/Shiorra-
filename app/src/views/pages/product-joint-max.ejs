<!-- WHERE IT WORKS -->
<style>
  /* ============================================================
     WHERE IT WORKS — the joint, as the orbit's counterpart
     Iron+ and EnergyOne+ orbit a capsule because their subject is abstract:
     blood, energy. Joint Max is the only product in the range about a part of
     the body, so the centrepiece is that part. Same interaction grammar as the
     orbit (hover / focus / tap a region, a panel beside it fills in), which is
     what keeps the three pages reading as one family — and a component neither
     sibling could run, which is what makes it this page's own.
     The joint is inline SVG, not a photograph: slide 5 of the gallery already
     carries its own printed labels and they would fight the hover states, and
     SVG costs no image weight and stays sharp at any size.
     ============================================================ */
  .jx{background:linear-gradient(180deg,#FFFFFF 0%,var(--honey-soft) 100%);border-top:1px solid var(--line);padding:78px 0 84px}
  .jx__head{text-align:center;margin-bottom:14px}
  .jx__head .s-title{margin-inline:auto;margin-bottom:12px}
  .jx__sub{font-size:16px;line-height:1.6;color:var(--muted);max-width:56ch;margin:0 auto}
  .jx__hint{text-align:center;font-size:13px;color:var(--muted);margin:18px 0 34px}
  .jx__hint-touch{display:none}
  @media (hover:none){.jx__hint-hover{display:none}.jx__hint-touch{display:inline}}

  .jx-grid{display:grid;grid-template-columns:minmax(0,1fr) clamp(320px,34%,400px);gap:clamp(24px,4vw,56px);align-items:center}

  /* ---- the anatomy ---- */
  /* Three stacked copies of the same render. The base is the whole joint; the
     other two are the same file masked down to one region each, sitting on
     top at opacity 0. Light a region and the base drops back and desaturates
     while its layer fades in at full strength — so the part you are reading
     about is literally the only part still lit.
     Masks rather than overlays, deliberately: an overlay would put a coloured
     film over the anatomy, where a mask lets the render itself carry the
     emphasis. Measured off the file (1286x1223): the cartilage band runs
     27.8%-56.1% down and the subject sits x 24%-81%. */
  .jx-stage{position:relative;width:min(440px,100%);margin-inline:auto;aspect-ratio:1286 / 1223}
  .jx-layer{
    position:absolute;inset:0;width:100%;height:100%;object-fit:contain;
    /* The render is on pure white. multiply drops that out so the joint sits
       on the section's peach wash instead of in a white box. */
    mix-blend-mode:multiply;
  }
  .jx-base{transition:opacity .35s ease,filter .35s ease}
  .jx-stage.is-lit .jx-base{opacity:.38;filter:grayscale(.72)}
  .jx-part{opacity:0;transition:opacity .35s ease}
  .jx-part.is-on{opacity:1}
  .jx-part[data-part="cartilage"]{
    -webkit-mask-image:radial-gradient(ellipse 40% 17% at 52% 42%,#000 52%,transparent 100%);
            mask-image:radial-gradient(ellipse 40% 17% at 52% 42%,#000 52%,transparent 100%);
  }
  .jx-part[data-part="space"]{
    -webkit-mask-image:radial-gradient(ellipse 34% 8% at 51% 50%,#000 46%,transparent 100%);
            mask-image:radial-gradient(ellipse 34% 8% at 51% 50%,#000 46%,transparent 100%);
  }
  /* Two gradients, because "bone ends" is two bones. Mask layers union by
     default, so both light together. */
  .jx-part[data-part="bone"]{
    -webkit-mask-image:radial-gradient(ellipse 28% 17% at 51% 14%,#000 52%,transparent 100%),radial-gradient(ellipse 30% 22% at 51% 80%,#000 52%,transparent 100%);
            mask-image:radial-gradient(ellipse 28% 17% at 51% 14%,#000 52%,transparent 100%),radial-gradient(ellipse 30% 22% at 51% 80%,#000 52%,transparent 100%);
  }

  /* Markers sit on the anatomy and are the hit target — a 34px dot is easy to
     hit, where the cartilage band itself is a few pixels tall. */
  .jx-hit{
    position:absolute;width:34px;height:34px;margin:-17px 0 0 -17px;padding:0;
    border:0;background:none;cursor:pointer;z-index:3;border-radius:50%;
  }
  .jx-hit::before{
    content:'';position:absolute;inset:9px;border-radius:50%;
    background:var(--honey);box-shadow:0 0 0 4px rgba(224,69,38,.22),0 2px 6px rgba(120,30,10,.3);
    transition:transform .25s ease,box-shadow .25s ease;
  }
  .jx-hit:hover::before,.jx-hit:focus-visible::before{transform:scale(1.35);box-shadow:0 0 0 7px rgba(224,69,38,.26),0 2px 8px rgba(120,30,10,.34)}
  /* One piece of ambient motion on the page, and it earns its place: without
     it nothing says the anatomy is touchable. It runs only until the first
     region is read, then stops for good. */
  .jx-hit::after{
    content:'';position:absolute;inset:9px;border-radius:50%;
    border:2px solid var(--honey);animation:jxPulse 2.6s ease-out infinite;
  }
  .jx-stage.is-lit .jx-hit::after,.jx-hit:hover::after,.jx-hit:focus-visible::after{animation:none;opacity:0}
  @keyframes jxPulse{
    0%{transform:scale(1);opacity:.55}
    70%{transform:scale(2.3);opacity:0}
    100%{transform:scale(2.3);opacity:0}
  }
  @media (prefers-reduced-motion:reduce){.jx-hit::after{animation:none;opacity:0}}
  .jx-hit:focus-visible{outline:2px solid var(--honey-deep);outline-offset:3px}
  /* the ring that marks which region is being read */
  .jx-ring{
    position:absolute;border:2px dashed var(--honey);border-radius:999px;
    opacity:0;transition:opacity .3s ease;pointer-events:none;z-index:2;
  }
  .jx-ring.is-on{opacity:1}

  /* ---- panel ---- */
  .jx-side{min-width:0}
  .jx-info{display:grid;min-width:0}
  .jx-card{
    grid-area:1 / 1;align-self:center;
    background:#fff;border:1px solid var(--line);border-radius:22px;
    padding:30px 32px 32px;box-shadow:0 14px 40px rgba(197,62,35,.08);
    opacity:0;visibility:hidden;transform:translateY(7px);
    /* No transition at rest, deliberately: the cards share one grid cell, so a
       symmetric crossfade would show two sets of text through each other. */
  }
  .jx-card.is-on{opacity:1;visibility:visible;transform:none;transition:opacity .2s ease,transform .2s ease}
  .jx-card__k{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--honey-deep);margin:0 0 8px}
  .jx-card__t{font-size:23px;font-weight:700;letter-spacing:-0.02em;color:var(--ink);margin:0 0 14px;line-height:1.2}
  .jx-card__p{font-size:15.5px;line-height:1.65;color:var(--ink-soft);margin:0}
  /* The ingredient sentence in each card. A tinted highlight rather than bold:
     bold at this size competes with the card heading, where a wash of the
     brand peach reads as "this is the line that matters" without shouting.
     box-decoration-break keeps the tint rounded on every wrapped line instead
     of only the first and last. */
  .jx-card__p mark{
    background:var(--honey-soft);color:var(--ink);
    padding:1px 3px;border-radius:4px;
    -webkit-box-decoration-break:clone;box-decoration-break:clone;
  }
  /* The dose chip only appears on the regions an active actually acts on, so
     the 1500 mg and 1200 mg figures stay on the page without a separate card. */
  .jx-doses{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
  .jx-dose{
    display:inline-flex;align-items:baseline;gap:6px;margin:0;
    background:var(--honey-soft);border-radius:999px;padding:9px 16px;
  }
  .jx-dose b{font-size:19px;font-weight:800;letter-spacing:-0.02em;color:var(--honey-deep)}
  .jx-dose span{font-size:13px;font-weight:600;color:var(--ink-soft)}
  /* Touch fallback. The regions inside the SVG are the right hit areas for a
     pointer, but at phone size the cartilage band is a 20px strip and three
     of them cannot each be a 44px target inside a 60-unit joint. So below the
     stacking breakpoint the same three regions get a real row of buttons.
     Hidden from pointer layouts, where hovering the drawing is the point. */
  .jx-keys{display:none}
  .jx-foot{text-align:center;font-size:12.5px;color:var(--muted);line-height:1.55;max-width:60ch;margin:32px auto 0}

  @media (max-width:860px){
    .jx{padding:52px 0 60px}
    .jx-grid{grid-template-columns:1fr;gap:28px;justify-items:center}
    .jx-side{width:100%;max-width:520px}
    .jx-stage{width:min(300px,78vw)}
    .jx-card{padding:24px 24px 26px;border-radius:18px;align-self:start}
    .jx-card__t{font-size:20px}
    .jx-keys{
      display:flex;flex-wrap:wrap;justify-content:center;gap:8px;
      margin:22px auto 0;max-width:520px;
    }
    .jx-key{
      font-family:inherit;font-size:13.5px;font-weight:700;letter-spacing:-0.01em;
      color:var(--honey-deep);background:#fff;border:1.5px solid var(--honey-soft);
      border-radius:999px;padding:0 15px;min-height:44px;cursor:pointer;white-space:nowrap;
      transition:background .2s ease,border-color .2s ease,color .2s ease;
    }
    .jx-key[aria-pressed="true"]{background:var(--honey-deep);border-color:var(--honey-deep);color:#fff}
    .jx-key:focus-visible{outline:2px solid var(--honey);outline-offset:2px}
  }
  @media (prefers-reduced-motion:reduce){.jx-part,.jx-ring,.jx-card{transition:none}}
</style>

<section class="s jx" aria-labelledby="jxTitle">
  <div class="wrap">
    <div class="jx__head">
      <h2 class="s-title" id="jxTitle">Where it actually works.</h2>
      <p class="jx__sub">Glucosamine and chondroitin are not general-purpose. They belong to specific parts of a joint. Here is which.</p>
    </div>
    <p class="jx__hint">
      <span class="jx__hint-hover">Hover a marker to light up that part of the joint.</span>
      <span class="jx__hint-touch">Tap a part below to light it up on the joint.</span>
    </p>

    <%
      // Each entry is one region of the diagram. Doses are transcribed from
      // the Supplement Facts panel and are PER SERVING, which that panel
      // defines as 3 tablets.
      // <mark> marks the sentence in each card that names an active and says
      // what it does there — the line a skimmer should land on. Styled as a
      // tinted highlight rather than bold so it reads as emphasis on the page
      // rather than as a heading.
      var _jx = [
        { k: 'cartilage', kicker: 'The cushion', t: 'Cartilage', short: 'Cartilage',
          p: 'The smooth layer capping each bone end, and what lets a joint bend without the two bones meeting. <mark>Chondroitin sulphate is a component of cartilage itself, and glucosamine is a building block the body uses to make and repair it.</mark>',
          doses: [{ n: '1500', u: 'mg glucosamine' }, { n: '1200', u: 'mg chondroitin' }] },
        { k: 'space', kicker: 'The cushion in motion', t: 'The joint space', short: 'Joint space',
          p: 'The gap between the two cartilage surfaces, filled with synovial fluid that lubricates the joint and spreads load across it. <mark>Chondroitin helps cartilage hold water, and holding water is what keeps that cushioning there under weight.</mark>',
          doses: [] },
        { k: 'bone', kicker: 'The structure', t: 'Bone ends', short: 'Bone ends',
          p: 'Femur above, tibia below. They are never meant to meet: cartilage and fluid sit between them. <mark>Which is why a joint formula is about maintaining that layer, not about the bone.</mark>',
          doses: [] }
      ];
    %>

    <div class="jx-grid">
      <div class="jx-stage" id="jxStage">
        <%# One file, three times. The base carries the whole joint; the two
            masked copies above it light a single region each. alt sits on the
            base only — the others are the same picture and would just repeat
            it to a screen reader. %>
        <img class="jx-layer jx-base" src="/img/products/joint-anatomy.png?v=2"
             alt="Cross-section of a knee joint: the femur above and tibia below, each capped with cartilage, with the joint space between them">
        <img class="jx-layer jx-part" data-part="bone" src="/img/products/joint-anatomy.png?v=2" alt="" aria-hidden="true">
        <img class="jx-layer jx-part" data-part="cartilage" src="/img/products/joint-anatomy.png?v=2" alt="" aria-hidden="true">
        <img class="jx-layer jx-part" data-part="space" src="/img/products/joint-anatomy.png?v=2" alt="" aria-hidden="true">

        <%# Rings and markers, positioned as percentages of the render so they
            stay put at any size. Coordinates measured off the file. %>
        <span class="jx-ring" data-ring="cartilage" style="left:12%;top:25%;width:80%;height:34%" aria-hidden="true"></span>
        <span class="jx-ring" data-ring="space" style="left:17%;top:42%;width:68%;height:16%" aria-hidden="true"></span>
        <span class="jx-ring" data-ring="bone" style="left:21%;top:1%;width:60%;height:26%" aria-hidden="true"></span>
        <span class="jx-ring" data-ring="bone" style="left:20%;top:60%;width:62%;height:39%" aria-hidden="true"></span>

        <button type="button" class="jx-hit" data-hit="bone" style="left:51%;top:13%" aria-label="Bone ends"></button>
        <button type="button" class="jx-hit" data-hit="cartilage" style="left:62%;top:38%" aria-label="Cartilage"></button>
        <button type="button" class="jx-hit" data-hit="space" style="left:40%;top:50%" aria-label="The joint space"></button>
      </div>

      <%# Same three regions as the diagram, as real buttons. Only shown where
          the layout has stacked — see .jx-keys in the CSS for why. %>
      <div class="jx-keys" id="jxKeys">
        <% _jx.forEach(function (r, i) { %>
          <button type="button" class="jx-key" data-key="<%= r.k %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>"><%= r.short %></button>
        <% }); %>
      </div>

      <%# All three cards are in the DOM and stacked in ONE grid cell, so the
          panel is already as tall as its longest card and swapping never
          resizes the section or shifts the diagram. %>
      <div class="jx-side">
        <div class="jx-info" id="jxInfo" aria-live="polite">
          <% _jx.forEach(function (r, i) { %>
            <article class="jx-card<%= i === 0 ? ' is-on' : '' %>" data-for="<%= r.k %>">
              <p class="jx-card__k"><%= r.kicker %></p>
              <h3 class="jx-card__t"><%= r.t %></h3>
              <p class="jx-card__p"><%- r.p %></p>
              <% if (r.doses.length) { %>
                <div class="jx-doses">
                  <% r.doses.forEach(function (d) { %>
                    <p class="jx-dose"><b><%= d.n %></b><span><%= d.u %></span></p>
                  <% }); %>
                </div>
              <% } %>
            </article>
          <% }); %>
        </div>
      </div>
    </div>

    <p class="jx-foot">An illustration of a knee joint, used to show where each active belongs. Joint Max is a nutritional supplement and is not for medicinal use.</p>
  </div>
</section>

<!-- JOINT HEALTH TIMELINE — full-bleed artwork -->
<style>
  /* ============================================================
     JOINT HEALTH TIMELINE — edge-to-edge artwork, blended into the page
     Same treatment as the haemoglobin trail on Iron+. The artwork spans the
     full viewport, outside .wrap, and is sized so the whole thing lands on one
     screen rather than taking two scrolls.
     It sits on a peach gradient, not a flat colour, so the band behind it is
     built from the artwork's OWN edges: every stop below is the average of
     its outermost 6 columns at that height, measured off the file. At any
     point down the image the colour just outside it is the colour just inside
     it, so when the height cap narrows the figure the gutters disappear.
     Re-sample these if the artwork is re-exported.
     ============================================================ */
  .jtl{background:#fff}
  .jtl__bed{
    padding-top:clamp(52px,7vw,96px);
    background:linear-gradient(180deg,
      var(--honey-soft) 0%, #FEEFD9 15%, #FDEACF 24%, #FEE9CD 32%,
      #FDE8CC 49%, #FDEBD3 58%, #FED8A7 66%, #FED49D 75%,
      #FDDCAA 83%, #FDD59C 92%, #FCCF90 100%);
  }
  .jtl__fig{
    margin:0 auto;position:relative;
    /* Cap the WIDTH at whatever makes the 2.4:1 height fit the space left
       under the sticky topbar, so the whole timeline is readable without
       scrolling. --topbar-h is published by the topbar script; 170px covers
       this section's own top padding and the sticky buy bar that sits over
       the bottom of the viewport once you have scrolled. svh, not vh, so
       mobile browser chrome does not make it overshoot. */
    max-width:calc((100vh  - var(--topbar-h, 89px) - 170px) * 1942 / 810);
    max-width:calc((100svh - var(--topbar-h, 89px) - 170px) * 1942 / 810);
  }
  .jtl__fig img{
    display:block;width:100%;height:auto;
    /* A hair of side fade. The bed already matches the artwork's edges, so
       this is insurance against the join showing on a wide gamut display,
       and it is spent well before the first circle. */
    -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 2%,#000 98%,transparent 100%);
            mask-image:linear-gradient(90deg,transparent 0,#000 2%,#000 98%,transparent 100%);
  }
  /* Eases the artwork's bottom edge back to the white the FAQ starts on. */
  .jtl__tail{height:clamp(44px,6vw,92px);background:linear-gradient(180deg,#FCCF90 0%,#FFFFFF 100%)}
  /* The head sits inside the bed, on the peach, so the band reads as one
     thing: title, then the artwork it introduces. */
  .jtl__head{text-align:center;margin:0 auto clamp(26px,3.6vw,44px);padding:0 20px;max-width:720px}
  .jtl__head .s-title{margin-inline:auto;margin-bottom:12px}
