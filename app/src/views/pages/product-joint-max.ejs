  %>
  <div class="certs-viewport">
    <div class="certs-track">
      <% [0, 1].forEach(function (dup) { %>
        <ul class="certs-set"<%- dup ? ' aria-hidden="true"' : '' %>>
          <%# Each half repeats the list twice. The loop is only seamless if
