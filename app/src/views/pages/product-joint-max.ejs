<style>
  /* Editorial masthead — borrows the reviews.ejs rv-hero__masthead language */
  .pi-masthead{background:#fff;border-bottom:1px solid var(--line);padding:18px 0}
  .pi-masthead__inner{display:flex;justify-content:space-between;align-items:center;gap:24px;font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--c-text-3,#8A8A8A)}
  .pi-masthead__edition{color:var(--ink)}
  .pi-masthead__pub{color:var(--honey-deep)}
  @media (max-width:560px){
    .pi-masthead{padding:14px 0}
    .pi-masthead__inner{font-size:10px;letter-spacing:.18em}
  }
</style>

<!-- HERO -->
<section class="product-hero" id="buy">
  <div class="wrap">
    <div class="product-hero-grid">
      <div class="gallery-col">
        <%
          // Gallery slides in one list. Removing an entry is all that is needed —
          // the main frame, the thumb rail and the rail's width all follow from it.
          // Ordered to match the siblings rather than the file numbering, so a
          // customer moving between products meets the same sequence:
          // pack -> lifestyle -> comparison -> facts -> timeline -> ingredients
          // -> trust. Positions 1, 2, 5, 7 and 8 line up with BOTH Iron+ and
          // EnergyOne+; 3 and 4 follow EnergyOne+. Slot 6 holds this product's
          // extra slide, which is where Iron+ carries its extra too.
          // Adding art: add an entry here AND the same path to
          // prisma/product-images.js, then run `npm run sync:images`.
          var _slides = [
            { n: 1, t: 'The pack' },
            { n: 2, t: 'Made for everyday life' },
            { n: 4, t: 'Why choose Joint Max' },
            { n: 3, t: 'Complete nutritional facts' },
            { n: 8, t: 'What to expect, week by week' },
            { n: 5, t: 'How it supports your joints' },
            { n: 6, t: 'The two actives' },
            { n: 7, t: 'Why you should trust us' }
          ];
          var _slideSrc = function (n) { return '/img/products/joint-n' + n + '.png?v=4'; };
        %>
        <div class="gallery" style="--n:<%= _slides.length %>">
          <div class="gallery-main">
            <img id="galleryMain" src="<%= _slideSrc(_slides[0].n) %>" alt="Shiōrra Joint Max pack resting on soft peach forms">
          </div>
          <div class="gallery-thumbs" id="galleryThumbs">
            <% _slides.forEach(function (sl, i) { %>
              <button type="button" class="gallery-thumb<%= i === 0 ? ' is-active' : '' %>" data-full="<%= _slideSrc(sl.n) %>" aria-label="<%- sl.t %>"><img src="<%= _slideSrc(sl.n) %>" alt="" loading="lazy"></button>
            <% }); %>
          </div>
        </div>
      </div>

      <div class="info">
        <div class="pi-panel">
          <span class="pi-kicker">Joint &amp; Cartilage Support · 30 Tablets</span>
          <h1 class="pi-title">Joint Max</h1>
          <p class="pi-subtitle">Advanced Joint &amp; Cartilage Support</p>
          <p class="pi-actives">Glucosamine Hydrochloride <i>|</i> Chondroitin Sulphate</p>

          <%# No star rating here, deliberately: the siblings show one because
              they have been selling, and Joint Max has not shipped a pack, so
              there is nothing to average. A launch chip used to stand in this
              gap and has been removed, so the gap is now simply empty. Put the
              .pi-proof block back here once real reviews exist. %>

          <form action="/cart/buy-now" method="post" id="addToCartForm" class="pi-buy-form">
            <input type="hidden" name="productId" value="<%= product.id %>">
            <input type="hidden" name="quantity" id="bundleQty" value="1">

            <%
              // PRICING IS A PLACEHOLDER until the real numbers land — see the
              // seed record for 'joint-max'. Change it there, not here.
              //
              // No multi-pack discount is defined yet, so each tier is simply
              // unit price x quantity and the "Save %" shown is the genuine
              // MRP discount, not an invented bundle saving. When the bundle
              // totals arrive, put them here AND in BUNDLE_PRICES in
              // cartController.js — the two must agree or the cart will charge
              // something different from what this panel promises.
              //
              // Tiers are labelled by packs, not days. The carton says 30
              // tablets while the label says 3 tablets a day, which cannot
              // both be a month's supply, so no day count is claimed here.
              var _base = product.priceInPaise || 99900;
              var _mrp = (product.mrpInPaise && product.mrpInPaise > _base) ? product.mrpInPaise : Math.round(_base * 1.2);
              var _packs = [
                { qty: 1, price: _base },
                // No `rec: true` while every tier is the same unit price —
                // flagging a 2-pack as recommended when it saves nothing extra
                // is a nudge with nothing behind it. Restore it with the
                // bundle totals.
                { qty: 2, price: _base * 2 },
                { qty: 3, price: _base * 3 },
              ];
              var _inr = function (p) { return '₹' + (p / 100).toLocaleString('en-IN'); };
              var _off = function (pk) { return Math.round((1 - pk.price / (_mrp * pk.qty)) * 100); };
            %>
            <div class="pi-packs">
              <span class="pi-packs__label">Choose your plan</span>
              <fieldset class="pi-plans" aria-label="Choose your plan">
                <% _packs.forEach(function (pk, i) { %>
                  <label class="pi-plan<%= i === 0 ? ' is-selected' : '' %>">
                    <input type="radio" name="bundle" value="<%= pk.qty %>" data-qty="<%= pk.qty %>" <%= i === 0 ? 'checked' : '' %>>
                    <% if (pk.rec) { %><span class="pi-plan__flag">Recommended</span><% } %>
                    <span class="pi-plan__dot" aria-hidden="true"></span>
                    <span class="pi-plan__days"><%= pk.qty %> Pack<%= pk.qty > 1 ? 's' : '' %></span>
                    <span class="pi-plan__packs"><%= pk.qty * 30 %> tablets</span>
                    <span class="pi-plan__price"><%= _inr(pk.price) %></span>
                    <span class="pi-plan__save">Save <%= _off(pk) %>%</span>
                  </label>
                <% }); %>
              </fieldset>
              <p class="pi-planinfo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.6v.6"/></svg>
                All prices incl. taxes · 3 tablets daily, with meals
              </p>
            </div>


            <% var _soldOut = (typeof product.stock === 'number' && product.stock <= 0);
               var _lowStock = (!_soldOut && typeof product.stock === 'number' && product.stock <= 10); %>
            <% if (_lowStock) { %><p class="pi-stocknote">Only <%= product.stock %> left in stock</p><% } %>
            <% if (_soldOut) { %>
              <div class="pi-buy-row">
                <button type="button" class="pi-add" disabled aria-disabled="true" style="opacity:.5;cursor:not-allowed">Sold out</button>
              </div>
              <p class="pi-stocknote pi-stocknote--muted">Currently out of stock. Please check back soon.</p>
            <% } else { %>
              <div class="pi-buy-row">
                <button type="submit" formaction="/cart/add" class="pi-add-secondary">Add to cart</button>
                <button type="submit" class="pi-add">Buy now</button>
              </div>
            <% } %>
            <%# The siblings carry a "N people are viewing this right now"
                counter here. It is left off Joint Max on purpose: the number is
                generated, and inventing live shoppers for a product that has
                never been sold is a claim rather than a flourish. Add it back
                if you want the pattern matched. %>
          </form>

          <%# The four claims printed on the carton, in the carton's order. %>
          <ul class="pi-bene">
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3.2v4.1a4 4 0 0 0 8 0V3.2"/><path d="M8 20.8v-4.1a4 4 0 0 1 8 0v4.1"/><path d="M9.6 12h4.8"/></svg></span>
              <span class="pi-bene__t">Supports Joint Health &amp; Mobility</span>
            </li>
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 4.2c3 0 4.6 1.6 4.6 4.7v6.2c0 3.1 1.6 4.7 4.6 4.7"/><path d="M4 9.1c2.6.6 4 2.2 4 4.8"/><path d="M20 14.9c-2.6-.6-4-2.2-4-4.8"/></svg></span>
              <span class="pi-bene__t">Helps Maintain Healthy Cartilage</span>
            </li>
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="14.6" cy="4.4" r="1.8"/><path d="M5.4 21.2l2.6-5.3 3-2.1"/><path d="m11 13.8-1.6-4.2 4-1.9 3 2.6 2.6.7"/><path d="m13.4 15.2 1.9 2.4.9 3.6"/></svg></span>
              <span class="pi-bene__t">Supports Joint Flexibility &amp; Function</span>
            </li>
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.6s-6.6-4-6.6-9.3a3.4 3.4 0 0 1 6.6-1.2 3.4 3.4 0 0 1 6.6 1.2c0 5.3-6.6 9.3-6.6 9.3z"/></svg></span>
              <span class="pi-bene__t">Daily Nutritional Support For Active Joints</span>
            </li>
          </ul>


          <ul class="pi-trust" aria-label="Product assurances">
            <%# Taken from the carton's own badge row. "Vegetarian" is NOT
                claimed: the label lists tablet excipients and no capsule shell,
                so there is nothing on the pack to support it. %>
            <% ['FSSAI & GMP-WHO', 'No preservatives', 'For adults'].forEach(function (t) { %>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><%= t %></li>
            <% }); %>
          </ul>


          <p class="pi-footnote">Free shipping over ₹999 · 30-day money-back guarantee</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CERTIFICATION SCROLLER -->
<style>
  /* Infinite horizontal scroller. The track holds TWO identical sets and
     slides to -50%, which lands set B exactly where set A began. For that to
     be seamless the halves must be equal, so the inter-item gap lives inside
     each set and each set carries a trailing pad of the same size — a `gap`
     on the track itself would leave the seam half a gap short and the loop
     would visibly jump. */
  .certs{background:#FBFBFC;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:40px 0;position:relative}
  .certs-viewport{overflow:hidden}
  /* edge fades so items dissolve rather than pop at the boundaries */
  .certs::before,.certs::after{content:'';position:absolute;top:0;bottom:0;width:150px;z-index:2;pointer-events:none}
  .certs::before{left:0;background:linear-gradient(90deg,#FBFBFC 0,#FBFBFC 28%,rgba(251,251,252,0) 100%)}
  .certs::after{right:0;background:linear-gradient(270deg,#FBFBFC 0,#FBFBFC 28%,rgba(251,251,252,0) 100%)}
  .certs-track{display:flex;width:max-content;animation:certScroll 38s linear infinite}
  .certs:hover .certs-track{animation-play-state:paused}
  .certs-set{display:flex;gap:64px;padding-right:64px;list-style:none;margin:0}
  @keyframes certScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  .cert{flex:0 0 184px;width:184px;display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center}
  /* No chip/ring: the supplied marks are already self-contained badges in
     assorted shapes and colours, so a uniform ring around them just fights
     them. A fixed-height box normalises them to one optical size instead. */
  .cert__ic{height:128px;display:grid;place-items:center;color:var(--honey-deep)}
  .cert__ic img{
    max-height:calc(128px * var(--certScale,1));max-width:100%;width:auto;object-fit:contain;
    /* Most of these marks ship on a solid white background. multiply against
       the near-white band drops that box out without needing the PNGs to be
       re-cut with real transparency. */
    mix-blend-mode:multiply;
  }
  .cert__ic svg{width:60px;height:60px}
  .cert__t{font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);line-height:1.4}
  /* A logo file that 404s falls back to its line icon rather than a broken image */
  .cert__fb{display:none}
  .cert__ic.is-fallback img{display:none}
  .cert__ic.is-fallback .cert__fb{display:block}

  @media (max-width:720px){
    .certs{padding:28px 0}
    .certs::before,.certs::after{width:64px}
    .certs-set{gap:38px;padding-right:38px}
    .cert{flex:0 0 138px;width:138px;gap:12px}
    .cert__ic{height:90px}
    .cert__ic img{max-height:calc(90px * var(--certScale,1))}
    .cert__ic svg{width:46px;height:46px}
    .cert__t{font-size:10px;letter-spacing:.08em}
  }
  /* Motion off: stop the animation and hand the row back as a manual scroller,
     otherwise the duplicated set is simply unreachable. */
  @media (prefers-reduced-motion: reduce){
    .certs-track{animation:none}
    .certs-viewport{overflow-x:auto;scrollbar-width:none}
    .certs-viewport::-webkit-scrollbar{display:none}
    .certs::before,.certs::after{display:none}
  }
</style>

<section class="certs" aria-label="Certifications and quality assurances">
  <%
    // `img` is the real certification mark; `svg` is the line-icon fallback
    // shown only if that file is missing (see the cert-logo script below).
    // `scale` nudges marks whose source file carries a lot of internal
    // padding so they land at the same optical size as the round seals.
    // Drop the files in app/src/public/img/certs/ using these exact names.
    var _certs = [
      { t: 'FSSAI Certified', img: '/img/certs/fssai.png', scale: 1.2,   svg: '<circle cx="12" cy="9" r="6"/><path d="m9.4 9 1.9 1.9L15 7.2"/><path d="M8.9 14.4 7.6 22l4.4-2.2L16.4 22l-1.3-7.6"/>' },
      { t: 'WHO-GMP Certified', img: '/img/certs/who-gmp.png', svg: '<path d="M2.5 21h19"/><path d="M4 21V9.6l5 3.1V9.6l5 3.1V6.3l5 3.1V21"/><path d="M8 21v-3.2M13 21v-3.2"/>' },
      { t: 'ISO Certified', img: '/img/certs/iso.png',     svg: '<path d="M14 2.8H7a2 2 0 0 0-2 2v14.4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7.8z"/><path d="M14 2.8v5h5"/><path d="m8.8 14.2 2.1 2.1 4.3-4.3"/>' },
      { t: 'GMO Free', img: '/img/certs/gmo-free.png',          svg: '<path d="M5 3.2c0 5 3 6.6 7 8.6s7 3.9 7 9"/><path d="M19 3.2c0 5-3 6.6-7 8.6s-7 3.9-7 9"/><path d="M7.6 6.6h8.8M7.6 17.4h8.8"/><path d="M3.4 20.6 20.6 3.4"/>' }
