          <% _certs.concat(_certs).forEach(function (c, ci) { %>
            <li class="cert"<%- ci >= _certs.length ? ' aria-hidden="true"' : '' %>>
              <span class="cert__ic"<%- c.scale ? ' style="--certScale:' + c.scale + '"' : '' %>>
