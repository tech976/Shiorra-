<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Advanced Ginger+ · Shiōrra · Gentle Support for Morning Sickness</title>
<meta name="description" content="Shiōrra Advanced Ginger+ — standardised Zingiber officinale extract 250 mg with active Vitamin B6 (P5P), Magnesium Bisglycinate and Vitamin B1. Gentle support for morning sickness. A trademark of K.C. Laboratories." />
<link rel="shortcut icon" type="image/png" href="/img/logo/logo-green.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    /* Ginger+ product accent — sea green (gentle / botanical) */
    --honey:#2E8B57;
    --honey-2:#1F6B43;
    --honey-deep:#144B30;
    --honey-soft:#E0F0E5;
    --charcoal:#282828;
    --charcoal-2:#3A3A3A;
    --ink:#282828;
    --ink-soft:#3A3A3A;
    --white:#FFFFFF;
    --surface:#F7F7F8;
    --surface-2:#FBFBFC;
    --line:#E5E5E7;
    --line-soft:#F0F0F2;
    --muted:#6B6B6B;
    --muted-2:#8A8A8A;
    --green:#1E9E5C;
    --shadow-sm:0 2px 6px rgba(40,40,40,.06);
    --shadow-md:0 8px 24px rgba(40,40,40,.08);
  }
  html{scroll-behavior:smooth;overflow-x:clip}
  body{
    font-family:'Inter','Helvetica Neue',Helvetica,Arial,sans-serif;
    color:var(--ink);
    background:#fff;
    line-height:1.55;
    font-size:15px;
    overflow-x:clip;
    padding-bottom:88px;
  }
  @media(max-width:720px){body{padding-bottom:84px}}
  img{max-width:100%;display:block}
  a{color:inherit;text-decoration:none}
  button{font:inherit;cursor:pointer;border:0;background:none}
  .wrap{max-width:1180px;margin:0 auto;padding:0 20px}

  /* ---------- Marquee ---------- */
  .marquee{background:var(--charcoal);color:#fff;padding:10px 0;overflow:hidden;border-bottom:1px solid var(--line)}
  .marquee-track{display:flex;gap:48px;width:max-content;animation:marquee 36s linear infinite;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}
  .marquee-item{display:inline-flex;align-items:center;gap:8px}
  .marquee-item svg{width:14px;height:14px;color:var(--honey)}
  .marquee-item .accent{color:var(--honey)}
  @keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

  /* ---------- Trust microbar ---------- */
  .microbar{background:var(--surface);border-bottom:1px solid var(--line);padding:8px 0;font-size:12px;color:var(--ink-soft);font-weight:500}
  .microbar-inner{display:flex;justify-content:center;gap:32px;flex-wrap:wrap}
  .microbar-item{display:inline-flex;align-items:center;gap:6px}
  .microbar-item svg{width:14px;height:14px;color:var(--honey)}

  /* ---------- Hero ---------- */
  .product-hero{
    background:#fff;
    padding:48px 0 64px;
    position:relative;
    /* Deliberately NOT overflow:hidden — that turns this element into the
       sticky scroll container and silently kills `position:sticky` on the
       gallery. Horizontal bleed is already clipped by overflow-x:clip on
       html/body, so nothing is lost. */
    overflow:visible;
  }
  .product-hero-grid{
    display:grid;grid-template-columns:1.55fr 1fr;gap:30px;
    /* Was 1.15fr/36px, sized when the gallery was 4:5. A square frame is
       20% shorter at the same width, which left the carousel looking small
       beside the much taller buy panel. Widening the column grows the image
       itself rather than padding it: the frame and the artwork are both 1:1,
       so nothing is letterboxed. The panel keeps ~435px, comfortably above
       the ~400px its 3-up pack selector needs. */
    /* No align-items:start. The gallery column must STRETCH to the info
       panel's height, otherwise the sticky rail inside it has no travel room
       and the image just parks at the top with dead space beneath it. */
    position:relative;
  }
  @media(max-width:880px){.product-hero-grid{grid-template-columns:1fr;gap:28px}}

  /* Gallery — vertical thumb rail flush against the main image.
     .gallery-col is the stretched grid item; .gallery is the sticky child, so
     the image tracks the taller info panel on scroll instead of leaving a
     blank white column on the left. */
  .gallery-col{min-width:0}
  .gallery{
    position:sticky;top:96px;padding-top:8px;display:flex;gap:12px;min-width:0;
    /* stretch (not flex-start): the flex line's height is set by the main
       image, and the rail then stretches to exactly that — which is what
       makes the thumbs line up top AND bottom with the big image. */
    align-items:stretch;
  }
  /* Fixed 4:5 — every slide is exported at that ratio, so the artwork fills
     the frame exactly. */
  .gallery-main{
    flex:1;min-width:0;align-self:flex-start;aspect-ratio:4/5;background:#fff;
    border-radius:20px;border:1px solid var(--line);
    display:grid;place-items:center;overflow:hidden;position:relative;
  }
  /* Absolutely positioned, NOT width/height:100% in the grid flow. Under
     place-items:center the percentage height does not resolve, so the img
     falls back to its intrinsic ratio and overflows a frame of a different
     shape — which overflow:hidden then CROPS. That silently sliced the top
     and bottom off any slide that was not exactly 4:5. inset:0 gives contain
     a definite box, so an off-ratio file is letterboxed and shown whole. */
  .gallery-main img{position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:contain;object-position:center}
  /* Slides that are not exactly 4:5 leave empty margin once contained. Rather
     than crop them to fill (these are text-dense infographics — cropping loses
     content) the margin is filled with a blurred, over-scaled copy of the same
     slide, so the frame reads as full. On a true 4:5 slide there is no margin
     and this is never visible. */
  .gallery-main__bg{
    position:absolute;inset:0;z-index:0;
    background-size:cover;background-position:center;
    filter:blur(24px) saturate(1.06);transform:scale(1.16);
  }
  /* grid-auto-rows:1fr splits whatever height the rail is handed into equal
     rows, so N thumbs always span exactly the main image — no leftover gap
     under the last thumb, at any column width and any thumb count. */
  /* Rail width is SOLVED from the slide count, not hard-coded: the rail spans
     the main image's height split N ways, so any fixed width only yields 4:5
     cells at one particular N. At 8 slides 60px was right; at 5 the same width
     gives tall narrow cells that letterbox the artwork.
       main_h = 1.25 * (C - w - 12)      rail height == main image height
       cell_h = (main_h - (N-1)*8) / N   split N ways, 8px gaps
       want  w = 0.8 * cell_h            cell matches the 4:5 artwork
     solving:  w = (C - 12 - 6.4*(N-1)) / (N + 1)
     --n comes from _slides.length, so changing the list re-solves it. */
  .gallery-thumbs{
    order:-1;
    flex:0 0 calc((100% - 12px - 6.4px * (var(--n, 8) - 1)) / (var(--n, 8) + 1));
    display:grid;grid-auto-rows:1fr;gap:8px;
  }
  .gallery-thumb{position:relative;width:100%;height:100%;min-height:0;background:#fff;border:1.5px solid var(--line);border-radius:10px;overflow:hidden;cursor:pointer;padding:0;transition:border-color .2s,transform .2s}
  .gallery-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;transition:transform .35s ease}
  /* Below 880px the rail can't sit beside the image — stack it under, scrolling. */
  @media(max-width:880px){
    .gallery{position:static;flex-direction:column;gap:10px}
    .gallery-main{flex:none;width:100%;max-height:none;aspect-ratio:4/5;padding:0}
    .gallery-thumbs{order:1;flex:none;display:flex;flex-direction:row;width:100%;min-width:0;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:2px;scrollbar-width:none}
    .gallery-thumbs::-webkit-scrollbar{display:none}
    .gallery-thumb{flex:0 0 58px;height:auto;aspect-ratio:4/5;min-height:0}
  }
  .gallery-thumb:hover{border-color:var(--honey);transform:translateY(-1px)}
  .gallery-thumb.is-active{border-color:var(--honey);box-shadow:0 0 0 3px var(--honey-soft) inset}
  .float-badge{
    position:absolute;background:#fff;
    border-radius:16px;padding:10px 16px;font-size:12.5px;font-weight:700;
    box-shadow:0 8px 24px rgba(40,40,40,.10),0 2px 6px rgba(40,40,40,.06);
    border:1px solid var(--line);
    display:inline-flex;align-items:center;gap:10px;
  }
  .float-1{top:18px;left:18px}
  .float-2{bottom:18px;right:18px}
  .float-1-icon{
    color:var(--honey);font-size:14px;line-height:1;
  }
  .pulse-dot{width:6px;height:6px;border-radius:50%;background:var(--honey)}

  /* ============================================================
     PRODUCT INFO PANEL
     Reworked to the client reference (arthbyemcure "Snooze Away"):
     an accent-filled card carrying oversized product name -> actives
     line -> 2x2 benefit cards -> pack pills -> price with % off -> CTA.
     Panel is plain white with a hairline ring; the rose accent survives
     only in the type (+ glyph, kicker) and the selected pack pill.
     ============================================================ */
  .info{padding-top:8px}
  .pi-panel{
    position:relative;overflow:hidden;
    background:#fff;
    border-radius:26px;padding:28px 28px 24px;color:var(--ink);
    /* inset ring instead of a border — same definition, zero added width */
    box-shadow:inset 0 0 0 1px var(--line),0 10px 30px rgba(40,40,40,.05);
  }
  .pi-panel > *{position:relative;z-index:1}

  .pi-kicker{display:block;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--honey-deep);margin-bottom:12px}
  .pi-title{
    font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
    font-size:clamp(27px,3.0vw,38px);font-weight:900;line-height:1.0;letter-spacing:-0.025em;
    text-transform:uppercase;color:var(--ink);margin-bottom:6px;text-wrap:balance;
  }
  .pi-title em{font-style:normal;font-weight:900;color:var(--honey);font-size:.82em;vertical-align:.04em}
  .pi-subtitle{
    font-size:clamp(19px,2.1vw,26px);font-weight:500;line-height:1.12;letter-spacing:.005em;
    text-transform:uppercase;color:var(--ink-soft);margin-bottom:13px;
  }
  .pi-actives{font-size:15px;font-weight:700;font-style:italic;line-height:1.5;color:var(--ink);margin-bottom:14px}
  .pi-actives i{font-style:normal;font-weight:400;color:#CBCBCB;margin:0 3px}

  .pi-proof{display:flex;align-items:center;gap:8px;margin-bottom:18px;line-height:1}
  .pi-proof__stars{color:#F5A623;font-size:15px;letter-spacing:2px}
  .pi-proof__score{font-weight:800;color:var(--ink);font-size:14px}
  .pi-proof__sep{color:#CBCBCB}
  .pi-proof__count{font-size:13.5px;color:var(--muted);text-decoration:none}
  .pi-proof__count:hover{color:var(--ink);text-decoration:underline;text-underline-offset:2px}

  /* ---- 2x2 benefit cards ---- */
  .pi-bene{list-style:none;margin:0 0 16px;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:11px}
  .pi-bene li{
    display:flex;align-items:center;gap:12px;background:#FBFBFC;border-radius:14px;
    padding:12px 14px;box-shadow:inset 0 0 0 1px var(--line);
  }
  .pi-bene__ic{
    flex:0 0 44px;width:44px;height:44px;border-radius:50%;
    border:1.6px solid var(--honey-deep);color:var(--honey-deep);
    display:grid;place-items:center;
  }
  .pi-bene__ic svg{width:22px;height:22px}
  .pi-bene__t{font-size:13.5px;font-weight:700;line-height:1.28;color:var(--ink);letter-spacing:-0.01em}

  /* ---- Trust chips — one slim translucent row ---- */
  .pi-trust{list-style:none;margin:0 0 18px;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .pi-trust li{
    display:inline-flex;align-items:center;gap:6px;white-space:nowrap;
    background:#FBFBFC;border:1px solid var(--line);
    border-radius:999px;padding:6px 12px;font-size:11.5px;font-weight:700;
    letter-spacing:.01em;color:#3F3F3F;
  }
  .pi-trust li svg{width:13px;height:13px;flex:0 0 13px;color:#23867F}

  /* ---- Plan cards ----
     Three equal cards, each self-contained: radio, duration, pack count,
     its own price and its own saving. Because every price is on the card
     there is no separate price row to keep in sync — what you see selected
     is what the cart charges. */
  .pi-packs{margin:0 0 18px}
  .pi-packs__label{display:block;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);margin-bottom:14px}
  .pi-plans{border:0;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .pi-plan{
    position:relative;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;
    border:1.5px solid var(--line);border-radius:14px;background:#fff;padding:17px 8px 15px;text-align:center;
    transition:border-color .18s ease,background .18s ease,box-shadow .18s ease;
  }
  .pi-plan input{position:absolute;opacity:0;pointer-events:none}
  .pi-plan:hover{border-color:#C7CCCB}
  .pi-plan.is-selected{border-color:#23867F;background:#F4FBFA;box-shadow:0 4px 14px rgba(35,134,127,.10)}
  .pi-plan__dot{width:22px;height:22px;border-radius:50%;border:2px solid #CBD2D1;position:relative;margin-bottom:3px;transition:border-color .18s ease}
  .pi-plan.is-selected .pi-plan__dot{border-color:#23867F}
  .pi-plan.is-selected .pi-plan__dot::after{content:'';position:absolute;inset:3px;border-radius:50%;background:#23867F}
  .pi-plan__days{font-size:15px;font-weight:800;letter-spacing:.01em;text-transform:uppercase;color:var(--ink);line-height:1.1}
  .pi-plan__packs{font-size:12.5px;color:var(--muted-2);line-height:1.2}
  .pi-plan__price{font-family:'Helvetica Neue',Arial,sans-serif;font-size:22px;font-weight:800;letter-spacing:-0.02em;color:var(--ink);line-height:1.15;margin-top:3px}
  .pi-plan__save{margin-top:2px;font-size:11px;font-weight:800;color:#fff;background:#23867F;padding:4px 10px;border-radius:7px;white-space:nowrap;line-height:1.25}
  /* Ribbon straddles the card's top edge, so it reads as attached to it */
  .pi-plan__flag{
    position:absolute;top:0;left:50%;transform:translate(-50%,-50%);
    font-size:9px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;
    background:#23867F;color:#fff;padding:4px 10px;border-radius:999px;white-space:nowrap;
  }
  .pi-plan input:focus-visible ~ .pi-plan__days{outline:2px solid var(--ink);outline-offset:3px;border-radius:3px}
  .pi-planinfo{display:flex;align-items:center;gap:7px;margin:12px 0 0;font-size:12.5px;color:var(--muted-2);line-height:1.4}
  .pi-planinfo svg{width:14px;height:14px;flex:0 0 14px}

  /* ---- Urgency strip ---- */
  .pi-urgency{margin:0 0 20px;display:flex;align-items:center;gap:11px;border:1px solid #F1DAD6;border-radius:12px;padding:10px 14px;background:#FFF7F5}
  .pi-urgency__ic{flex:0 0 auto;width:30px;height:30px;border-radius:9px;background:#FBE3DE;color:#D9463A;display:grid;place-items:center}
  .pi-urgency__ic svg{width:16px;height:16px;transform-origin:50% 80%;animation:piFlicker 1.7s ease-in-out infinite}
  @keyframes piFlicker{0%,100%{transform:scale(1) rotate(-1deg);opacity:1}50%{transform:scale(1.13) rotate(1deg);opacity:.9}}
  .pi-urgency__txt{margin:0;font-size:12.8px;color:var(--muted);line-height:1.4}
  .pi-urgency__txt strong{color:#D9463A;font-weight:800}
  .pi-urgency__txt b{color:var(--ink);font-weight:800}

  /* ---- CTAs ---- */
  .pi-buy-row{display:flex;gap:10px;margin:0 0 16px}
  .pi-add-secondary,.pi-add{
    flex:1;height:54px;border-radius:999px;border:0;cursor:pointer;
    display:inline-flex;align-items:center;justify-content:center;
    font-weight:800;font-size:14.5px;letter-spacing:.06em;text-transform:uppercase;
    transition:transform .18s ease,box-shadow .18s ease,background .18s ease;
  }
  .pi-add-secondary{background:#fff;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink)}
  .pi-add-secondary:hover{background:var(--ink);color:#fff;transform:translateY(-1px);box-shadow:inset 0 0 0 1.5px var(--ink),0 10px 22px rgba(40,40,40,.18)}
  .pi-add{background:var(--ink);color:#fff}
  .pi-add:hover{background:var(--charcoal-2);transform:translateY(-1px);box-shadow:0 10px 22px rgba(40,40,40,.22)}

  .pi-stocknote{margin:10px 0 0;font-size:13px;font-weight:600;color:#C2410C}
  .pi-stocknote--muted{color:#6A6F75;font-weight:500}

  .pi-footnote{margin:16px 0 0;padding-top:14px;border-top:1px solid var(--line-soft,#EFEFEF);font-size:11.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#8A8A8A;line-height:1.7}

  /* Narrow desktop / tablet — cards go single-column before the grid stacks */
  @media(max-width:1040px) and (min-width:881px){
    .pi-panel{padding:26px 22px 24px}
    .pi-bene{grid-template-columns:1fr}
    .pi-bene__t{font-size:14px}
  }

  /* ---------- Section ---------- */
  section.s{padding:72px 0;font-size:17px;position:relative}
  @media(max-width:680px){section.s{padding:56px 0}}
  .s-eyebrow{
    display:inline-flex;align-items:center;
    background:var(--honey-soft);
    color:var(--honey-deep);font-size:12px;font-weight:800;
    padding:8px 16px;border-radius:22px;letter-spacing:.10em;text-transform:uppercase;margin-bottom:16px;
  }
  .s-title{font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:48px;font-weight:700;line-height:1.05;letter-spacing:-0.025em;margin-bottom:16px;max-width:760px;color:var(--charcoal);position:relative;text-wrap:balance}
  .s-title em{font-style:italic;color:var(--honey);font-weight:500}
  @media(max-width:680px){.s-title{font-size:36px}}
  .s-sub{font-size:17px;color:var(--ink-soft);max-width:640px;line-height:1.6}
  .s-head{margin-bottom:40px;position:relative}
  .s-head.center{text-align:center}
  .s-head.center .s-title,.s-head.center .s-sub{margin-left:auto;margin-right:auto}

  /* ---------- Premium icon chip (shared) ---------- */
  .ic-chip{
    width:64px;height:64px;border-radius:18px;
    background:#F7F7F8;
    color:var(--ink);
    display:grid;place-items:center;
    transition:transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .ic-chip svg{width:30px;height:30px;stroke-width:2.2}

  /* ---------- Symptom cards ---------- */
  .symptoms-bg{background:#fff}
  /* Photo figures (other 4 sections) keep the soft rounded-card framing */
  .symptoms-figure,
  .actives-figure,
  .bvitamins-figure,
  .trail-figure{margin:0;border-radius:18px;overflow:hidden;background:#fff}
  .bvitamins-figure{margin:0 0 32px}
  .symptoms-figure picture,
  .actives-figure picture,
  .trail-figure picture{display:block}
  .symptoms-figure img,
  .actives-figure img,
  .bvitamins-figure img,
  .trail-figure img{display:block;width:100%;height:auto}
  /* Switch + Root figures sit FLUSH with their section bg — no card frame,
     image edges dissolve directly into the section. */
  .switch-figure,
  .root-figure{margin:0;border-radius:0;overflow:visible;background:transparent}
  .switch-figure picture{display:block}
  .switch-figure img,
  .root-figure img{display:block;width:100%;height:auto}
  /* MOBILE: break image out of .wrap's horizontal padding so it spans full
     viewport width — "zoomed in" so text inside the illustration is bigger
     and more legible on phones. */
  @media (max-width: 720px){
    .switch-figure,
    .root-figure{
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
  }
  .symptoms-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;align-items:stretch}
  @media(max-width:880px){.symptoms-grid{grid-template-columns:repeat(2,1fr)}}
  .symptom-card{
    background:#fff;border:1px solid var(--line);border-radius:20px;padding:28px;
    transition:transform .3s cubic-bezier(.2,.7,.2,1),box-shadow .3s,border-color .3s;
  }
  .symptom-card:hover{transform:translateY(-4px);box-shadow:0 16px 36px -16px rgba(40,40,40,.12),0 2px 8px rgba(40,40,40,.06);border-color:var(--line)}
  .symptom-card:hover .ic{transform:scale(1.04)}
  .symptom-card .ic{
    width:64px;height:64px;border-radius:18px;
    background:#F7F7F8;
    color:var(--ink);display:grid;place-items:center;margin-bottom:18px;
    transition:transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .symptom-card .ic svg{width:30px;height:30px;stroke-width:2.2}
  .symptom-card h4{font-family:'Helvetica Neue',Arial,sans-serif;font-size:17px;font-weight:700;margin-bottom:6px;color:var(--ink)}
  .symptom-card p{font-size:14px;color:var(--muted);line-height:1.5}

  /* ---------- Power team ---------- */
  .power-bg{background:var(--surface)}
  .power-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;align-items:stretch}
  @media(max-width:880px){.power-grid{grid-template-columns:1fr}}
  .power-card{
    background:#fff;border:1px solid var(--line);border-radius:24px;padding:34px;
    transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s;
  }
  .power-card:hover{transform:translateY(-4px);box-shadow:0 20px 44px -20px rgba(40,40,40,.12),0 2px 8px rgba(40,40,40,.06);border-color:var(--line)}
  .power-card .pc-eye{
    display:inline-flex;align-items:center;
    background:var(--honey-soft);
    color:var(--honey-deep);font-size:11px;font-weight:800;padding:6px 12px;border-radius:16px;
    letter-spacing:.10em;text-transform:uppercase;margin-bottom:14px;
  }
  .power-card h3{font-family:'Helvetica Neue',Arial,sans-serif;font-size:26px;margin-bottom:8px;letter-spacing:-0.015em}
  .power-card .pc-lede{font-size:14.5px;color:var(--muted);margin-bottom:18px;line-height:1.55}
  .power-card ul{list-style:none;display:grid;gap:10px}
  .power-card li{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--ink-soft)}
  .power-card li svg{
    width:22px;height:22px;color:var(--honey);
    flex-shrink:0;
  }
  .power-card .pc-tag{margin-top:18px;font-size:12.5px;color:var(--muted);font-style:italic;padding-top:14px;border-top:1px solid var(--line-soft)}

  /* ---------- B Vitamins ---------- */
  .bvit-bg{background:#fff}
  .bvit-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-top:18px}
  @media(max-width:980px){.bvit-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:520px){.bvit-grid{grid-template-columns:repeat(2,1fr)}}
  .bvit-pill{
    background:var(--honey-soft);
    border-radius:18px;padding:20px 12px;text-align:center;
    transition:transform .3s,box-shadow .3s;
  }
  .bvit-pill:hover{transform:translateY(-3px);box-shadow:0 12px 28px -14px rgba(40,40,40,.12)}
  .bvit-pill .name{font-family:'Helvetica Neue',Arial,sans-serif;font-weight:800;font-size:18px;color:var(--honey-deep);letter-spacing:.02em}
  .bvit-pill .sub{font-size:11.5px;color:var(--honey-deep);opacity:.75;margin-top:4px;font-weight:600}
  .bvit-help{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:36px;align-items:stretch}
  @media(max-width:880px){.bvit-help{grid-template-columns:repeat(2,1fr)}}
  .bvit-help-card{
    background:#fff;border:1px solid var(--line);
    border-radius:20px;padding:24px;
    transition:transform .3s,box-shadow .3s,border-color .3s;
  }
  .bvit-help-card:hover{transform:translateY(-3px);border-color:var(--line);box-shadow:0 16px 32px -16px rgba(40,40,40,.12)}
  .bvit-help-card:hover .ic{transform:scale(1.04)}
  .bvit-help-card .ic{
    width:64px;height:64px;border-radius:18px;
    background:#F7F7F8;
    color:var(--ink);display:grid;place-items:center;margin-bottom:14px;
    transition:transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .bvit-help-card .ic svg{width:30px;height:30px;stroke-width:2.2}
  .bvit-help-card h5{font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;margin-bottom:6px;color:var(--ink);font-weight:700}
  .bvit-help-card p{font-size:13px;color:var(--muted);line-height:1.55}

  /* ---------- Minerals ---------- */
  .min-bg{background:var(--surface)}
  .min-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;align-items:stretch}
  @media(max-width:880px){.min-grid{grid-template-columns:repeat(2,1fr)}}
  .min-card{
    background:#fff;border:1px solid var(--line);border-radius:20px;padding:28px;
    transition:transform .3s,box-shadow .3s,border-color .3s;
  }
  .min-card:hover{transform:translateY(-4px);box-shadow:0 16px 36px -16px rgba(40,40,40,.12),0 2px 8px rgba(40,40,40,.06);border-color:var(--line)}
  .min-card:hover .ic{transform:scale(1.04)}
  .min-card .ic{
    width:64px;height:64px;border-radius:18px;
    background:#F7F7F8;
    color:var(--ink);display:grid;place-items:center;
    font-family:'Helvetica Neue',Arial,sans-serif;font-weight:800;font-size:22px;letter-spacing:-.01em;
    margin-bottom:14px;
    transition:transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .min-card h5{font-family:'Helvetica Neue',Arial,sans-serif;font-size:17px;margin-bottom:6px;color:var(--ink);font-weight:700}
  .min-card p{font-size:13.5px;color:var(--muted);line-height:1.5}

  /* ---------- 9 actives formula ---------- */
  .formula-bg{background:#fff}
  .formula-list{
    margin-top:14px;border:1px solid var(--line);border-radius:22px;overflow:hidden;background:#fff;
  }
  .formula-row{display:grid;grid-template-columns:1.5fr 1fr 2fr;align-items:center;padding:18px 22px;border-top:1px solid var(--line-soft);transition:background .25s}
  .formula-row:not(:first-child):hover{background:rgba(0,0,0,0.02)}
  .formula-row:first-child{border-top:0;background:var(--surface);font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.10em;color:var(--ink)}
  .fc-name{font-family:'Helvetica Neue',Arial,sans-serif;font-weight:700;color:var(--ink);font-size:14.5px}
  .fc-name small{display:block;font-size:11.5px;color:var(--muted);font-weight:500;margin-top:2px}
  .fc-amt{font-family:'Helvetica Neue',Arial,sans-serif;font-weight:700;color:var(--honey-deep);font-size:14px}
  .fc-role{font-size:13.5px;color:var(--muted);line-height:1.5}
  @media(max-width:680px){.formula-row{grid-template-columns:1fr}.fc-amt{font-size:13px}.formula-row:first-child{display:none}}

  /* ---------- Timeline ---------- */
  .timeline-bg{background:var(--surface)}
  .timeline-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:16px;align-items:stretch}
  @media(max-width:880px){.timeline-grid{grid-template-columns:1fr}}
  .tl-card{
    background:#fff;border:1px solid var(--line);border-radius:22px;padding:30px;position:relative;
    transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s;
  }
  .tl-card:hover{transform:translateY(-5px);box-shadow:0 20px 44px -20px rgba(40,40,40,.12),0 2px 8px rgba(40,40,40,.06);border-color:var(--line)}
  .tl-step{
    position:absolute;top:20px;right:20px;
    background:var(--honey-soft);
    color:var(--honey-deep);font-family:'Helvetica Neue',Arial,sans-serif;font-weight:800;font-size:11px;
    padding:6px 12px;border-radius:14px;letter-spacing:.08em;text-transform:uppercase;
  }
  .tl-card h4{font-family:'Helvetica Neue',Arial,sans-serif;font-size:22px;color:var(--ink);margin:22px 0 14px;max-width:80%;letter-spacing:-0.015em}
  .tl-card ul{list-style:none;display:grid;gap:10px}
  .tl-card li{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--ink-soft)}
  .tl-card li svg{
    width:22px;height:22px;color:var(--honey);
    flex-shrink:0;
  }
  .tl-stat{
    margin-top:36px;
    background:var(--charcoal);
    color:#fff;border-radius:20px;padding:26px 32px;
    display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;
  }
  .tl-stat strong{font-family:'Helvetica Neue',Arial,sans-serif;font-weight:800;font-size:24px;letter-spacing:-0.02em}
  .tl-stat .ref{font-size:11.5px;opacity:.85;font-style:italic}

  /* ---------- Compare ---------- */
  /* Reader voices section — text break between two photo-heavy bands.
     Subtle off-white bg differs from #fff sections above/below so the
     palette cleanser reads as a distinct moment. */
  .voices-bg{background:#FAFAF8;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
  .voices-head{text-align:center;margin-bottom:32px}
  .voices-head .rv-marker{margin-bottom:12px}
  .voices-title{
    font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
    font-size:clamp(26px,3.6vw,40px);
    font-weight:700;
    line-height:1.1;
    letter-spacing:-0.022em;
    color:var(--ink);
    max-width:600px;
    margin:0 auto;
  }
  .voices-title em{font-style:normal;color:var(--honey-deep);font-weight:700}
  .voices-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    max-width:1080px;
    margin:0 auto;
  }
  .voice-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:14px;
    padding:30px 24px 22px;
    position:relative;
    transition:border-color .2s,transform .25s,box-shadow .25s;
  }
  .voice-card:hover{
    border-color:rgba(40,40,40,.18);
    transform:translateY(-2px);
    box-shadow:0 14px 30px -16px rgba(40,40,40,.16);
  }
  .voice-card__mark{
    font-family:'Helvetica Neue',Georgia,serif;
    font-size:48px;
    line-height:0.4;
    color:var(--honey);
    opacity:.55;
    position:absolute;
    top:24px;left:22px;
    font-weight:300;
  }
  .voice-card__quote{
    font-size:15.5px;
    line-height:1.55;
    color:var(--ink);
    margin:28px 0 18px;
    font-weight:400;
    letter-spacing:-0.005em;
    text-wrap:pretty;
  }
  .voice-card__attr{
    display:flex;flex-direction:column;gap:3px;
    border-top:1px solid var(--line-soft);
    padding-top:14px;
  }
  .voice-card__name{
    font-size:12.5px;font-weight:700;color:var(--ink);
    letter-spacing:.06em;text-transform:uppercase;
  }
  .voice-card__meta{font-size:12px;color:var(--muted)}
  .voice-card__stars{
    color:var(--honey);font-size:11.5px;letter-spacing:.2em;margin-top:4px;
  }
  @media (max-width:880px){.voices-grid{grid-template-columns:1fr;gap:14px;max-width:560px}}
  .compare-table{margin-top:14px;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff}
  .compare-row{display:grid;grid-template-columns:1.2fr 1fr 1fr}
  .compare-row + .compare-row{border-top:1px solid var(--line-soft)}
  .compare-row.head{background:var(--surface);font-family:'Helvetica Neue',Arial,sans-serif;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink)}
  .compare-row.head .cc{padding:14px 18px}
  .compare-row.head .cc:first-child{visibility:hidden}
  .compare-row.head .cc:nth-child(2){color:var(--honey-deep);background:var(--honey-soft)}
  .cc{padding:14px 18px;font-size:14px;line-height:1.45}
  .cc.lbl{font-weight:700;color:var(--ink)}
  .cc.them{color:var(--muted)}
  .cc.us{background:var(--honey-soft);color:var(--ink);font-weight:600}
  @media(max-width:680px){
    .compare-row{grid-template-columns:1fr 1fr}
    .compare-row.head .cc:first-child{display:none}
    .cc.lbl{grid-column:1/-1;background:var(--line-soft);font-size:13px}
  }

  /* ---------- Root cards ---------- */
  /* Root section: white bg + collapsed top padding so image sits flush
     at the section bracket — same treatment as .why-bg / switch section. */
  .root-bg{background:#fff;padding-top:0 !important}
  .root-bg .wrap{padding-top:0}
  .root-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:14px;align-items:stretch}
  @media(max-width:980px){.root-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:580px){.root-grid{grid-template-columns:1fr}}
  .root-card{
    background:#fff;border:1px solid var(--line);border-radius:20px;padding:28px;
    transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s;
  }
  .root-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px -18px rgba(40,40,40,.12),0 2px 8px rgba(40,40,40,.06);border-color:var(--line)}
  .root-card .rc-eye{
    display:inline-flex;align-items:center;
    font-family:'Helvetica Neue',Arial,sans-serif;font-weight:800;font-size:11px;
    color:var(--honey-deep);letter-spacing:.10em;text-transform:uppercase;margin-bottom:12px;
    padding:5px 10px;background:var(--honey-soft);
    border-radius:14px;
  }
  .root-card h5{font-family:'Helvetica Neue',Arial,sans-serif;font-size:17px;color:var(--ink);margin-bottom:8px;font-weight:700;letter-spacing:-0.01em}
  .root-card p{font-size:13.5px;color:var(--muted);line-height:1.55;margin-bottom:16px}
  .root-card .solve{
    display:flex;gap:10px;align-items:center;
    background:var(--honey-soft);
    color:var(--honey-deep);padding:12px 14px;border-radius:14px;
    font-size:13px;font-weight:700;line-height:1.4;
  }
  .root-card .solve svg{
    width:20px;height:20px;flex-shrink:0;color:var(--honey);stroke-width:2.4;
  }

  /* ---------- Reminder + final CTA ---------- */
  .reminder{background:var(--charcoal);color:#fff;padding:64px 0}
  .reminder .wrap{text-align:center}
  .reminder .eye{display:inline-block;background:rgba(255,255,255,.08);color:#fff;font-size:11px;font-weight:800;padding:6px 14px;border-radius:20px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:18px}
  .reminder h2{font-family:'Helvetica Neue',Arial,sans-serif;font-size:42px;font-weight:700;line-height:1.15;color:#fff;max-width:22ch;margin:0 auto 16px;letter-spacing:-0.02em}
  .reminder h2 em{font-style:italic;color:var(--honey);font-weight:500}
  .reminder p{font-size:16px;color:#bbb;max-width:560px;margin:0 auto 24px}
  .reminder .rem-row{display:inline-flex;flex-wrap:wrap;gap:8px;margin-top:8px;justify-content:center}
  .reminder .rem-chip{background:rgba(255,255,255,.07);color:#fff;font-size:12px;font-weight:600;padding:7px 14px;border-radius:20px}
  @media(max-width:680px){.reminder h2{font-size:32px}}

  .final{background:var(--honey-soft);padding:80px 0;text-align:center;position:relative}
  .final h2{font-family:'Helvetica Neue',Arial,sans-serif;font-size:44px;font-weight:700;line-height:1.15;max-width:22ch;margin:0 auto 14px}
  .final h2 em{font-style:italic;color:var(--honey);font-weight:500}
  @media(max-width:680px){.final h2{font-size:32px}}
  .final p{font-size:16px;color:var(--muted);max-width:540px;margin:0 auto 24px}
  .final-cta{display:inline-flex;align-items:center;gap:10px;background:var(--charcoal);color:#fff;padding:16px 32px;border-radius:14px;font-weight:700;font-size:14px;letter-spacing:.04em;text-transform:uppercase;transition:transform .2s,background .2s}
  .final-cta:hover{transform:translateY(-2px);background:var(--charcoal-2)}
  /* FAQ accordion */
  .faq-sec{background:#fff}
  .fq-list{display:grid;gap:12px;max-width:none;margin:0}
  .fq-item{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;transition:border-color .2s,box-shadow .2s}
  .fq-item:hover{border-color:var(--honey)}
  .fq-item[open]{box-shadow:0 8px 24px rgba(40,40,40,.06)}
  .fq-q{padding:18px 22px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-family:'Helvetica Neue',Arial,sans-serif;font-weight:700;font-size:16px;color:var(--ink);list-style:none;gap:14px}
  .fq-q::-webkit-details-marker{display:none}
  .fq-q .plus{width:28px;height:28px;border-radius:50%;background:var(--honey-soft);color:var(--honey-deep);display:grid;place-items:center;font-size:18px;font-weight:700;flex-shrink:0;transition:transform .3s,background .2s,color .2s}
  .fq-item[open] .fq-q .plus{transform:rotate(45deg);background:var(--honey);color:#fff}
  .fq-a{padding:0 22px 22px;color:var(--ink-soft);line-height:1.65;font-size:14.5px;max-width:92ch}
  /* <details> cannot animate its own height, so the reveal is carried by
     the panel's own fade-in rather than a height transition. */
  .fq-item[open] .fq-a{animation:fqReveal .26s ease both}
  @keyframes fqReveal{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){.fq-item[open] .fq-a{animation:none}}
  .fq-a strong{color:var(--ink)}
  @media(max-width:640px){.fq-q{font-size:15px;padding:16px 18px}.fq-a{padding:0 18px 18px}}

  /* ---------- Sticky offer ---------- */
  /* style.css hides .sticky-cta on desktop for every product page. Override
     it here only — editing the shared rule would switch the bar on for
     Ginger+ and EnergyOne+ too, which have no plan cards to put in it.
     !important is needed to beat the global rule's own !important. */
  .sticky-cta{
    position:fixed;bottom:0;left:0;right:0;background:#fff;
    border-top:1px solid var(--line);box-shadow:0 -8px 24px rgba(40,40,40,.08);
    padding:10px 12px calc(10px + env(safe-area-inset-bottom));z-index:40;
    display:block !important;
    /* hidden until the hero CTA scrolls away; visibility keeps it out of the
       tab order while parked so it can't be focused off-screen */
    transform:translateY(115%);opacity:0;visibility:hidden;
    transition:transform .32s cubic-bezier(.2,.7,.3,1),opacity .32s ease,visibility 0s linear .32s;
  }
  .sticky-cta.is-visible{transform:none;opacity:1;visibility:visible;transition-delay:0s,0s,0s}
  .sticky-inner{max-width:none;margin:0;padding:0;display:flex;align-items:center;justify-content:space-between;gap:20px}
  .sticky-bar{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:560px;margin:0 auto}

  /* Compact plan chips — desktop only; the mobile bar has no room for them. */
  .sb-plans{display:flex;gap:10px;border:0;padding:0;margin:0;min-width:0}
  .sb-plan{
    position:relative;display:flex;flex-direction:column;align-items:center;gap:1px;
    border:1.5px solid var(--line);border-radius:12px;padding:8px 15px;cursor:pointer;
    background:#fff;line-height:1.25;white-space:nowrap;
    transition:border-color .16s ease,background .16s ease;
  }
  .sb-plan:hover{border-color:#C7CCCB}
  .sb-plan input{position:absolute;opacity:0;pointer-events:none}
  .sb-plan.is-selected{border-color:#23867F;background:#F4FBFA}
  .sb-plan__d{font-size:11.5px;font-weight:700;color:var(--ink)}
  .sb-plan__p{font-size:14px;font-weight:800;letter-spacing:-0.01em;color:var(--ink)}
  .sb-plan__p s{font-size:11.5px;font-weight:400;color:var(--muted-2);margin-left:4px}
  .sb-plan__s{font-size:10.5px;font-weight:800;color:#23867F}
  .sb-plan input:focus-visible ~ .sb-plan__d{outline:2px solid var(--ink);outline-offset:3px;border-radius:3px}
  .sticky-bar__btn{height:48px;display:inline-flex;align-items:center;justify-content:center;border-radius:10px;font-weight:700;font-size:13.5px;letter-spacing:.04em;text-transform:uppercase;font-family:inherit;cursor:pointer;white-space:nowrap;transition:background .2s,color .2s}
  .sticky-bar__cart{background:#fff;color:var(--ink);border:1.5px solid var(--ink)}
  .sticky-bar__cart:active{background:var(--ink);color:#fff}
  .sticky-bar__buy{background:var(--charcoal);color:#fff;border:1.5px solid var(--charcoal)}
  .sticky-bar__buy:active{background:#000}
  .sticky-cta-inner{display:flex;align-items:center;gap:14px;justify-content:space-between}
  .sticky-text{display:flex;flex-direction:column;line-height:1.2}
  .sticky-eye{font-size:10px;font-weight:800;color:var(--honey-deep);letter-spacing:.10em;text-transform:uppercase;margin-bottom:2px}
  .sticky-h{font-family:'Helvetica Neue',Arial,sans-serif;font-weight:700;font-size:14px;color:var(--ink)}
  .sticky-h em{color:var(--honey);font-style:normal;font-weight:800}
  .sticky-price{display:flex;align-items:baseline;gap:6px;flex-shrink:0}
  .sticky-now{font-family:'Helvetica Neue';font-weight:700;font-size:18px;color:var(--ink)}
  .sticky-mrp{font-size:12px;color:var(--muted);text-decoration:line-through}
  .sticky-btn{background:var(--charcoal);color:#fff;padding:12px 18px;border-radius:10px;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.04em;flex-shrink:0}
  .sticky-btn:hover{background:var(--charcoal-2)}
  @media(max-width:680px){.sticky-text{display:none}}
  /* Desktop: chips left, buttons right, buttons sized to their labels. */
  @media(min-width:721px){
    .sticky-cta{padding:8px 24px}
    .sticky-bar{grid-template-columns:auto auto;gap:10px;max-width:none;margin:0}
    .sticky-bar__btn{height:46px;padding:0 30px;border-radius:11px;font-size:13px}
    .sb-plan{padding:6px 13px;border-radius:11px}
    .sb-plan__d{font-size:11px}
    .sb-plan__p{font-size:13.5px}
    .sb-plan__s{font-size:10px}
  }
  /* Mobile keeps the bar permanently parked on screen as the purchase UI. */
  @media(max-width:720px){
    .sticky-cta{transform:none;opacity:1;visibility:visible;transition:none}
    .sb-plans{display:none}
    .sticky-inner{padding:0;gap:0}
    .sticky-bar{flex:1}
  }

  /* ============================================================
     MOBILE UX PASS — surgical augmentations only.
     Targets <=720px viewports (Indian mobile 360–414px primary).
     ============================================================ */
  @media (max-width: 720px){
    /* Horizontal page padding scales smoothly */
    .wrap{padding:0 clamp(16px,4.5vw,24px)}

    /* Marquee — keep readable */
    .marquee{padding:8px 0}
    .marquee-track{gap:32px;font-size:11.5px}

    /* Hero — tighten padding, scale title with clamp */
    .product-hero{padding:clamp(28px,7vw,44px) 0 clamp(36px,9vw,56px)}
    .product-hero-grid{gap:24px}
    .pi-kicker{font-size:10px;letter-spacing:.18em;margin-bottom:8px}
    .pi-title{font-size:clamp(28px,8vw,36px);line-height:1.04;margin-bottom:12px}
    .pi-subtitle{font-size:clamp(17px,4.6vw,21px);margin-bottom:10px}
    .pi-actives{font-size:14px;line-height:1.45;margin-bottom:14px}
    .pi-plan__price{font-size:20px}
    .pi-footnote{margin-top:16px;padding-top:13px;font-size:11px}

    /* Gallery thumbs — keep horizontal at 360px, ~64-72px tall */
    .gallery-thumbs{gap:6px;margin-top:8px}
    .gallery-thumb{min-height:44px;border-radius:10px;border-width:1.25px}

    /* Buy row — keep touch targets ≥44px; global CTA standard (style.css)
       handles the 56px heights, equal-width grid, fonts. */
    .pi-buy-row{gap:8px;margin:0 0 14px}

    /* Section padding scales — tightened for mobile so two sections aren't
       100+ px apart vertically. Each section gets 28px top/bottom (56px gap
       between two sections, ~half the previous gap). Heading-to-content
       margin trimmed from 28 → 18. */
    section.s{padding:28px 0}
    .s-title{font-size:clamp(26px,7vw,38px);line-height:1.1;margin-bottom:10px}
    .s-sub{font-size:15px;line-height:1.55}
    .s-head{margin-bottom:18px}
    .pi-feature{padding:36px 0}
    .reminder{padding:32px 0}

    /* Symptom + min cards — single column on small phones for readability */
    .power-card{padding:24px}
    .symptom-card{padding:22px 20px}
    .symptom-card h4{font-size:16px}
    .min-card{padding:22px 20px}
    .root-card{padding:22px 20px}
    .tl-card{padding:24px 22px}
    .tl-card h4{font-size:20px;max-width:100%;margin:18px 0 12px}
    .tl-step{top:14px;right:14px;font-size:10.5px}
    .tl-stat{padding:20px 22px;flex-direction:column;align-items:flex-start;text-align:left}
    .tl-stat strong{font-size:20px;line-height:1.25}

    /* Compare table — bigger touch label rows */
    .cc{padding:12px 14px;font-size:13.5px}

    /* B vitamins help cards — keep icon chip large enough to read */
    .bvit-help-card{padding:20px 18px}
    .bvit-help-card .ic{width:56px;height:56px;border-radius:14px}
    .bvit-help-card .ic svg{width:26px;height:26px}

    /* Reminder + final */
    .reminder{padding:32px 0}
    .reminder p{font-size:15px}
    .final{padding:36px 0}
    .final p{font-size:15px}
    .final-cta{padding:14px 24px;font-size:13.5px;min-height:50px}

    /* Mobile purchase UI = the sticky bar (Myntra/Nykaa pattern).
       Hide the in-column CTA row so there's exactly ONE set of buy
       buttons on phones; price + qty stepper stay in the column. */
    .pi-buy-form .pi-buy-row{display:none !important}

    /* Tappable nav & links inherited from layout — reinforce here */
    .site-header .nav__menu a,.site-header .nav__toggle{min-height:44px}
  }

  /* Extra-narrow phones (~360px) — only tighten where necessary */
  @media (max-width: 380px){
    .pi-title{font-size:27px}
    .pi-plan{padding:13px 4px 12px}
    .pi-plan__days{font-size:12px}
    .pi-plan__price{font-size:16px}
    .pi-plan__save{font-size:9px;padding:3px 6px}
    .gallery-thumb{border-radius:8px}
  }

  /* Single-column at 580px for symptom + B vitamins (8 cards is a lot) */
  @media (max-width: 580px){
    .symptoms-grid{grid-template-columns:1fr;gap:12px}
    .bvit-help{grid-template-columns:1fr;gap:12px}
    .min-grid{grid-template-columns:repeat(2,1fr);gap:12px}
  }

  /* ============================================================
     Mobile PDP refinements — tighter, proper e-commerce rhythm.
     Last media block so it wins over the earlier mobile rules.
     Gallery stays 4:5 (slides are infographics — must not crop).
     ============================================================ */
  @media (max-width:720px){
    .product-hero{padding:16px 0 26px}
    .product-hero-grid{gap:16px}
    .gallery{gap:8px}
    .gallery-thumb{flex:0 0 54px}
    .info{padding-top:0}
    .pi-kicker{font-size:10px;letter-spacing:.16em;margin-bottom:6px}
    .pi-title{font-size:clamp(23px,6.4vw,29px);line-height:1.05;margin-bottom:8px}
    /* Panel — trim the inset so the cards keep their width on a 360px screen */
    .pi-panel{border-radius:20px;padding:22px 18px 20px}
    .pi-actives{font-size:13.5px;margin-bottom:12px}
    .pi-proof{margin-bottom:14px}
    .pi-proof__stars{font-size:14px}
    /* Benefit cards — stay 2-up (they are short labels), just tighter */
    .pi-bene{gap:9px;margin-bottom:14px}
    .pi-bene li{padding:10px 11px;gap:10px;border-radius:12px}
    .pi-bene__ic{flex:0 0 36px;width:36px;height:36px}
    .pi-bene__ic svg{width:19px;height:19px}
    .pi-bene__t{font-size:12px;line-height:1.25}
    /* Trust chips — wrap freely, smaller */
    .pi-trust{gap:6px;margin-bottom:14px}
    .pi-trust li{padding:5px 10px;font-size:10.5px}
    /* Pack pills — three across the row, no min-width fighting the viewport */
    .pi-packs{margin-bottom:14px}
    .pi-packs__label{font-size:11px;letter-spacing:.12em;margin-bottom:16px}
    .pi-plans{gap:7px}
    .pi-plan{padding:15px 5px 13px;gap:4px;border-radius:12px}
    .pi-plan__dot{width:19px;height:19px;margin-bottom:2px}
    .pi-plan__days{font-size:13px}
    .pi-plan__packs{font-size:11px}
    .pi-plan__price{font-size:18px}
    .pi-plan__save{font-size:10px;padding:3px 7px}
    .pi-plan__flag{font-size:8px;padding:3px 7px;letter-spacing:.06em}
    .pi-planinfo{font-size:11.5px;margin-top:10px;gap:6px}
    .pi-planinfo svg{width:13px;height:13px;flex:0 0 13px}
    .pi-urgency{margin-bottom:16px;padding:10px 13px}
    .pi-urgency__txt{font-size:12.5px}
    .pi-footnote{margin-top:14px;padding-top:12px}
    /* FAQ + final — tighter headings and rows */
    section.s{padding:30px 0}
    .s-head{margin-bottom:16px}
    .s-title{font-size:clamp(24px,6.2vw,30px)}
    .fq-list{gap:8px}
    .fq-q{font-size:14.5px;padding:13px 16px;gap:12px}
    .fq-q .plus{width:24px;height:24px;font-size:16px}
    .fq-a{font-size:14px;line-height:1.55}
    .final{padding:30px 0}
    .final h2{font-size:clamp(24px,6.4vw,30px);margin-bottom:10px}
    .final p{font-size:14.5px;margin-bottom:20px}
  }
</style>
</head>
