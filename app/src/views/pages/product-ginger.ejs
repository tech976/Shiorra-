      <div class="gallery-col">
        <%
          // Gallery slides in one list. Removing an entry is all that is needed —
          // the main frame, the thumb rail and the rail's width all follow from it.
          var _slides = [
            { n: 1, t: 'The pack' },
            { n: 2, t: 'Morning support' },
            { n: 3, t: 'Daily routine' },
            { n: 6, t: 'Why these ingredients' },
            { n: 8, t: 'Your trust' }
            // g4/g5/g7 exist only as the older .jpg exports; re-export them as
            // .png to match before adding them here.
          ];
          var _slideSrc = function (n) { return '/img/products/ginger-g' + n + '.png?v=2'; };
        %>
        <div class="gallery" style="--n:<%= _slides.length %>">
          <div class="gallery-main">
            <div class="gallery-main__bg" id="galleryBg" aria-hidden="true" style="background-image:url('<%= _slideSrc(_slides[0].n) %>')"></div>
            <img id="galleryMain" src="<%= _slideSrc(_slides[0].n) %>" alt="Shiōrra Advanced Ginger+ pack on a pale green backdrop with fresh ginger root and green capsules">
          </div>
          <div class="gallery-thumbs" id="galleryThumbs">
            <% _slides.forEach(function (sl, i) { %>
              <button type="button" class="gallery-thumb<%= i === 0 ? ' is-active' : '' %>" data-full="<%= _slideSrc(sl.n) %>" aria-label="<%- sl.t %>"><img src="<%= _slideSrc(sl.n) %>" alt="" loading="lazy"></button>
            <% }); %>
          </div>
        </div>
      </div>

      <div class="info">
        <div class="pi-panel">
          <span class="pi-kicker">Daily Nausea Support · 30 Vegecaps</span>
          <h1 class="pi-title">Advanced Ginger<em>+</em></h1>
          <p class="pi-subtitle">Gentle Support For Morning Sickness</p>
          <p class="pi-actives">Ginger Extract <i>|</i> Vitamin B<sub>6</sub> (P5P) <i>|</i> Magnesium <i>|</i> Vitamin B<sub>1</sub></p>

          <div class="pi-proof">
            <span class="pi-proof__stars" aria-hidden="true">★★★★★</span>
            <span class="pi-proof__score">4.8</span>
            <span class="pi-proof__sep" aria-hidden="true">·</span>
            <a href="/reviews" class="pi-proof__count">Early reviews</a>
          </div>

          <form action="/cart/buy-now" method="post" id="addToCartForm" class="pi-buy-form">
            <input type="hidden" name="productId" value="<%= product.id %>">
            <input type="hidden" name="quantity" id="bundleQty" value="1">

            <%
              var _base = product.priceInPaise || 59900;
              var _mrp = (product.mrpInPaise && product.mrpInPaise > _base) ? product.mrpInPaise : Math.round(_base * 1.2);
              // Pack total prices in paise — MUST match BUNDLE_PRICES in cartController
              // ('advanced-ginger': { 2: 104900, 3: 146900 }).
              var _packs = [
                { qty: 1, days: 30, price: _base },
                { qty: 2, days: 60, price: 104900, rec: true },
                { qty: 3, days: 90, price: 146900 },
              ];
              var _inr = function (p) { return '₹' + (p / 100).toLocaleString('en-IN'); };
              var _off = function (pk) { return Math.round((1 - pk.price / (_mrp * pk.qty)) * 100); };
            %>
            <div class="pi-packs">
              <span class="pi-packs__label">Choose your plan</span>
              <fieldset class="pi-plans" aria-label="Choose your plan">
                <% _packs.forEach(function (pk, i) { %>
                  <label class="pi-plan<%= i === 0 ? ' is-selected' : '' %>">
                    <input type="radio" name="bundle" value="<%= pk.qty %>" data-qty="<%= pk.qty %>" <%= i === 0 ? 'checked' : '' %>>
                    <% if (pk.rec) { %><span class="pi-plan__flag">Recommended</span><% } %>
                    <span class="pi-plan__dot" aria-hidden="true"></span>
                    <span class="pi-plan__days"><%= pk.days %> Days</span>
                    <span class="pi-plan__packs"><%= pk.qty %> Pack<%= pk.qty > 1 ? 's' : '' %></span>
                    <span class="pi-plan__price"><%= _inr(pk.price) %></span>
                    <span class="pi-plan__save">Save <%= _off(pk) %>%</span>
                  </label>
                <% }); %>
              </fieldset>
              <p class="pi-planinfo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.6v.6"/></svg>
                All prices incl. taxes · 1 capsule per day
              </p>
            </div>


            <% var _soldOut = (typeof product.stock === 'number' && product.stock <= 0);
               var _lowStock = (!_soldOut && typeof product.stock === 'number' && product.stock <= 10); %>
            <% if (_lowStock) { %><p class="pi-stocknote">Only <%= product.stock %> left in stock</p><% } %>
            <% if (_soldOut) { %>
              <div class="pi-buy-row">
                <button type="button" class="pi-add" disabled aria-disabled="true" style="opacity:.5;cursor:not-allowed">Sold out</button>
              </div>
              <p class="pi-stocknote pi-stocknote--muted">Currently out of stock. Please check back soon.</p>
            <% } else { %>
              <div class="pi-buy-row">
                <button type="submit" formaction="/cart/add" class="pi-add-secondary">Add to cart</button>
                <button type="submit" class="pi-add">Buy now</button>
              </div>
            <% } %>
            <div class="pi-urgency">
              <span class="pi-urgency__ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 23a7 7 0 0 0 7-7c0-2.6-1.4-4.7-2.8-6.3-.4 1.3-1.3 2.1-2.4 2.1 1-2.1.3-4.6-1.6-6.4C10.9 3.7 9.4 2.6 9.6 1 6.9 2.6 4.5 5.7 4.5 10c0 .6.1 1.3.2 1.9A7 7 0 0 0 12 23z"/></svg>
              </span>
              <p class="pi-urgency__txt"><strong>Selling fast!</strong> <b id="piViewers">18</b> people are viewing this right now.</p>
            </div>
          </form>

          <ul class="pi-bene">
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.4a8.6 8.6 0 1 0 8.6 8.6"/><path d="M12 7.6V12l3 1.9"/><path d="M17.4 3.2 21 6.4"/></svg></span>
              <span class="pi-bene__t">Helps Manage Morning Discomfort</span>
            </li>
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5.2 4.6h13.6v4.3a6.8 6.8 0 0 1-13.6 0z"/><path d="M8.4 12.9c-1 1.5-1.6 3.1-1.6 4.6a5.2 5.2 0 0 0 10.4 0c0-1.5-.6-3.1-1.6-4.6"/></svg></span>
              <span class="pi-bene__t">Helps Ease Queasiness</span>
            </li>
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13.4" r="4.2"/><path d="M12 4.2v2.4M12 20.2v.6M4.6 13.4H3.4M20.6 13.4h-1.2M6.8 8.2 5.9 7.3M18.1 7.3l-.9.9"/></svg></span>
              <span class="pi-bene__t">Designed For Feel-Good Mornings</span>
            </li>
            <li>
              <span class="pi-bene__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13.2 2.5 5 13.4h5.6L9.9 21.5 18.4 10h-5.9l.7-7.5z"/></svg></span>
              <span class="pi-bene__t">Supports Energy Metabolism</span>
            </li>
          </ul>


          <ul class="pi-trust" aria-label="Product assurances">
            <% ['Doctor recommended', 'FSSAI & GMP', '100% vegetarian'].forEach(function (t) { %>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><%= t %></li>
            <% }); %>
          </ul>


          <p class="pi-footnote">Free shipping over ₹999 · 30-day money-back guarantee</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CERTIFICATION SCROLLER -->
<style>
  /* Infinite horizontal scroller. The track holds TWO identical sets and
     slides to -50%, which lands set B exactly where set A began. For that to
     be seamless the halves must be equal, so the inter-item gap lives inside
     each set and each set carries a trailing pad of the same size — a `gap`
     on the track itself would leave the seam half a gap short and the loop
     would visibly jump. */
  .certs{background:#FBFBFC;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:40px 0;position:relative}
  .certs-viewport{overflow:hidden}
  /* edge fades so items dissolve rather than pop at the boundaries */
  .certs::before,.certs::after{content:'';position:absolute;top:0;bottom:0;width:150px;z-index:2;pointer-events:none}
  .certs::before{left:0;background:linear-gradient(90deg,#FBFBFC 0,#FBFBFC 28%,rgba(251,251,252,0) 100%)}
  .certs::after{right:0;background:linear-gradient(270deg,#FBFBFC 0,#FBFBFC 28%,rgba(251,251,252,0) 100%)}
  .certs-track{display:flex;width:max-content;animation:certScroll 38s linear infinite}
  .certs:hover .certs-track{animation-play-state:paused}
  .certs-set{display:flex;gap:64px;padding-right:64px;list-style:none;margin:0}
  @keyframes certScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  .cert{flex:0 0 184px;width:184px;display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center}
  /* No chip/ring: the supplied marks are already self-contained badges in
     assorted shapes and colours, so a uniform ring around them just fights
     them. A fixed-height box normalises them to one optical size instead. */
  .cert__ic{height:128px;display:grid;place-items:center;color:var(--honey-deep)}
  .cert__ic img{
    max-height:calc(128px * var(--certScale,1));max-width:100%;width:auto;object-fit:contain;
    /* Most of these marks ship on a solid white background. multiply against
       the near-white band drops that box out without needing the PNGs to be
       re-cut with real transparency. */
    mix-blend-mode:multiply;
  }
  .cert__ic svg{width:60px;height:60px}
  .cert__t{font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);line-height:1.4}
  /* A logo file that 404s falls back to its line icon rather than a broken image */
  .cert__fb{display:none}
  .cert__ic.is-fallback img{display:none}
  .cert__ic.is-fallback .cert__fb{display:block}

  @media (max-width:720px){
    .certs{padding:28px 0}
    .certs::before,.certs::after{width:64px}
    .certs-set{gap:38px;padding-right:38px}
    .cert{flex:0 0 138px;width:138px;gap:12px}
    .cert__ic{height:90px}
    .cert__ic img{max-height:calc(90px * var(--certScale,1))}
    .cert__ic svg{width:46px;height:46px}
    .cert__t{font-size:10px;letter-spacing:.08em}
  }
  /* Motion off: stop the animation and hand the row back as a manual scroller,
     otherwise the duplicated set is simply unreachable. */
  @media (prefers-reduced-motion: reduce){
    .certs-track{animation:none}
    .certs-viewport{overflow-x:auto;scrollbar-width:none}
    .certs-viewport::-webkit-scrollbar{display:none}
    .certs::before,.certs::after{display:none}
  }
</style>

<section class="certs" aria-label="Certifications and quality assurances">
  <%
    // `img` is the real certification mark; `svg` is the line-icon fallback
    // shown only if that file is missing (see the cert-logo script below).
    // `scale` nudges marks whose source file carries a lot of internal
    // padding so they land at the same optical size as the round seals.
    // Drop the files in app/src/public/img/certs/ using these exact names.
    var _certs = [
      { t: 'FSSAI Certified', img: '/img/certs/fssai.png', scale: 1.2,   svg: '<circle cx="12" cy="9" r="6"/><path d="m9.4 9 1.9 1.9L15 7.2"/><path d="M8.9 14.4 7.6 22l4.4-2.2L16.4 22l-1.3-7.6"/>' },
      { t: 'GMP Certified', img: '/img/certs/gmp.png',     svg: '<path d="M2.5 21h19"/><path d="M4 21V9.6l5 3.1V9.6l5 3.1V6.3l5 3.1V21"/><path d="M8 21v-3.2M13 21v-3.2"/>' },
      { t: 'ISO Certified', img: '/img/certs/iso.png',     svg: '<path d="M14 2.8H7a2 2 0 0 0-2 2v14.4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7.8z"/><path d="M14 2.8v5h5"/><path d="m8.8 14.2 2.1 2.1 4.3-4.3"/>' },
