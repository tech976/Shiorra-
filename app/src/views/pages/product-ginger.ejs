    .pi-masthead{padding:14px 0}
    .pi-masthead__inner{font-size:10px;letter-spacing:.18em}
  }
</style>

<!-- HERO -->
<section class="product-hero" id="buy">
  <div class="wrap">
    <div class="product-hero-grid">
      <div class="gallery">
        <div class="gallery-main">
          <img id="galleryMain" src="/img/products/ginger-g1.jpg" alt="A hand resting on a Shiōrra Advanced Ginger+ pack beside fresh ginger root on a lavender backdrop">
        </div>
        <div class="gallery-thumbs" id="galleryThumbs">
          <button type="button" class="gallery-thumb is-active" data-full="/img/products/ginger-g1.jpg" aria-label="The pack"><img src="/img/products/ginger-g1.jpg" alt="" loading="lazy"></button>
          <button type="button" class="gallery-thumb" data-full="/img/products/ginger-g2.jpg" aria-label="Morning support"><img src="/img/products/ginger-g2.jpg" alt="" loading="lazy"></button>
          <button type="button" class="gallery-thumb" data-full="/img/products/ginger-g3.jpg" aria-label="Daily routine"><img src="/img/products/ginger-g3.jpg" alt="" loading="lazy"></button>
          <button type="button" class="gallery-thumb" data-full="/img/products/ginger-g4.jpg" aria-label="Back of pack"><img src="/img/products/ginger-g4.jpg" alt="" loading="lazy"></button>
          <button type="button" class="gallery-thumb" data-full="/img/products/ginger-g5.jpg" aria-label="Ingredients and certifications"><img src="/img/products/ginger-g5.jpg" alt="" loading="lazy"></button>
          <button type="button" class="gallery-thumb" data-full="/img/products/ginger-g6.jpg" aria-label="Why these ingredients"><img src="/img/products/ginger-g6.jpg" alt="" loading="lazy"></button>
          <button type="button" class="gallery-thumb" data-full="/img/products/ginger-g7.jpg" aria-label="Shiōrra vs others"><img src="/img/products/ginger-g7.jpg" alt="" loading="lazy"></button>
          <button type="button" class="gallery-thumb" data-full="/img/products/ginger-g8.jpg" aria-label="Your trust"><img src="/img/products/ginger-g8.jpg" alt="" loading="lazy"></button>
        </div>
      </div>
      <div class="info">
        <span class="pi-kicker">Daily Nausea Support · 30 Vegecaps</span>
        <h1 class="pi-title">Advanced Ginger<em>+</em></h1>
        <p class="pi-sub">Standardized ginger extract with active Vit. B<sub>6</sub> (P5P), Vit. B<sub>1</sub> &amp; Magnesium — gentle daily support for nausea, digestion and calm.</p>
        <div class="pi-proof">
          <span class="pi-proof__stars" aria-hidden="true">★★★★★</span>
          <span class="pi-proof__score">4.8</span>
          <span class="pi-proof__sep" aria-hidden="true">·</span>
          <a href="/reviews" class="pi-proof__count">Early reviews</a>
        </div>
        <ul class="pi-trust" aria-label="Product assurances">
          <% ['Doctor recommended', 'FSSAI & GMP', '100% vegetarian'].forEach(function (t) { %>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><%= t %></li>
          <% }); %>
        </ul>
        <form action="/cart/buy-now" method="post" id="addToCartForm" class="pi-buy-form">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <input type="hidden" name="quantity" id="bundleQty" value="1">

          <%
            var _base = product.priceInPaise || 74900;
            var _mrp = (product.mrpInPaise && product.mrpInPaise > _base) ? product.mrpInPaise : Math.round(_base * 1.2);
            // Pack total prices in paise — MUST match BUNDLE_PRICES in cartController.
            var _packs = [
              { qty: 1, days: 30, price: _base },
              { qty: 2, days: 60, price: 104900, rec: true },
              { qty: 3, days: 90, price: 146900 },
            ];
            var _inr = function (p) { return '₹' + (p / 100).toLocaleString('en-IN'); };
          %>
          <fieldset class="pi-bundles" aria-label="Choose your pack">
            <% _packs.forEach(function (pk, i) {
                 var mrpTotal = _mrp * pk.qty;
                 var off = Math.round((1 - pk.price / mrpTotal) * 100); %>
              <label class="pi-bundle<%= i === 0 ? ' is-selected' : '' %>">
                <input type="radio" name="bundle" value="<%= pk.qty %>" data-qty="<%= pk.qty %>" <%= i === 0 ? 'checked' : '' %>>
                <span class="pi-bundle__dot" aria-hidden="true"></span>
                <span class="pi-bundle__left">
                  <span class="pi-bundle__days"><%= pk.days %> Days<% if (pk.rec) { %><span class="pi-bundle__rec">Recommended</span><% } %></span>
                  <span class="pi-bundle__packs">Pack of <%= pk.qty %> · incl. all taxes</span>
                </span>
                <span class="pi-bundle__right">
                  <span class="pi-bundle__price"><s><%= _inr(mrpTotal) %></s> <strong><%= _inr(pk.price) %></strong></span>
                  <span class="pi-bundle__off">Save <%= off %>%</span>
                </span>
              </label>
            <% }); %>
          </fieldset>

          <div class="pi-urgency">
            <span class="pi-urgency__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 23a7 7 0 0 0 7-7c0-2.6-1.4-4.7-2.8-6.3-.4 1.3-1.3 2.1-2.4 2.1 1-2.1.3-4.6-1.6-6.4C10.9 3.7 9.4 2.6 9.6 1 6.9 2.6 4.5 5.7 4.5 10c0 .6.1 1.3.2 1.9A7 7 0 0 0 12 23z"/></svg>
            </span>
            <p class="pi-urgency__txt"><strong>Selling fast!</strong> <b id="piViewers">18</b> people are viewing this right now.</p>
          </div>
          <% var _soldOut = (typeof product.stock === 'number' && product.stock <= 0);
             var _lowStock = (!_soldOut && typeof product.stock === 'number' && product.stock <= 10); %>
          <% if (_lowStock) { %><p class="pi-stocknote" style="margin:6px 0 0;font-size:13px;font-weight:600;color:#C2410C">Only <%= product.stock %> left in stock</p><% } %>
          <% if (_soldOut) { %>
            <div class="pi-buy-row">
              <button type="button" class="pi-add" disabled aria-disabled="true" style="opacity:.5;cursor:not-allowed">Sold out</button>
            </div>
            <p class="pi-stocknote" style="margin:10px 0 0;font-size:13px;color:#6A6F75">Currently out of stock. Please check back soon.</p>
          <% } else { %>
            <div class="pi-buy-row">
              <button type="submit" formaction="/cart/add" class="pi-add-secondary">Add to cart</button>
              <button type="submit" class="pi-add">Buy now</button>
            </div>
          <% } %>
        </form>
        <p class="pi-footnote">Free shipping over ₹999 · 30-day money-back guarantee</p>
      </div>
    </div>
  </div>
</section>
<!-- FAQ -->
