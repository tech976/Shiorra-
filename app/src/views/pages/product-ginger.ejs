     pastel wash of its own product accent; the accent itself only survives at
     full strength in the badge text, which keeps two very different hues
     (green, magenta) sitting quietly side by side. */
  .pair{background:#fff;padding:72px 0 80px}
  .pair__head{text-align:center;margin-bottom:36px}
  /* .s-title carries max-width:760px from the shared section styles. Without
     auto side margins that is a left-hugging box with centred text inside —
     which reads as off-centre. This is the line that actually centres it. */
  .pair__head .s-title{margin-inline:auto;margin-bottom:10px}
  .pair__sub{font-size:16px;color:var(--muted);margin:0}

  /* auto-fit + justify-content:center so the row stays centred at ANY tile
     count — two tiles fill the 920px row exactly, a lone tile (e.g. while
     Ginger+ is down) sits centred instead of stranded in the left column. */
  .pair-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(0,448px));justify-content:center;gap:24px;max-width:920px;margin-inline:auto}

  /* Explicit grid rows AND columns: the form is deliberately assigned the
     media's own cell on desktop. Pinning only the row leaves the column to
     auto-placement, which finds row 1 col 1 taken and opens an implicit
     second column — parking the button beside the pack shot. */
  .pair-tile{
    position:relative;display:grid;grid-template-columns:minmax(0,1fr);align-content:start;
    border-radius:24px;padding:28px 28px 34px;text-align:center;
    background:var(--tile-soft);color:var(--ink);
    box-shadow:inset 0 0 0 1px rgba(40,40,40,.05);
    transition:background .28s ease,transform .28s ease,box-shadow .28s ease;
    isolation:isolate;
  }
  .pair-tile:hover,.pair-tile:focus-within{
    background:#fff;transform:translateY(-4px);
    box-shadow:inset 0 0 0 1px var(--line),0 18px 40px rgba(40,40,40,.11);
  }
  /* Whole card is clickable via a stretched pseudo-element on the product
     name, NOT by wrapping everything in an <a> — an anchor cannot legally
     contain the add-to-cart form, and nesting them makes the button fire the
     link too. The form sits on a higher layer so its clicks never reach it. */
  .pair-link{color:inherit;text-decoration:none}
  .pair-link::after{content:'';position:absolute;inset:0;z-index:1}
  .pair-link:focus-visible{outline:2px solid var(--ink);outline-offset:4px;border-radius:4px}
  .pair-media{grid-column:1;grid-row:1}
  .pair-name{grid-column:1;grid-row:2}
  .pair-price,.pair-sold{grid-column:1;grid-row:3}
  /* Own row, under the name and price, at EVERY width. It used to share the
     media's cell and fade in on hover, which meant the primary action was
     invisible until you hovered the card. z-index keeps it above the
     stretched .pair-link::after that makes the whole tile clickable. */
  .pair-form{
    margin:14px 0 0;grid-column:1;grid-row:4;justify-self:stretch;
    display:flex;justify-content:center;z-index:3;
  }

  /* Pack shots are landscape lifestyle photographs, not cut-outs on
     transparency, so they fill the frame (cover) rather than being
     letterboxed inside it (contain). */
  /* Deliberately NO z-index. With one, .pair-media stacked above the
     stretched .pair-link::after (z-index 1) and swallowed every click over
     the image — which is most of the card — leaving only the name/price
     strip clickable. At auto it paints below the link overlay. */
  .pair-media{
    position:relative;width:100%;border-radius:16px;overflow:hidden;
    background:#fff;aspect-ratio:1/1;
  }
  .pair-media img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .45s cubic-bezier(.2,.7,.3,1)}
  .pair-tile:hover .pair-media img{transform:scale(1.05)}

  .pair-badge{
    position:absolute;top:12px;left:12px;z-index:2;
    font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
    background:rgba(255,255,255,.94);color:var(--tile-ink);padding:5px 10px;border-radius:999px;
  }

  /* Always visible — no reveal to wait for. Full width of the tile so it
     reads as the card's primary action rather than a floating pill. */
  .pair-cta{
    width:100%;height:50px;border-radius:999px;border:1.5px solid var(--ink);
    background:#fff;color:var(--ink);font-weight:800;font-size:13.5px;letter-spacing:.06em;
    text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;
    cursor:pointer;
    transition:background .18s ease,color .18s ease,box-shadow .18s ease;
    box-shadow:0 8px 20px rgba(40,40,40,.10);
  }
  .pair-cta:hover{background:var(--ink);color:#fff;box-shadow:0 10px 26px rgba(40,40,40,.18)}

  /* colour:inherit is load-bearing — the global `h1..h6 {color:charcoal}` in
     style.css otherwise outranks the colour inherited from the card. */
  .pair-name{margin:18px 0 0;font-size:19px;font-weight:700;letter-spacing:-0.01em;line-height:1.25;color:inherit}
  .pair-price{margin:7px 0 0;font-size:16px;font-weight:700;letter-spacing:-0.01em;color:inherit}
  .pair-price s{color:var(--muted-2);font-weight:400;margin-right:7px}
  .pair-sold{margin:7px 0 0;font-size:13px;font-weight:600;color:var(--muted)}

  @media (max-width:820px){
    .pair{padding:44px 0 52px}
    .pair__head{margin-bottom:26px}
    .pair-grid{gap:16px}
    .pair-tile{padding:20px 20px 26px;border-radius:20px}
    .pair-name{margin-top:14px;font-size:16px}
    .pair-price{font-size:14.5px}
    .pair-form{margin-top:12px}
    .pair-cta{height:44px;font-size:12px}
  }
  @media (max-width:560px){
    .pair-grid{grid-template-columns:1fr;max-width:420px}
  }
</style>

<% if (typeof pairWith !== 'undefined' && pairWith && pairWith.length) { %>
<%
  // PER-PRODUCT colours — each tile wears its own product's pastel wherever it
  // appears, so this block is identical on all three PDPs and must NOT be
  // re-tinted to the host page's accent (doing so is what previously turned
  // the Iron+ tile green on the Ginger+ page).
  //   iron  -> pastel pink | ginger -> pastel green | energyone -> pastel purple
  var _tint = {
    'advanced-iron':      { soft: '#FDEEF3', ink: '#E11D48' },
    'advanced-ginger':    { soft: '#EAF5EF', ink: '#2E8B57' },
    'advanced-energyone': { soft: '#F1E9F8', ink: '#B73A92' }
  };
  var _rupee = function (p) { return '₹' + (p / 100).toLocaleString('en-IN'); };
%>
<section class="pair" aria-labelledby="pairTitle">
  <div class="wrap">
    <div class="pair__head">
      <h2 class="s-title" id="pairTitle">Pair it <em>with</em></h2>
      <p class="pair__sub">Built to work alongside Ginger+ in the same daily routine.</p>
    </div>

    <div class="pair-grid">
      <% pairWith.forEach(function (p) {
           var t = _tint[p.slug] || _tint['advanced-iron'];
           // "Pair it with" tile art — a fixed clean pack shot per product, so
           // this section never inherits stale/wrong catalogue images from the DB.
           var _pairImg = {
             'advanced-iron':      '/img/products/iron-home.png',
             'advanced-ginger':    '/img/products/ginger-home.png',
             'advanced-energyone': '/img/products/energy-home.png'
           };
           var img = _pairImg[p.slug] || (p.images && p.images[0] && p.images[0].url) || '/img/products/box-studio.png';
           var out = (typeof p.stock === 'number' && p.stock <= 0); %>
        <div class="pair-tile" style="--tile-soft:<%= t.soft %>;--tile-ink:<%= t.ink %>">
          <div class="pair-media">
            <% if (p.badge) { %><span class="pair-badge"><%= p.badge %></span><% } %>
            <img src="<%= img %>" alt="<%= p.name %>" loading="lazy">
          </div>

          <h3 class="pair-name"><a class="pair-link" href="/product/<%= p.slug %>"><%= p.name %></a></h3>
          <% if (out) { %>
            <p class="pair-sold">Out of stock</p>
          <% } else { %>
            <p class="pair-price">
              <% if (p.mrpInPaise && p.mrpInPaise > p.priceInPaise) { %><s><%= _rupee(p.mrpInPaise) %></s><% } %><%= _rupee(p.priceInPaise) %>
            </p>
          <% } %>

          <%# last in source order, so on a phone it lands below the price;
              on desktop CSS puts it back over the foot of the pack shot %>
          <% if (!out) { %>
            <form class="pair-form" action="/cart/add" method="post">
              <input type="hidden" name="productId" value="<%= p.id %>">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="pair-cta">Add to cart</button>
            </form>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- FOOTER -->
<%- include('../partials/footer-home') %>

<!-- STICKY BUY BAR — standard mobile e-comm pattern (Myntra / Nykaa / Man Matters):
     the bar IS the purchase UI on phones. Buttons submit the main hero form via
     form= attribute, so the qty stepper value is respected. -->
<div class="sticky-cta" id="stickyCta">
  <div class="sticky-inner">
    <% if (!_soldOut) { %>
      <%# Mirrors the hero plan cards. Deliberately NOT part of addToCartForm:
          a second radio group named "bundle" inside the same form would merge
          with the hero's and the existing sync would only see half of them.
          A separate name plus two-way JS sync keeps one source of truth. %>
      <fieldset class="sb-plans" aria-label="Choose your plan">
        <% _packs.forEach(function (pk, i) { %>
          <label class="sb-plan<%= i === 0 ? ' is-selected' : '' %>">
            <input type="radio" name="bundleSticky" value="<%= pk.qty %>" data-qty="<%= pk.qty %>" <%= i === 0 ? 'checked' : '' %>>
            <span class="sb-plan__d"><%= pk.days %> Days &middot; <%= pk.qty %> Pack<%= pk.qty > 1 ? 's' : '' %></span>
            <span class="sb-plan__p"><%= _inr(pk.price) %><s><%= _inr(_mrp * pk.qty) %></s></span>
            <span class="sb-plan__s">Save <%= _off(pk) %>%</span>
          </label>
        <% }); %>
      </fieldset>
    <% } %>
    <div class="sticky-bar">
      <% if (_soldOut) { %>
        <button type="button" class="sticky-bar__btn sticky-bar__buy" disabled aria-disabled="true" style="opacity:.5;cursor:not-allowed">Sold out</button>
      <% } else { %>
        <button type="submit" form="addToCartForm" formaction="/cart/add" class="sticky-bar__btn sticky-bar__cart">Add to cart</button>
        <button type="submit" form="addToCartForm" class="sticky-bar__btn sticky-bar__buy">Buy now</button>
      <% } %>
    </div>
  </div>
</div>

<script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
<script src="/js/lenis-init.js"></script>
<script src="https://unpkg.com/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://unpkg.com/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script src="/js/award.js"></script>
<script src="/js/main.js"></script>
<script>
/* Gallery — click a thumb to swap the main image */
(function () {
  const main = document.getElementById('galleryMain');
  const bg = document.getElementById('galleryBg');
  const thumbs = document.querySelectorAll('.gallery-thumb');
  if (!main || !thumbs.length) return;
  const select = (t) => {
    const url = t.getAttribute('data-full');
    if (!url || main.src.endsWith(url)) return;
    thumbs.forEach((x) => x.classList.remove('is-active'));
    t.classList.add('is-active');
    main.src = url;
    if (bg) bg.style.backgroundImage = "url('" + url + "')";
    // Keep the alt in step with the slide, otherwise it stays stuck
    // describing the first image for anyone using a screen reader.
    const label = t.getAttribute('aria-label');
    if (label) main.alt = 'Shiōrra Advanced Ginger+ — ' + label;
  };

  // Hover previews the slide on pointer devices; click still works everywhere
  // (and is the only path on touch, where there is no hover).
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  thumbs.forEach((t) => {
    t.addEventListener('click', () => select(t));
    if (canHover) t.addEventListener('mouseenter', () => select(t));
  });
})();
// Plan selection — one source of truth (the hidden quantity the cart posts),
// mirrored across the hero cards and the sticky bar's chips so the two can
// never disagree about what is in the basket.
(function () {
  const qtyInput = document.getElementById('bundleQty');
  const hero = document.querySelectorAll('.pi-plan input[name="bundle"]');
  const sticky = document.querySelectorAll('.sb-plan input[name="bundleSticky"]');
  if (!qtyInput || !hero.length) return;

  function apply(qty) {
    qtyInput.value = qty;
    const mark = (nodes, cls) => nodes.forEach((r) => {
      const on = (r.dataset.qty === qty);
      r.checked = on;
      const card = r.closest(cls);
      if (card) card.classList.toggle('is-selected', on);
    });
    mark(hero, '.pi-plan');
    mark(sticky, '.sb-plan');
  }

  hero.forEach((r) => r.addEventListener('change', () => apply(r.dataset.qty)));
  sticky.forEach((r) => r.addEventListener('change', () => apply(r.dataset.qty)));

  const initial = Array.prototype.find.call(hero, (r) => r.checked);
  apply(initial ? initial.dataset.qty : '1');
})();

// Sticky bar reveal — slides up once the hero's own buy row has scrolled off
// the top. Desktop only: on mobile the bar is the permanent purchase UI, and
// the hero row it watches is display:none there, so the observer would never
// fire and would leave the bar hidden.
(function () {
  const bar = document.getElementById('stickyCta');
  const anchor = document.querySelector('.pi-buy-form .pi-buy-row');
  if (!bar || !anchor || !('IntersectionObserver' in window)) return;

  const desktop = window.matchMedia('(min-width:721px)');
  const io = new IntersectionObserver(function (entries) {
    const e = entries[0];
    // scrolled past (row sits above the viewport) — not merely not-yet-reached
    bar.classList.toggle('is-visible', !e.isIntersecting && e.boundingClientRect.top < 0);
  }, { threshold: 0 });

  function wire() {
    io.disconnect();
    if (desktop.matches) io.observe(anchor);
    else bar.classList.remove('is-visible');
  }
  wire();
  desktop.addEventListener('change', wire);
})();

// Cert logos — a missing logo file reveals its line-icon fallback instead of
// leaving a broken image in the band.
(function () {
  document.querySelectorAll('.cert__ic img').forEach(function (img) {
    var fail = function () { img.parentNode.classList.add('is-fallback'); };
    if (img.complete && img.naturalWidth === 0) fail();
    img.addEventListener('error', fail);
  });
})();

// Key-ingredients shot — falls back to the stock capsule photo until the
// dedicated single-pill cut-out is added.
(function () {
  var img = document.getElementById('kiPill');
  if (!img) return;
  var swap = function () {
    var fb = img.getAttribute('data-fallback');
    if (!fb) return;
    img.removeAttribute('data-fallback');
    img.src = fb;
  };
  if (img.complete && img.naturalWidth === 0) swap();
  img.addEventListener('error', swap);
})();

// FAQ — open on hover for mouse users, one at a time.
// Gated on a real hover-capable pointer: touch devices never fire hover, so
// they keep the native tap-to-toggle and are left completely alone. Keyboard
// users are covered by focusin/focusout, which is why suppressing the click
// toggle here does not strand them — Tab still reveals each answer.
(function () {
  var items = document.querySelectorAll('.fq-item');
  if (!items.length) return;
  if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;

  function openOnly(target) {
    items.forEach(function (d) { d.open = (d === target); });
  }

  items.forEach(function (d) {
    d.addEventListener('mouseenter', function () { openOnly(d); });
    d.addEventListener('mouseleave', function () { d.open = false; });
    d.addEventListener('focusin', function () { openOnly(d); });
    d.addEventListener('focusout', function (e) {
      if (!d.contains(e.relatedTarget)) d.open = false;
    });
    // Hover is the single source of truth on these devices; letting the native
    // click toggle run as well would fight it and strand items closed.
    var q = d.querySelector('.fq-q');
    if (q) q.addEventListener('click', function (e) { e.preventDefault(); });
  });
})();

// Social-proof viewer count — a fresh random 10-30 on each visit.
(function () {
  const el = document.getElementById('piViewers');
  if (!el) return;
  el.textContent = String(Math.floor(Math.random() * 21) + 10); // 10..30
})();
</script>
<%- include('../partials/cart-drawer') %>
</body>
</html>
