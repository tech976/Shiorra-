<style>
  .bn{background:#FBFBFC;border-top:1px solid var(--line);padding:76px 0}
  .bn__head{text-align:center;margin-bottom:38px}
  .bn__head .s-title{margin-inline:auto;margin-bottom:0}

  .bn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .bn-card{
    position:relative;overflow:hidden;background:#fff;border:1px solid var(--line);border-radius:20px;
    padding:28px 28px 30px;cursor:default;
    transition:border-color .3s ease,box-shadow .3s ease,transform .3s ease;
  }
  /* Corner wash — gives the card a light source instead of a flat fill.
     Clipped by the card's own overflow:hidden. */
  .bn-card::before{
    content:'';position:absolute;right:-46px;top:-46px;width:165px;height:165px;border-radius:50%;
    background:radial-gradient(circle,rgba(46,139,87,.10),transparent 70%);
    opacity:.7;transition:opacity .35s ease,transform .35s ease;pointer-events:none;
  }
  .bn-card:hover::before,.bn-card:focus-visible::before{opacity:1;transform:scale(1.3)}
  .bn-card:hover,.bn-card:focus-visible{
    border-color:var(--honey);box-shadow:0 18px 42px rgba(20,75,48,.10);
    transform:translateY(-4px);outline:none;
  }
  /* Oversized ghost numeral: occupies the space the short copy leaves behind
     at rest, so the card does not read as half-empty before you hover it. */
  .bn-num{
    position:absolute;right:18px;bottom:-6px;z-index:0;
    font-family:'Helvetica Neue',Arial,sans-serif;font-size:86px;font-weight:800;
    letter-spacing:-0.05em;line-height:1;color:rgba(20,75,48,.055);
    pointer-events:none;user-select:none;transition:color .35s ease,transform .35s ease;
  }
  /* recedes on hover so it never competes with the detailed copy that
     expands over it */
  .bn-card:hover .bn-num,.bn-card:focus-visible .bn-num{color:rgba(20,75,48,.03);transform:translateY(6px)}
  .bn-ic{
    position:relative;z-index:1;width:56px;height:56px;border-radius:16px;
    background:var(--honey-soft);color:var(--honey-deep);display:grid;place-items:center;margin-bottom:18px;
    transition:background .3s ease,color .3s ease,transform .3s ease;
  }
  .bn-ic svg{width:31px;height:31px}
  .bn-card:hover .bn-ic,.bn-card:focus-visible .bn-ic{background:var(--honey);color:#fff;transform:translateY(-2px) rotate(-3deg)}
  .bn-title{position:relative;z-index:1;font-size:20px;font-weight:700;letter-spacing:-0.015em;color:var(--ink);margin:0 0 6px;line-height:1.25}
  /* Rule widens on hover — the only affordance hinting there is more to read. */
  .bn-rule{position:relative;z-index:1;display:block;width:34px;height:2px;background:var(--honey);border-radius:2px;margin:0 0 16px;transition:width .35s cubic-bezier(.2,.7,.3,1)}
  .bn-card:hover .bn-rule,.bn-card:focus-visible .bn-rule{width:76px}

  /* Both copies share one grid cell, so they crossfade in place AND the cell
     self-sizes to whichever is taller. A hand-picked min-height would have to
     be re-guessed for every copy edit and every breakpoint; this never needs
     touching and never lets the card resize on hover. */
  .bn-body{position:relative;z-index:1;display:grid;align-items:start}
  .bn-short,.bn-long{grid-area:1/1;margin:0;font-size:15px;line-height:1.6;transition:opacity .38s ease,transform .38s ease}
  .bn-short{color:var(--ink-soft);opacity:1;transform:none}
  .bn-long{color:var(--muted);opacity:0;transform:translateY(9px)}
  .bn-card:hover .bn-short,.bn-card:focus-visible .bn-short{opacity:0;transform:translateY(-9px)}
  .bn-card:hover .bn-long,.bn-card:focus-visible .bn-long{opacity:1;transform:none}

  @media (max-width:1000px){
    .bn-grid{gap:16px}
    .bn-card{padding:22px 20px 24px}
    .bn-title{font-size:18px}
    .bn-ic{width:50px;height:50px;border-radius:14px;margin-bottom:15px}
    .bn-ic svg{width:27px;height:27px}
    .bn-num{font-size:70px;right:14px}
    .bn-short,.bn-long{font-size:14px}
  }
  /* No hover to reveal with: stack both copies so the detail is simply there.
     Without this the long text would be unreachable on every phone. */
  @media (hover:none),(max-width:760px){
    .bn{padding:46px 0}
    .bn__head{margin-bottom:24px}
    .bn-grid{grid-template-columns:1fr;gap:14px}
    .bn-card{transform:none}
    .bn-body{display:block}
    .bn-short,.bn-long{opacity:1;transform:none}
    .bn-long{margin-top:10px}
  }
  @media (prefers-reduced-motion:reduce){
    .bn-card,.bn-rule,.bn-short,.bn-long{transition:none}
    .bn-card:hover{transform:none}
    .bn-card:hover .bn-short{transform:none}
    .bn-card:hover .bn-long{transform:none}
  }
</style>

