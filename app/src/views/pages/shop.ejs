<style>
  /* shop.ejs — page-scoped layout. Base card styling lives in app.css /
     style.css; everything here tunes the shop grid and its rhythm. */
  .page-hero h1{font-size:clamp(34px,8vw,64px);line-height:1.05;letter-spacing:-0.02em}
  .page-hero .eyebrow{font-size:clamp(11px,2.6vw,13px)}
  .page-hero{padding:clamp(40px,9vw,96px) 0 clamp(24px,6vw,48px)}

  /* ---- Section head above the grid ------------------------------------- */
  .shop-head{text-align:center;max-width:600px;margin:0 auto clamp(26px,4vw,46px)}
  .shop-head__eyebrow{
    display:inline-block;font-size:11.5px;font-weight:700;letter-spacing:.18em;
    text-transform:uppercase;color:var(--c-seagreen,#23867F);margin-bottom:12px;
  }
  .shop-head h2{
    font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
    font-size:clamp(26px,4.2vw,40px);line-height:1.12;letter-spacing:-0.025em;
    margin:0 0 10px;text-wrap:balance;
  }
  .shop-head p{
    font-size:clamp(14.5px,1.6vw,16px);line-height:1.6;margin:0;
    color:var(--c-text-2,#6B6B6B);text-wrap:pretty;
  }

  /* ---- Product grid -----------------------------------------------------
     app.css sets repeat(auto-fill, minmax(240px,1fr)). `auto-fill` KEEPS the
     empty tracks it creates, so with two products the row rendered two narrow
     cards hard-left against a wide dead gap. `auto-fit` + a capped track width
     + centring makes the grid read as deliberate at any product count. */
  .product-grid{
    display:grid!important;
    grid-template-columns:repeat(auto-fit,minmax(250px,300px))!important;
    justify-content:center;
    align-items:stretch;
    gap:clamp(22px,2.6vw,34px)!important;
    max-width:1010px;
    margin-inline:auto;
  }

  /* Equal-height cards so the price row and CTA line up across the row,
     whatever length each tagline happens to be. */
  .product-card{height:100%}
  .product-card__body{display:flex;flex-direction:column;gap:6px;flex:1 1 auto}
  .product-card__desc{
    min-height:2.7em;line-height:1.35;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  }
  .product-card__price{margin-top:auto;padding-top:6px}

  /* Tablet: keep tracks capped rather than stretching two cards very wide */
  @media (max-width: 1024px){
    .product-grid{
      grid-template-columns:repeat(auto-fit,minmax(230px,286px))!important;
      gap:clamp(16px,3vw,28px)!important;
    }
  }
  /* Phones: one comfortable column, centred rather than edge-to-edge */
  @media (max-width: 720px){
    .product-grid{
      grid-template-columns:1fr!important;
      max-width:430px;
      gap:clamp(18px,5vw,26px)!important;
    }
    .section{padding:clamp(40px,10vw,80px) 0!important}
    .container{padding-left:clamp(16px,5vw,24px);padding-right:clamp(16px,5vw,24px)}
    .shop-head{margin-bottom:24px}
  }
  /* Touch-target safety for every card-level link/button reused on this page */
  @media (max-width: 720px){
    .product-card__cta,
    .product-card a.btn,
    .product-card__media{min-height:44px}
    .product-card__cta{padding:14px 18px;min-height:48px}
    .product-card__name{font-size:clamp(17px,4.4vw,21px)}
  }

  /* Stock states */
  .product-card__badge--soldout{background:#15171A!important;color:#fff!important}
  .product-card--soldout .product-card__media img{opacity:.55;filter:grayscale(.2)}
  .product-card__stock{margin:6px 0 0;font-size:12.5px;font-weight:600;color:#C2410C;letter-spacing:.01em}

  /* Empty state */
  .shop-empty{text-align:center;padding:48px 0;color:var(--c-text-2,#6B6B6B)}
</style>

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">Shop</span>
        <h1>The full range.</h1>
    </div>
</section>

<section class="section" style="padding-bottom:0;">
    <div class="container">
        <% if (products && products.length) { %>
            <%- include('../partials/help-me-choose', { products: products }) %>
        <% } %>
    </div>
</section>

<section class="section">
    <div class="container">
        <% if (products.length === 0) { %>
            <p class="shop-empty">No products yet — check back shortly.</p>
        <% } else { %>
            <div class="shop-head">
                <span class="shop-head__eyebrow">The range</span>
                <h2>One job each, done properly.</h2>
                <p>Focused formulas built on clinically-backed actives — gentle enough to take every day.</p>
            </div>
            <div class="product-grid">
                <% products.forEach(function(product) { %>
                    <%- include('../partials/product-card', { product: product }) %>
                <% }); %>
            </div>
        <% } %>
    </div>
</section>
