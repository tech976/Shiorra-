<!-- BENEFITS -->
<style>
  /* ============================================================
     BENEFITS — one stage at a time, with a large photo beside it
     Hover (or tap, or keyboard focus) a stage: its card opens to two lines
     of copy and the photo panel crossfades to that stage. One stage is
     always open, so the section never rests as three closed bars.

     The photo frame is locked to 2:3 because every photo is exported
     1024x1536. Frame and photo share a ratio, so object-fit:cover fills
     edge to edge with NOTHING cropped. Export any replacement at 2:3 too.
     ============================================================ */
  .ben{background:#fff;border-top:1px solid var(--line);padding:88px 0}
  .ben-grid{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,440px);
    grid-template-areas:"intro photo" "list photo";
    grid-template-rows:auto 1fr;
    column-gap:72px;row-gap:30px;align-items:start;
  }
  .ben-intro{grid-area:intro}
  .ben-intro .s-title{margin-bottom:14px}
  .ben-sub{font-size:16px;color:var(--ink-soft);line-height:1.65;margin:0;max-width:44ch}

  /* ---- photo panel ---- */
  .ben-photo{
    grid-area:photo;align-self:center;position:relative;width:100%;aspect-ratio:2/3;
    border-radius:24px;overflow:hidden;background:var(--honey-soft);color:var(--honey);
    display:grid;place-items:center;
    box-shadow:0 24px 60px rgba(159,18,57,.14),0 0 0 1px rgba(159,18,57,.06);
  }
  .ben-photo svg{width:56px;height:56px;opacity:.5}
  /* all three are stacked; only the active one is visible */
  .ben-photo img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;
    opacity:0;transform:scale(1.03);transition:opacity .5s ease,transform .8s ease;
  }
  .ben-photo img.is-active{opacity:1;transform:none}
  /* display:block above would beat the UA's [hidden] rule, so say it outright */
  .ben-photo img[hidden]{display:none}

  /* ---- stage list ---- */
  .ben-list{grid-area:list;list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
  .ben-item{
    width:100%;text-align:left;cursor:pointer;
    background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px 24px;
    transition:border-color .28s ease,box-shadow .28s ease,transform .28s ease;
  }
  .ben-item:hover,.ben-item.is-active{border-color:var(--honey);box-shadow:0 14px 34px rgba(159,18,57,.10);transform:translateY(-2px)}
  .ben-item:focus-visible{outline:2px solid var(--honey);outline-offset:3px}
  .ben-item__n{font-size:11px;font-weight:800;letter-spacing:.16em;color:var(--honey);display:block;margin-bottom:7px}
  .ben-item__t{font-size:20px;font-weight:700;letter-spacing:-0.015em;color:var(--ink);margin:0 0 6px;line-height:1.25}
  .ben-item__s{font-size:14.5px;color:var(--ink-soft);line-height:1.55;margin:0}
  /* grid-rows animates 0fr -> 1fr, i.e. to the copy's own height */
  .ben-item__more{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .38s ease,opacity .3s ease}
  .ben-item.is-active .ben-item__more{grid-template-rows:1fr;opacity:1}
  .ben-item__more > div{overflow:hidden}
  .ben-item__l{display:block;font-size:14.5px;color:var(--muted);line-height:1.65;margin:0;padding-top:12px}

  @media (max-width:980px){
    .ben-grid{
      grid-template-columns:1fr;
      grid-template-areas:"intro" "photo" "list";
      grid-template-rows:auto;row-gap:26px;
    }
    .ben-intro{text-align:center}
    .ben-sub{margin-inline:auto}
    /* still the full 2:3 photo, just narrower so it fits one screen */
    .ben-photo{width:min(380px,82%);justify-self:center}
  }
  @media (max-width:680px){
    .ben{padding:52px 0}
    .ben-item{padding:17px 19px}
    .ben-item__t{font-size:18px}
    .ben-photo{width:min(320px,86%);border-radius:20px}
  }
  @media (prefers-reduced-motion:reduce){
    .ben-item,.ben-item__more,.ben-photo img{transition:none}
    .ben-item:hover,.ben-item.is-active{transform:none}
  }
</style>

