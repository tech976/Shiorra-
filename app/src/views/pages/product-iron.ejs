<!-- HAEMOGLOBIN RISE — full-bleed infographic -->
<style>
  /* ============================================================
     HAEMOGLOBIN RISE — edge-to-edge artwork, blended into the page
     The image is 16:9 (1672x941) and spans the full viewport, outside .wrap.
     Two seams made it read as a picture pasted between sections, so both are
     closed here rather than in the artwork:
       top    — its edge is near-white (253,252,252), so plain white padding
                gives it the same breathing room as every other section and
                simply runs on into it.
       bottom — it ends in pink mountain mist cut straight across, against
                the pure white testimonials. The last few percent are masked
                out over a matching tint (#FDF4F6, the bottom row's average),
                and that tint then eases back to white below the image.
       The top 3% is faded out too: the artwork carries a faint blush tint
       that otherwise shows as an edge against the white padding. Its first
       content (the label top-left) starts at 4%, so nothing is lost.
     ============================================================ */
  .hemo{border-top:1px solid var(--line);background:#fff;padding-top:clamp(24px,3.2vw,48px)}
  .hemo__fig{
    margin:0;position:relative;
    /* what the masked-out bottom edge dissolves into */
    background:linear-gradient(180deg,rgba(253,244,246,0) 78%,#FDF4F6 100%);
  }
  .hemo__fig img{
    display:block;width:100%;height:auto;
    -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 3%,#000 95%,transparent 100%);
            mask-image:linear-gradient(180deg,transparent 0,#000 3%,#000 95%,transparent 100%);
  }
  .hemo__tail{height:clamp(44px,6vw,96px);background:linear-gradient(180deg,#FDF4F6 0%,#FFFFFF 100%)}
  .hemo__hint{display:none}
  /* visually hidden, but gives the section a real heading for screen readers */
  .hemo__h{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

  /* Phones: at full width the artwork is a ~220px strip with ~5px text, so it
     is shown at a readable 940px instead and scrolls sideways. A portrait
     export for mobile would beat this — swap it in with <picture> if one is
     made. */
  @media (max-width:720px){
    .hemo{padding-top:28px}
    .hemo__hint{
      display:flex;align-items:center;justify-content:center;gap:6px;
      font-size:12px;font-weight:600;letter-spacing:.04em;color:var(--muted-2);margin:0 0 12px;
    }
    .hemo__hint svg{width:14px;height:14px}
    .hemo__scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;overscroll-behavior-x:contain}
    .hemo__scroll::-webkit-scrollbar{display:none}
    .hemo__fig{width:940px}
  }
</style>
