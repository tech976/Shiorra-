<!-- KEY INGREDIENTS -->
<style>
  /* ============================================================
     KEY INGREDIENTS — living ingredient orbit
     The capsule sits at the centre and the nine actives orbit it as powder
     discs, drifting slowly. Hover (or focus, or tap) an active and its name
     pops up beside it; the ring holds still while you read it so the label
     does not slide out from under the pointer.
     Angles are driven from JS (see the orbit script) rather than CSS
     keyframes, so the ring can pause and resume from wherever it is.
     ============================================================ */
  .orb{background:linear-gradient(180deg,#FFFFFF 0%,#FDF6F8 55%,#FFFFFF 100%);border-top:1px solid var(--line);padding:78px 0 92px}
  .orb__head{text-align:center;margin-bottom:14px}
  .orb__head .s-title{margin-inline:auto;margin-bottom:0}
  .orb__hint{text-align:center;font-size:13px;color:var(--muted-2);margin:0 0 30px}
  .orb__hint-touch{display:none}
  @media (hover:none){.orb__hint-hover{display:none}.orb__hint-touch{display:inline}}

  /* ---- stage ---- */
  .orb-stage{position:relative;width:min(520px,100%);aspect-ratio:1;margin-inline:auto;--r:206px}
  .orb-ring,.orb-ring--inner{
    position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:50%;
    border:1px dashed rgba(159,18,57,.20);pointer-events:none;
  }
  .orb-ring{width:calc(var(--r) * 2);height:calc(var(--r) * 2)}
  .orb-ring--inner{width:calc(var(--r) * 1.08);height:calc(var(--r) * 1.08);border-style:solid;border-color:rgba(159,18,57,.09)}

  /* capsule at the centre, over a soft bloom */
  .orb-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:62%;z-index:3;pointer-events:none}
  .orb-core::before{
    content:'';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
    width:150%;aspect-ratio:1;border-radius:50%;
    background:radial-gradient(circle,rgba(225,29,72,.14),transparent 68%);
  }
  .orb-core img{position:relative;width:100%;height:auto;display:block}

  /* ---- orbiting actives ---- */
  .orb-node{
    position:absolute;left:50%;top:50%;width:78px;height:78px;padding:0;border:0;background:none;
    cursor:pointer;z-index:2;
    /* place on the circle, then counter-rotate so the disc stays upright.
       --a is set per frame from JS, so it deliberately has no transition. */
    transform:translate(-50%,-50%) rotate(var(--a)) translateY(calc(-1 * var(--r))) rotate(calc(-1 * var(--a)));
  }
  .orb-node:focus-visible{outline:none}
  /* the one being read rises above its neighbours and the capsule */
  .orb-node:hover,.orb-node:focus-visible,.orb-node.is-lit{z-index:5}
  .orb-node__disc{
    display:block;width:100%;height:100%;border-radius:50%;overflow:hidden;
    background:#fff;box-shadow:0 6px 18px rgba(120,20,50,.14),0 0 0 3px #fff,0 0 0 4px rgba(159,18,57,.10);
    transition:box-shadow .3s ease,transform .3s ease;
  }
  /* the swatches are a powder blob centred on white — scaling up inside the
     circular mask fills the disc with powder instead of framing it in white */
  .orb-node__disc img{width:100%;height:100%;object-fit:cover;transform:scale(1.75);display:block}
  .orb-node:hover .orb-node__disc,.orb-node:focus-visible .orb-node__disc,.orb-node.is-lit .orb-node__disc{
    transform:scale(1.12);
    box-shadow:0 12px 28px rgba(120,20,50,.24),0 0 0 3px #fff,0 0 0 5px var(--honey);
  }

  /* the name pop-up — hidden at rest so the ring reads as nine clean discs */
  .orb-node__label{
    position:absolute;left:50%;top:calc(100% + 9px);
    transform:translate(-50%,4px) scale(.92);transform-origin:50% 0;
    white-space:nowrap;font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    color:#fff;background:var(--honey-deep);
    padding:5px 11px;border-radius:999px;box-shadow:0 8px 20px rgba(120,20,50,.22);
    opacity:0;transition:opacity .22s ease,transform .22s ease;pointer-events:none;
  }
  /* small pointer notch so the pill clearly belongs to its disc */
  .orb-node__label::before{
    content:'';position:absolute;left:50%;top:-4px;width:8px;height:8px;margin-left:-4px;
    background:var(--honey-deep);transform:rotate(45deg);border-radius:1px;
  }
  .orb-node:hover .orb-node__label,.orb-node:focus-visible .orb-node__label,.orb-node.is-lit .orb-node__label{
    opacity:1;transform:translate(-50%,0) scale(1);
  }

  @media (max-width:980px){
    .orb-stage{width:min(440px,86vw);--r:172px}
    .orb-node{width:68px;height:68px}
  }
  @media (max-width:680px){
    .orb{padding:48px 0 64px}
    .orb-stage{width:min(330px,80vw);--r:130px}
    .orb-node{width:54px;height:54px}
    .orb-node__label{font-size:10px;padding:4px 9px}
  }
  @media (prefers-reduced-motion:reduce){
    .orb-node__disc,.orb-node__label{transition:none}
  }
</style>

