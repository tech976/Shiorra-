<%
  // Policy pages get a small switcher so customers can hop between them.
  const policyLinks = [
    { href: '/terms', label: 'Terms' },
    { href: '/privacy', label: 'Privacy' },
    { href: '/shipping', label: 'Shipping' },
    { href: '/returns', label: 'Returns' },
  ];
  const current = typeof pagePath !== 'undefined' ? pagePath : '';
  const isPolicy = policyLinks.some((l) => l.href === current);
%>
<style>
    .sp-hero {
        background: #F6F8F7;
        border-bottom: 1px solid #ECEEED;
        padding: clamp(40px, 6vw, 72px) 0 clamp(32px, 5vw, 48px);
    }
    .sp-wrap {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 clamp(20px, 5vw, 32px);
        box-sizing: border-box;
    }
    .sp-crumbs {
        display: flex; align-items: center; gap: 8px;
        font-size: 13px; color: #8A8A8A;
        margin: 0 0 18px;
    }
    .sp-crumbs a { color: #8A8A8A; text-decoration: none; }
    .sp-crumbs a:hover { color: #23867F; }
    .sp-hero h1 {
        font-family: var(--ff-display, 'Helvetica Neue', Arial, sans-serif);
        font-size: clamp(30px, 4.4vw, 44px);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: #1A1A1A;
        margin: 0 0 10px;
    }
    .sp-sub { font-size: 15px; color: #6B6B6B; margin: 0; }

    .sp-tabs {
        display: flex; flex-wrap: wrap; gap: 8px;
        margin: 26px 0 0; padding: 0; list-style: none;
    }
    .sp-tabs a {
        display: inline-block;
        padding: 7px 16px;
        border: 1px solid #DCE2E0;
        border-radius: 999px;
        background: #fff;
        font-size: 13.5px; font-weight: 500;
        color: #3A3A3A;
        text-decoration: none;
        transition: border-color .15s, color .15s, background .15s;
    }
    .sp-tabs a:hover { border-color: #23867F; color: #23867F; }
    .sp-tabs a[aria-current="page"] { background: #23867F; border-color: #23867F; color: #fff; }
    @media (max-width: 420px) {
        .sp-tabs { gap: 6px; }
        .sp-tabs a { padding: 6px 12px; font-size: 13px; }
    }

    .sp-body {
        background: #fff;
        padding: clamp(36px, 5vw, 56px) 0 clamp(56px, 8vw, 96px);
    }
    .sp-content {
        font-size: 16px;
        line-height: 1.75;
        color: #2E2E2E;
    }
    .sp-content > :first-child { margin-top: 0; }
    .sp-content p { margin: 0 0 16px; }
    .sp-content ul, .sp-content ol { margin: 0 0 16px; padding-left: 22px; }
    .sp-content li { margin-bottom: 6px; }
    .sp-content h2 {
        font-family: var(--ff-display, 'Helvetica Neue', Arial, sans-serif);
        font-size: 20px;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: #1A1A1A;
        margin: 36px 0 10px;
        padding-top: 28px;
        border-top: 1px solid #EEEEEE;
    }
    .sp-content a:not(.btn) {
        color: #23867F;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
    }
    .sp-content a:not(.btn):hover { color: #1B6E68; }
    .sp-content .btn { margin-top: 6px; }
</style>

<section class="sp-hero">
    <div class="sp-wrap">
        <nav class="sp-crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><span><%= heading %></span>
        </nav>
        <h1><%= heading %></h1>
        <% if (sub) { %><p class="sp-sub"><%= sub %></p><% } %>
        <% if (isPolicy) { %>
            <ul class="sp-tabs">
                <% policyLinks.forEach(function (l) { %>
                    <li><a href="<%= l.href %>"<%- l.href === current ? ' aria-current="page"' : '' %>><%= l.label %></a></li>
                <% }); %>
            </ul>
        <% } %>
    </div>
</section>

<section class="sp-body">
    <div class="sp-wrap">
        <div class="sp-content"><%- content %></div>
    </div>
</section>
