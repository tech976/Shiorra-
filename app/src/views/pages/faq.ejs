  // and Service come from faqShared, so this page and every product page
  // quote the same shipping terms (src/data/faq.js).
  var _faqTabs = [
    { k: 'products', label: 'Products', items: [
          { q: "What are the three Shi\u014drra products?",
            a: "<strong>Iron+</strong> is a complete hematinic for pregnancy &amp; postpartum. <strong>Ginger+</strong> is a gentle daily support for first-trimester nausea. <strong>EnergyOne+</strong> is a caffeine-free, multi-nutrient daily energy support for busy adults. All three share the same active-form formulation philosophy." },
          { q: "What makes Shi\u014drra Iron+ different from regular iron tablets?",
            a: "Iron+ uses <strong>Ferrous Bisglycinate</strong> \u2014 a chelated form of iron that's 2-4\u00d7 better absorbed and ~90% gentler than ferrous sulfate. It also includes the Vit. B<sub>12</sub>, folate, Vit. B<sub>6</sub> and zinc co-factors most conventional tablets skip." },
          { q: "Is the folate in Iron+ active?",
            a: "Yes. We use <strong>L-methylfolate</strong> (570 mcg) \u2014 the active form. No enzymatic conversion required, which means it works even for women with the MTHFR variant." },
          // GINGER+ TEMPORARILY DOWN — restore this Q&A when the product is live again.
          // { q: "What's in Ginger+?",
          // a: "Standardized Ginger Extract (250 mg) + active <strong>Vit. B<sub>6</sub> as P5P</strong> (2.3 mg) + Vit. B<sub>1</sub> + Magnesium Bisglycinate. Built specifically for first-trimester nausea and gentle daily digestion." },
          { q: "Is EnergyOne+ caffeine-free?",
            a: "Yes \u2014 100% caffeine-free. It uses Taurine + Ginseng extract + B-Complex + minerals + amino acids to support your body's natural energy systems. Not a stimulant, not a crash." },
          { q: "Are all Shi\u014drra products vegetarian?",
            a: "Yes. Every Shi\u014drra capsule is 100% vegetarian \u2014 vegecap shells, no gelatin, no animal-derived ingredients." }
    ] },
    { k: 'safety', label: 'Safety', items: [
          { q: "Can I take Iron+ throughout pregnancy?",
            a: "Yes \u2014 Iron+ is designed for use throughout pregnancy and postpartum. Always confirm with your OB-GYN, particularly if your current hemoglobin is on the very low end." },
          // GINGER+ TEMPORARILY DOWN — restore this Q&A when the product is live again.
          // { q: "Can I take Iron+ and Ginger+ together?",
          // a: "Yes \u2014 they pair well. Many moms take Ginger+ in the morning (for nausea) and Iron+ later in the day. Both are gentle enough for daily use." },
          // GINGER+ TEMPORARILY DOWN — restore this Q&A when the product is live again.
          // { q: "Is Ginger+ safe in the first trimester?",
          // a: "Yes \u2014 Ginger+ was built specifically for first-trimester nausea. The doses of ginger and Vit. B<sub>6</sub> are pregnancy-friendly. If symptoms are severe or persistent, please consult your gynaecologist." },
          { q: "Is EnergyOne+ safe in pregnancy?",
            a: "EnergyOne+ contains ginseng extract, which is typically <strong>not recommended during pregnancy</strong>. For pregnant or breastfeeding women, we recommend Iron+ and/or Ginger+ instead and a chat with your doctor before adding any new supplement." },
          { q: "Will Iron+ cause constipation or nausea?",
            a: "It's significantly less likely than conventional iron. Ferrous Bisglycinate is ~90% gentler on the GI tract. If you do feel queasy, take it with food, with plenty of water, and pair with Ginger+ during the first trimester." }
    ] },
    { k: 'routine', label: 'Routine', items: [
          { q: "When should I take Iron+?",
            a: "Once a day, ideally with a meal. Avoid pairing with tea, coffee or calcium-rich drinks within an hour \u2014 they can blunt iron absorption. Vitamin C-rich foods (citrus, amla) help." },
          // GINGER+ TEMPORARILY DOWN — restore this Q&A when the product is live again.
          // { q: "When should I take Ginger+?",
          // a: "Once a day, anytime. Many women take it in the morning when nausea tends to peak. You can take it with or without food." },
          { q: "When should I take EnergyOne+?",
            a: "Once a day, anytime. Most people take it in the morning. Caffeine-free, so it won't interfere with sleep if you take it later in the day." },
          { q: "How long until I notice a difference?",
            a: "Most women report the first improvements within 1-2 weeks (settling, less fatigue) and meaningful changes by week 4. With Iron+, hemoglobin usually rises steadily over 3-6 months." },
          { q: "What if I miss a day?",
            a: "Just take the next dose on schedule \u2014 don't double up. Consistency matters more than perfection." }
    ] },
    { k: 'delivery', label: 'Delivery', items: faqShared.delivery },
    { k: 'service',  label: 'Service',  items: faqShared.service }
