<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FAQ · Shiōrra · Common Questions Answered</title>
<meta name="description" content="Common questions about Shiōrra Iron+, Ginger+ and EnergyOne+ — ingredients, safety, routine, shipping and returns. Real answers from K.C. Laboratories." />
<link rel="shortcut icon" type="image/png" href="/img/logo/logo-green.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    --honey:#3DBDB6;
    --honey-2:#2FA39C;
    --honey-deep:#23867F;
    --honey-soft:#E0F5F3;
    --charcoal:#282828;
    --charcoal-2:#3A3A3A;
    --ink:#282828;
    --ink-soft:#3A3A3A;
    --white:#FFFFFF;
    --surface:#F7F7F8;
    --line:#E5E5E7;
    --line-soft:#F0F0F2;
    --muted:#6B6B6B;
    --green:#1E9E5C;
  }
  html{scroll-behavior:smooth;overflow-x:clip}
  body{font-family:'Inter','Helvetica Neue',Arial,sans-serif;color:var(--ink);background:#fff;line-height:1.55;font-size:15px;overflow-x:clip}
  img{max-width:100%;display:block}
  a{color:inherit;text-decoration:none}
  button{font:inherit;cursor:pointer;border:0;background:none}
  .wrap{max-width:1180px;margin:0 auto;padding:0 20px}

  .marquee{background:var(--charcoal);color:#fff;padding:10px 0;overflow:hidden;border-bottom:1px solid var(--line)}
  .marquee-track{display:flex;gap:48px;width:max-content;animation:marquee 36s linear infinite;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}
  .marquee-item{display:inline-flex;align-items:center;gap:8px}
  .marquee-item svg{width:14px;height:14px;color:var(--honey)}
  .marquee-item .accent{color:var(--honey)}
  @keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

  .microbar{background:var(--surface);border-bottom:1px solid var(--line);padding:8px 0;font-size:12px;color:var(--ink-soft);font-weight:500}
  .microbar-inner{display:flex;justify-content:center;gap:32px;flex-wrap:wrap}
  .microbar-item{display:inline-flex;align-items:center;gap:6px}
  .microbar-item svg{width:14px;height:14px;color:var(--honey)}

  /* Hero */
  .ed-hero{background:var(--honey-soft);padding:96px 0 80px;position:relative;overflow:hidden;text-align:center}
  .ed-hero::before{content:'';position:absolute;top:-120px;right:-100px;width:420px;height:420px;border-radius:50%;background:transparent;pointer-events:none}
  .ed-hero .wrap{position:relative}
  .ed-hero .eyebrow{display:inline-block;background:var(--honey-soft);color:var(--honey-deep);font-size:12px;font-weight:800;padding:7px 14px;border-radius:20px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:18px}
  .ed-hero h1{font-family:'Helvetica Neue',Arial,sans-serif;font-size:60px;font-weight:700;line-height:1.02;letter-spacing:-0.03em;max-width:16ch;margin:0 auto 22px;color:var(--charcoal);text-wrap:balance}
  .ed-hero h1 em{font-style:italic;color:var(--honey);font-weight:500}
  @media(max-width:680px){.ed-hero h1{font-size:40px}}
  .ed-hero p{font-size:17px;color:var(--muted);max-width:60ch;margin:0 auto 28px;line-height:1.6}

  /* Search */
  .fq-search{max-width:560px;margin:0 auto;position:relative}
  .fq-search input{width:100%;padding:16px 18px 16px 48px;border:1.5px solid var(--line);background:#fff;border-radius:14px;font:inherit;font-size:15px;box-shadow:0 8px 24px rgba(40,40,40,.06);transition:border-color .2s,box-shadow .2s}
  .fq-search input:focus{outline:none;border-color:var(--honey);box-shadow:0 0 0 4px rgba(61,189,182,.15)}
  .fq-search svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--muted)}

  /* Sections */
  section.s{padding:72px 0;font-size:17px}
  @media(max-width:680px){section.s{padding:56px 0}}
  .s-eyebrow{display:inline-block;background:var(--honey-soft);color:var(--honey-deep);font-size:12px;font-weight:700;padding:7px 14px;border-radius:20px;letter-spacing:.10em;text-transform:uppercase;margin-bottom:16px}
  .s-title{font-family:'Helvetica Neue',Arial,sans-serif;font-size:38px;font-weight:700;line-height:1.05;letter-spacing:-0.025em;margin-bottom:12px;color:var(--charcoal);text-wrap:balance}
  .s-title em{font-style:italic;color:var(--honey);font-weight:500}
  @media(max-width:680px){.s-title{font-size:28px}}
  .s-sub{font-size:16px;color:var(--ink-soft);max-width:640px;line-height:1.6}

  /* The tabbed FAQ partial brings its own styles; this is just the
     section's vertical rhythm on this page. */
  .fq-tabs-sec{padding:56px 0 76px}

  /* Helpdesk */
  .fq-help{background:var(--charcoal);color:#fff;padding:72px 0;text-align:center}
  .fq-help h2{font-family:'Helvetica Neue',Arial,sans-serif;font-size:42px;font-weight:700;max-width:18ch;margin:0 auto 16px;line-height:1.05;letter-spacing:-0.02em}
  .fq-help h2 em{font-style:italic;color:var(--honey);font-weight:500}
  @media(max-width:680px){.fq-help h2{font-size:32px}}
  .fq-help p{font-size:16px;color:#bbb;max-width:60ch;margin:0 auto 32px}
  .fq-help-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:760px;margin:0 auto;text-align:left;align-items:stretch}
  @media(max-width:680px){.fq-help-grid{grid-template-columns:1fr}}
  .fq-help-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:22px;color:#fff;transition:transform .2s,background .2s}
  .fq-help-card:hover{transform:translateY(-2px);background:rgba(255,255,255,.10)}
  .fq-help-card .ic{width:48px;height:48px;border-radius:14px;background:rgba(61,189,182,.18);color:var(--honey);display:grid;place-items:center;margin-bottom:14px}
  .fq-help-card .ic svg{width:24px;height:24px;stroke-width:2}
  .fq-help-card h5{font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;margin-bottom:6px}
  .fq-help-card p{font-size:13.5px;color:#bbb;margin:0;line-height:1.5;max-width:none}

  /* Footer */
  .ed-footer{background:var(--charcoal);color:#ddd;padding:56px 0 24px;border-top:1px solid rgba(255,255,255,.08)}
  .ed-footer__cols{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:32px}
  @media(max-width:880px){.ed-footer__cols{grid-template-columns:1fr 1fr}}
  .ed-footer__brand img{height:32px;margin-bottom:12px}
  .ed-footer__brand p{color:#999;font-size:.88rem;max-width:32ch}
  .ed-footer__col h5{color:#fff;font-size:.74rem;margin-bottom:12px;letter-spacing:.08em;text-transform:uppercase}
  .ed-footer__col ul{list-style:none}
  .ed-footer__col li{margin-bottom:8px}
  .ed-footer__col a{color:#aaa;font-size:.88rem}
  .ed-footer__col a:hover{color:var(--honey)}
  .ed-footer__bar{display:flex;justify-content:space-between;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);color:#777;font-size:.82rem;flex-wrap:wrap;gap:8px}
</style>
</head>
