<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Shiōrra Advanced Iron+ · Smarter Iron for a Healthier Pregnancy</title>
    <meta name="description" content="Shiōrra Advanced Iron+ — Smarter iron for a healthier pregnancy. Ferrous Bisglycinate, Selenium, Copper, Zinc & B-Complex Vitamins. Gentle on stomach, no preservatives. A trademark of K.C. Laboratories.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/png" href="/img/logo/logo-green.png">
    <link rel="stylesheet" href="/css/style.css">
    <style>
      /* home.ejs — surgical mobile augmentations (page-scoped).
         Base layout/typography lives in /css/style.css; these rules only
         fire <=720px (and 360px) to tighten the storefront on Indian-mobile. */

      /* Promo strip: prevent two-line clipping on narrow widths */
      @media (max-width: 720px){
        .promo{padding:7px 14px;font-size:11.5px;line-height:1.35}
        .promo span{display:inline-block;text-align:center}
      }

      /* Hero banner on phones.
         Previously hidden outright, and for a real reason: style.css shapes
         the mobile slot to 4:5, while this artwork is 2.34:1 landscape with
         baked-in headline text composed edge to edge (hero-2 puts its
         headline hard left and a trust panel hard right). A portrait slot
         either slices that text off or strands it in letterbox bands.
         Shown here at the artwork's OWN ratio instead: full-bleed, no crop,
         nothing sliced. The carousel script already assigns aspect-ratio
         inline from the real image dimensions, so this value only has to
         match it — without it the slot reserves a tall 4:5 box and the hero
         visibly collapses to a 2.34:1 strip once the images land. */
      @media (max-width: 720px){
        /* Taller slot, artwork untouched. The extra height is added as ONE
           band along the TOP, by anchoring the image to the slot's bottom.
           Why the top: all four banners open on the same pale backdrop
           (sampled top rows: 245-250 / 217-235 / 215-224), so a cream band
           there blends in — whereas hero-4 runs dark-green foliage right to
           its BOTTOM edge and would show any band beneath it.
           Cropping to gain the height was measured and rejected: content
           reaches the very edge on hero-1, hero-3 and hero-4, and hero-2's
           right-hand trust panel sits 1.04% from its edge, so even a 2%
           cover-crop slices real artwork.
           !important is load-bearing: the carousel script assigns
           aspect-ratio INLINE from the artwork's natural dimensions, and an
           inline style outranks a stylesheet rule, so without it this value
           is silently ignored on phones. */
        .hero-banners{aspect-ratio:2.15!important;max-height:none;background:#F7E3DC}
        /* A FLAT band was tried first and read as a hard seam: the artwork's
           top is a gradient, so no single colour matches it. The band is
           filled with a blurred, slightly enlarged copy of the slide's own
           image instead, which blends on all four regardless of their very
           different edges. --bg is assigned by the carousel script from each
           slide's real <img> src, so the fill can never drift from the art. */
        .hero-banners__slide::before{
          content:'';position:absolute;inset:0;z-index:0;
          background-image:var(--bg);background-size:cover;background-position:center;
          filter:blur(13px);transform:scale(1.09);
        }
        /* Clip on the SLIDE, not the container: .hero-banners is
           overflow:visible so the dots can sit below it, and without this the
           blurred, scaled fill would spill over the section around it. */
        .hero-banners__slide{overflow:hidden}
        .hero-banners__slide a,
        .hero-banners__slide img{position:relative;z-index:1}
        .hero-banners__slide img{object-fit:contain;object-position:center bottom}
        /* On a ~167px-tall slot an overlay indicator lands squarely on the
           artwork's subject (it sat on the middle pack), so the dots move
           BELOW the banner instead. There is no corner that is clear on all
           four banners — hero-1 has ginger bottom-left, hero-2 a trust panel
           bottom-right — so under the image is the only placement that never
           covers content.
           overflow:visible is what lets them sit outside the slot. Safe here:
           the slides are inset:0 and the artwork ratio matches the slot
           exactly, so there is nothing to bleed out. */
        .hero-banners{overflow:visible}
        .hero.hero--banners{position:relative;padding-bottom:24px;background:var(--c-white)}
        .hero-banners__dots{
          bottom:-17px;background:transparent;padding:0;gap:8px;
        }
        /* off-white ground now, not the artwork — needs its own contrast */
        .hero-banners__dot{background:rgba(20,20,20,.18)}
        .hero-banners__dot.is-active{background:var(--c-pink,#B73A92)}
        /* the progress bar hugs the slot's bottom edge; keep it on the image */
        .hero-banners__progress{bottom:0}
      }

      /* Products row — swipeable carousel on phones: ~2.5 cards in view
         (two full + a half-peek of the third to signal "swipe for more"). */
      @media (max-width: 720px){
        .products-row{padding:clamp(40px,10vw,72px) 0;overflow:hidden}
        .products-row__grid{
          display:flex!important;
          grid-template-columns:none!important;
          gap:12px!important;
          max-width:none!important;
          overflow-x:auto;
          scroll-snap-type:x proximity;
          -webkit-overflow-scrolling:touch;
          scroll-padding-left:20px;
          padding:6px 20px 16px;
          margin-inline:calc(50% - 50vw);   /* full-bleed so the 3rd card can peek at the edge */
          scrollbar-width:none;
        }
        .products-row__grid::-webkit-scrollbar{display:none}
        .products-row{padding-top:clamp(22px,6vw,40px)}
        /* Hide the "Explore the Shiōrra routine" heading on phones — lead
           straight into the products. */
        .products-row__head{display:none}
        /* Equal-height cards so every card's details line up row-for-row */
        .products-row__grid{align-items:stretch}
        .products-row__grid > .product-card{
          flex:0 0 62%;                 /* bigger cards — ~1.5 in view */
          scroll-snap-align:start;
          min-width:0;
          display:flex;flex-direction:column;
        }
        /* Cleaner cards on phones — drop the promo overlays */
        .product-card__badge,.product-card__discount{display:none!important}
        .products-row__title{font-size:clamp(30px,8.4vw,40px);line-height:1.08}
        .products-row__sub{font-size:15px}
        .product-card__body{padding:15px 15px 14px;flex:1 1 auto;display:flex;flex-direction:column}
        .product-card__cta{min-height:46px;padding:12px 14px;font-size:13.5px;letter-spacing:.02em}
        .product-card__name{font-size:16.5px;line-height:1.2}
        /* Clamp descriptions to exactly two lines so the rating + price below
           start at the same height on every card (fixes the "scattered" look). */
        .product-card__desc{font-size:13px;line-height:1.4;min-height:2.8em;margin-bottom:2px;
          display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
        .product-card__rating{font-size:12.5px}
        .product-card__price{margin-top:auto;padding-top:6px}
      }

      /* Trust row — the base grid (style.css) already gives a 2×2 at ≤760px
         via `grid-column: span 6` in a 12-col grid. Don't override the column
         count here (that breaks the span math); only restyle the badges into
         centered, icon-on-top cells on phones. */
      @media (max-width: 540px){
        .trust-row__inner{row-gap:26px!important}
        .trust-item{flex-direction:column;align-items:center;text-align:center;gap:8px}
        .trust-item__txt{text-align:center}
      }

      /* Trust grid — 3 col → 1 col on phones */
      @media (max-width: 720px){
        .trust-grid{padding:clamp(48px,10vw,96px) 0}
        .trust-grid__cols{grid-template-columns:1fr!important;gap:18px!important}
        .trust-grid h2{font-size:clamp(28px,7vw,42px);line-height:1.1}
        .trust-cell{padding:24px}
      }

      /* Quick-nav pills — keep tappable (≥44px) */
      @media (max-width: 720px){
        .quick-nav{padding:14px 0}
        .quick-nav__inner{gap:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;
          padding:4px 0;flex-wrap:nowrap;justify-content:flex-start}
        .quick-nav a{flex:0 0 auto;min-height:44px;padding:10px 14px;font-size:13px}
        .quick-nav__icon{width:28px;height:28px}
      }

      /* Company facts — 4 col → 2 col */
      @media (max-width: 720px){
        .company{padding:clamp(48px,11vw,96px) 0}
        .company__grid{gap:32px}
        .company__title{font-size:clamp(30px,7.5vw,46px);line-height:1.1}
        .company__lede{font-size:15px}
        .company__facts{grid-template-columns:repeat(2,1fr)!important;gap:14px!important}
        .company__fact{padding:18px}
        .company__fact-num{font-size:clamp(26px,6vw,36px)}
        .company__fact-lbl{font-size:12px}
      }

      /* Claims grid — 4 col → 2 col → 1 col */
      @media (max-width: 1024px){
        .claims__grid{grid-template-columns:repeat(2,1fr)!important;gap:18px!important}
      }
      @media (max-width: 560px){
        .claims__grid{grid-template-columns:1fr!important;gap:16px!important}
        .claims h2{font-size:clamp(28px,7vw,42px);line-height:1.1}
        .claim{padding:24px}
        .claims__stat{font-size:clamp(36px,9vw,56px)}
        .claims__stat-copy{font-size:14.5px}
      }

      /* Featured product editorial — 2 col → 1 col, reset reverse order */
      @media (max-width: 880px){
        .fp-feature{padding:clamp(48px,11vw,96px) 0}
        .fp-feature__layout{grid-template-columns:1fr!important;gap:28px!important}
        .fp-feature--reverse .fp-feature__layout{direction:ltr}
        .fp-feature__title{font-size:clamp(40px,10vw,72px)}
        .fp-feature__deck{font-size:15.5px;line-height:1.55}
        .fp-feature__specs{grid-template-columns:repeat(2,1fr)!important;gap:14px!important}
        .fp-feature__cta{flex-direction:column;align-items:stretch;gap:10px}
        .fp-feature__cta .btn{width:100%;min-height:50px;display:inline-flex;align-items:center;justify-content:center}
      }

      /* Stands grid — 4 col → 1 col, generous touch areas */
      @media (max-width: 720px){
        #stands.section{padding:clamp(48px,11vw,96px) 0}
        .stands__grid{grid-template-columns:1fr!important;gap:18px!important}
        .stands__head h2{font-size:clamp(28px,7vw,42px);line-height:1.1}
        .stands__head .lead{font-size:15px}
        .stand{padding:24px}
      }

      /* CTA band — buttons full width, headline scales */
      @media (max-width: 720px){
        .cta-band{padding:clamp(48px,11vw,96px) 0}
        .cta-band__grid{grid-template-columns:1fr!important;gap:24px!important;text-align:left}
        .cta-band h2{font-size:clamp(28px,7.5vw,44px);line-height:1.1}
        .cta-band__cta{flex-direction:column;align-items:stretch;gap:10px}
        .cta-band__cta .btn{width:100%;min-height:50px;display:inline-flex;align-items:center;justify-content:center}
      }

      /* Footer — columns stack, tappable links */
      @media (max-width: 720px){
        .footer__top{grid-template-columns:1fr 1fr!important;gap:28px!important}
        .footer__brand{grid-column:1/-1}
        .site-footer a,.footer__col a{min-height:36px;display:inline-block;line-height:36px}
        .footer__bottom{flex-direction:column;align-items:flex-start;gap:8px;text-align:left}
      }
      @media (max-width: 420px){
        .footer__top{grid-template-columns:1fr!important;gap:24px!important}
      }

      /* Header — nav icons tappable; the mobile menu lives in style.css */
      @media (max-width: 980px){
        .nav__icons a,.nav__toggle{min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center}
        .nav__cta .btn{min-height:44px;display:inline-flex;align-items:center}
      }

      /* Mobile nav slide-down: ensure Shop sub-items are tappable */
      @media (max-width: 980px){
        .nav__menu.is-open .nav__sub a,
        .nav__menu .nav__sub a{min-height:44px;padding-top:10px;padding-bottom:10px;display:flex;align-items:center}
        .nav__menu li > a{min-height:44px;display:flex;align-items:center}
      }

      /* Back-to-top — tappable target */
      @media (max-width: 720px){
        .back-to-top{width:48px;height:48px}
      }

      /* Hide the "Shop now" header CTA on mobile — the hamburger + icons
         carry navigation; the button crowds the bar on small screens. */
      @media (max-width: 720px){
        .nav__cta .btn{display:none}
      }
      .fp-feature__media{display:block;text-decoration:none;color:inherit;cursor:pointer}
</style>
</head>
