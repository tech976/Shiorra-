    <script>
      // Stand-in until the model shot is added, so the band never shows a
      // broken image — plus: shape the band to whatever the artwork actually
      // is, so it is never cropped at any width and a re-export needs no CSS
      // change. Same approach as the hero rotator above.
      (function () {
        var img = document.getElementById('bbandImg');
        if (!img) return;
        var band = img.closest('.bband');

        var fit = function () {
          if (!band || !img.naturalWidth || !img.naturalHeight) return;
          band.style.aspectRatio = img.naturalWidth + ' / ' + img.naturalHeight;
        };
        var swap = function () {
          var fb = img.getAttribute('data-fallback');
          if (!fb) return;
          img.removeAttribute('data-fallback');
          img.src = fb;            // load event below re-fits to the new file
        };

        if (img.complete && img.naturalWidth === 0) swap();
        else if (img.complete) fit();
        img.addEventListener('load', fit);
        img.addEventListener('error', swap);
      })();
    </script>

