    <!-- ============== BRAND BAND — blurred portrait + scrolling tagline ============== -->
    <style>
      /* Full-bleed band: the model shot sits behind at a light blur, with the
         tagline running across it on a seamless horizontal loop. Two identical
         sets slide to -50%; the inter-word gap lives INSIDE each set with a
         matching trailing pad, because a gap on the track itself would leave
         the seam half a gap short and the loop would visibly jump. */
      .bband{
        position:relative;overflow:hidden;isolation:isolate;
        /* PRE-LOAD PLACEHOLDER ONLY — the script below re-reads the file's
           real dimensions and sets aspect-ratio from them, so swapping the
           artwork never needs a CSS edit. Keep this close to the current file
           (1983x793) purely to avoid a first-paint jump. */
        aspect-ratio:1983 / 793;
        /* No min-height: it only ever bound on narrow screens, and there it
           forced a 2.5:1 photo into a ~1.5:1 box, so cover sliced the packs
           off both edges. Below 720px the band is simply as tall as the
           artwork's own ratio makes it. */
        min-height:0;
        background:#1E1A1C;
      }
      .bband__bg{position:absolute;inset:0;z-index:0}
      .bband__bg img{
        width:100%;height:100%;object-fit:cover;object-position:center 22%;display:block;
        /* light touch — enough to sit the type forward, not enough to lose her */
        filter:blur(1.5px);
        /* scaled up so the blur's soft edge never reaches the frame */
        transform:scale(1.06);
      }
      /* legibility scrim, heaviest through the middle where the type runs */
      .bband__scrim{
        position:absolute;inset:0;z-index:1;pointer-events:none;
        background:linear-gradient(180deg,rgba(22,12,16,.16) 0%,rgba(22,12,16,.46) 50%,rgba(22,12,16,.16) 100%);
      }
      .bband__track{
        position:absolute;top:50%;left:0;z-index:2;transform:translateY(-50%);
        display:flex;width:max-content;
        animation:bbandScroll 30s linear infinite;
      }
      .bband__set{display:flex;align-items:center;gap:56px;padding-right:56px}
      .bband__word{
        font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
        font-size:clamp(56px,9.6vw,150px);font-weight:800;letter-spacing:-0.025em;
        line-height:1;color:#fff;white-space:nowrap;text-transform:uppercase;
        text-shadow:0 2px 30px rgba(0,0,0,.28);
      }
      .bband__dot{
        width:clamp(10px,1.1vw,16px);aspect-ratio:1;flex:none;
        background:var(--c-pink,#E11D48);transform:rotate(45deg);border-radius:2px;
      }
      @keyframes bbandScroll{from{transform:translateY(-50%) translateX(0)}
                             to{transform:translateY(-50%) translateX(-50%)}}

      @media (max-width:720px){
        .bband__word{font-size:clamp(34px,10vw,66px)}
        .bband__set{gap:34px;padding-right:34px}
      }
      /* Motion off: park the loop and let the tagline sit centred instead. */
      @media (prefers-reduced-motion:reduce){
        .bband__track{animation:none;left:50%;transform:translate(-50%,-50%)}
        .bband__set:nth-child(2){display:none}
      }
    </style>

    <section class="bband" aria-label="Shiōrra — made for women, backed by science">
      <%
        // Lifted from the pack artwork ("MADE FOR WOMEN. BACKED BY SCIENCE."),
        // so the band echoes a line already in the brand's own voice.
        var _bbandLine = 'Made for women · Backed by science';
      %>
      <div class="bband__bg">
        <img id="bbandImg"
             src="/img/banners/home-scroll.png"
             data-fallback="/img/banners/banner-1.png"
             alt="" aria-hidden="true">
      </div>
      <div class="bband__scrim" aria-hidden="true"></div>

      <div class="bband__track">
        <% for (var _s = 0; _s < 2; _s++) { %>
          <div class="bband__set"<%- _s ? ' aria-hidden="true"' : '' %>>
            <% for (var _w = 0; _w < 3; _w++) { %>
