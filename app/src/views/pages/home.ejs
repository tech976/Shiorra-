    <!-- ============== TRUST ROW — quiet band of e-commerce trust signals ============== -->
    <section class="trust-row" aria-label="Trust signals">
        <div class="container">
            <div class="trust-row__inner">
                <div class="trust-item">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6Z"/><path d="m9 12 2 2 4-4"/></svg>
                    <div class="trust-item__txt">Doctor-recommended<small>For pregnancy &amp; postpartum</small></div>
