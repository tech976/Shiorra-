<!-- STICKY BUY BAR — standard mobile e-comm pattern (Myntra / Nykaa / Man Matters):
     the bar IS the purchase UI on phones. Buttons submit the main hero form via
     form= attribute, so the qty stepper value is respected. -->
<div class="sticky-cta" id="stickyCta">
  <div class="sticky-inner">
    <% if (!_soldOut) { %>
      <%# Mirrors the hero plan cards. Deliberately NOT part of addToCartForm:
          a second radio group named "bundle" inside the same form would merge
          with the hero's and the existing sync would only see half of them.
          A separate name plus two-way JS sync keeps one source of truth. %>
      <fieldset class="sb-plans" aria-label="Choose your plan">
        <% _packs.forEach(function (pk, i) { %>
          <label class="sb-plan<%= i === 0 ? ' is-selected' : '' %>">
            <input type="radio" name="bundleSticky" value="<%= pk.qty %>" data-qty="<%= pk.qty %>" <%= i === 0 ? 'checked' : '' %>>
            <span class="sb-plan__d"><%= pk.days %> Days &middot; <%= pk.qty %> Pack<%= pk.qty > 1 ? 's' : '' %></span>
            <span class="sb-plan__p"><%= _inr(pk.price) %><s><%= _inr(_mrp * pk.qty) %></s></span>
            <span class="sb-plan__s">Save <%= _off(pk) %>%</span>
          </label>
        <% }); %>
      </fieldset>
    <% } %>
    <div class="sticky-bar">
      <% if (_soldOut) { %>
        <button type="button" class="sticky-bar__btn sticky-bar__buy" disabled aria-disabled="true" style="opacity:.5;cursor:not-allowed">Sold out</button>
      <% } else { %>
        <button type="submit" form="addToCartForm" formaction="/cart/add" class="sticky-bar__btn sticky-bar__cart">Add to cart</button>
        <button type="submit" form="addToCartForm" class="sticky-bar__btn sticky-bar__buy">Buy now</button>
      <% } %>
    </div>
  </div>
</div>

<script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
<script src="/js/lenis-init.js"></script>
<script src="https://unpkg.com/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://unpkg.com/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script src="/js/award.js"></script>
<script src="/js/main.js"></script>
<script>
/* Publish the sticky topbar's real height as --topbar-h. The gallery sticks
   below it and anchor targets scroll clear of it, and the marquee's height
   changes with the breakpoint, so it is measured rather than hard-coded. */
(function () {
  const bar = document.getElementById('topbar');
  if (!bar) return;
  const set = () => document.documentElement.style
    .setProperty('--topbar-h', bar.offsetHeight + 'px');
  set();
  addEventListener('resize', set, { passive: true });
  // Web fonts land after first paint and change the ticker's line box.
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(set);
})();

/* Gallery — click a thumb to swap the main image */
(function () {
  const main = document.getElementById('galleryMain');
  const thumbs = document.querySelectorAll('.gallery-thumb');
  if (!main || !thumbs.length) return;
  const select = (t) => {
    const url = t.getAttribute('data-full');
    if (!url || main.src.endsWith(url)) return;
    thumbs.forEach((x) => x.classList.remove('is-active'));
    t.classList.add('is-active');
    main.src = url;
    // Keep the alt in step with the slide, otherwise it stays stuck
    // describing the first image for anyone using a screen reader.
    const label = t.getAttribute('aria-label');
    if (label) main.alt = 'Shiōrra Advanced EnergyOne+ — ' + label;
  };

  // Hover previews the slide on pointer devices; click still works everywhere
  // (and is the only path on touch, where there is no hover).
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  thumbs.forEach((t) => {
    t.addEventListener('click', () => select(t));
    if (canHover) t.addEventListener('mouseenter', () => select(t));
  });
})();
// Plan selection — one source of truth (the hidden quantity the cart posts),
// mirrored across the hero cards and the sticky bar's chips so the two can
// never disagree about what is in the basket.
(function () {
  const qtyInput = document.getElementById('bundleQty');
  const hero = document.querySelectorAll('.pi-plan input[name="bundle"]');
  const sticky = document.querySelectorAll('.sb-plan input[name="bundleSticky"]');
  if (!qtyInput || !hero.length) return;

  function apply(qty) {
    qtyInput.value = qty;
    const mark = (nodes, cls) => nodes.forEach((r) => {
      const on = (r.dataset.qty === qty);
      r.checked = on;
      const card = r.closest(cls);
      if (card) card.classList.toggle('is-selected', on);
    });
    mark(hero, '.pi-plan');
    mark(sticky, '.sb-plan');
  }

  hero.forEach((r) => r.addEventListener('change', () => apply(r.dataset.qty)));
  sticky.forEach((r) => r.addEventListener('change', () => apply(r.dataset.qty)));

  const initial = Array.prototype.find.call(hero, (r) => r.checked);
  apply(initial ? initial.dataset.qty : '1');
})();

// Sticky bar reveal — slides up once the hero's own buy row has scrolled off
// the top. Desktop only: on mobile the bar is the permanent purchase UI, and
// the hero row it watches is display:none there, so the observer would never
// fire and would leave the bar hidden.
(function () {
  const bar = document.getElementById('stickyCta');
  const anchor = document.querySelector('.pi-buy-form .pi-buy-row');
  if (!bar || !anchor || !('IntersectionObserver' in window)) return;

  const desktop = window.matchMedia('(min-width:721px)');
  const io = new IntersectionObserver(function (entries) {
    const e = entries[0];
    // scrolled past (row sits above the viewport) — not merely not-yet-reached
    bar.classList.toggle('is-visible', !e.isIntersecting && e.boundingClientRect.top < 0);
  }, { threshold: 0 });

  function wire() {
    io.disconnect();
    if (desktop.matches) io.observe(anchor);
    else bar.classList.remove('is-visible');
  }
  wire();
  desktop.addEventListener('change', wire);
})();

// Cert logos — a missing logo file reveals its line-icon fallback instead of
// leaving a broken image in the band.
(function () {
  document.querySelectorAll('.cert__ic img').forEach(function (img) {
    var fail = function () { img.parentNode.classList.add('is-fallback'); };
    if (img.complete && img.naturalWidth === 0) fail();
    img.addEventListener('error', fail);
  });
})();

// Key-ingredients shot — falls back to the stock pill photo until the
// dedicated single-pill cut-out is added.
(function () {
  var img = document.getElementById('kiPill');
  if (!img) return;
  var swap = function () {
    var fb = img.getAttribute('data-fallback');
    if (!fb) return;
    img.removeAttribute('data-fallback');
    img.src = fb;
  };
  if (img.complete && img.naturalWidth === 0) swap();
  img.addEventListener('error', swap);
})();

// FAQ — open on hover for mouse users, one at a time.
// Gated on a real hover-capable pointer: touch devices never fire hover, so
// they keep the native tap-to-toggle and are left completely alone. Keyboard
// users are covered by focusin/focusout, which is why suppressing the click
// toggle here does not strand them — Tab still reveals each answer.
(function () {
  var items = document.querySelectorAll('.fq-item');
  if (!items.length) return;
  if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;

  function openOnly(target) {
    items.forEach(function (d) { d.open = (d === target); });
  }

  items.forEach(function (d) {
    d.addEventListener('mouseenter', function () { openOnly(d); });
    d.addEventListener('mouseleave', function () { d.open = false; });
    d.addEventListener('focusin', function () { openOnly(d); });
    d.addEventListener('focusout', function (e) {
      if (!d.contains(e.relatedTarget)) d.open = false;
    });
    // Hover is the single source of truth on these devices; letting the native
    // click toggle run as well would fight it and strand items closed.
    var q = d.querySelector('.fq-q');
    if (q) q.addEventListener('click', function (e) { e.preventDefault(); });
  });
})();

// Social-proof viewer count — a fresh random 10-30 on each visit.
(function () {
  const el = document.getElementById('piViewers');
  if (!el) return;
  el.textContent = String(Math.floor(Math.random() * 21) + 10); // 10..30
})();
</script>
<%- include('../partials/cart-drawer') %>
</body>
</html>
