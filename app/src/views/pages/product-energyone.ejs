<style>
  /* Contained cards on white, not full-bleed colour blocks. Each card wears a
     pastel wash of its own product accent; the accent itself only survives at
     full strength in the badge text, which keeps two very different hues
     (green, magenta) sitting quietly side by side. */
  .pair{background:#fff;padding:72px 0 80px}
  .pair__head{text-align:center;margin-bottom:36px}
  /* .s-title carries max-width:760px from the shared section styles. Without
     auto side margins that is a left-hugging box with centred text inside —
     which reads as off-centre. This is the line that actually centres it. */
  .pair__head .s-title{margin-inline:auto;margin-bottom:10px}
  .pair__sub{font-size:16px;color:var(--muted);margin:0}

  /* auto-fit + justify-content:center so the row stays centred at ANY tile
     count — two tiles fill the 920px row exactly, a lone tile (e.g. while
     Ginger+ is down) sits centred instead of stranded in the left column. */
  .pair-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(0,448px));justify-content:center;gap:24px;max-width:920px;margin-inline:auto}

  /* Explicit grid rows AND columns: the form is deliberately assigned the
     media's own cell on desktop. Pinning only the row leaves the column to
     auto-placement, which finds row 1 col 1 taken and opens an implicit
     second column — parking the button beside the pack shot. */
  .pair-tile{
    position:relative;display:grid;grid-template-columns:minmax(0,1fr);align-content:start;
    border-radius:24px;padding:28px 28px 34px;text-align:center;
    background:var(--tile-soft);color:var(--ink);
    box-shadow:inset 0 0 0 1px rgba(40,40,40,.05);
    transition:background .28s ease,transform .28s ease,box-shadow .28s ease;
    isolation:isolate;
  }
  .pair-tile:hover,.pair-tile:focus-within{
    background:#fff;transform:translateY(-4px);
    box-shadow:inset 0 0 0 1px var(--line),0 18px 40px rgba(40,40,40,.11);
  }
  /* Whole card is clickable via a stretched pseudo-element on the product
     name, NOT by wrapping everything in an <a> — an anchor cannot legally
     contain the add-to-cart form, and nesting them makes the button fire the
     link too. The form sits on a higher layer so its clicks never reach it. */
  .pair-link{color:inherit;text-decoration:none}
  .pair-link::after{content:'';position:absolute;inset:0;z-index:1}
  .pair-link:focus-visible{outline:2px solid var(--ink);outline-offset:4px;border-radius:4px}
  .pair-media{grid-column:1;grid-row:1}
  .pair-name{grid-column:1;grid-row:2}
  .pair-price,.pair-sold{grid-column:1;grid-row:3}
  /* Own row, under the name and price, at EVERY width. It used to share the
     media's cell and fade in on hover, which meant the primary action was
     invisible until you hovered the card. z-index keeps it above the
     stretched .pair-link::after that makes the whole tile clickable. */
  .pair-form{
    margin:14px 0 0;grid-column:1;grid-row:4;justify-self:stretch;
    display:flex;justify-content:center;z-index:3;
  }

  /* Pack shots are landscape lifestyle photographs, not cut-outs on
     transparency, so they fill the frame (cover) rather than being
     letterboxed inside it (contain). */
  /* Deliberately NO z-index. With one, .pair-media stacked above the
     stretched .pair-link::after (z-index 1) and swallowed every click over
     the image — which is most of the card — leaving only the name/price
     strip clickable. At auto it paints below the link overlay. */
  .pair-media{
    position:relative;width:100%;border-radius:16px;overflow:hidden;
    background:#fff;aspect-ratio:1/1;
  }
  .pair-media img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .45s cubic-bezier(.2,.7,.3,1)}
  .pair-tile:hover .pair-media img{transform:scale(1.05)}

  .pair-badge{
