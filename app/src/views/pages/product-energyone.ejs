    font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
    background:rgba(255,255,255,.94);color:var(--tile-ink);padding:5px 10px;border-radius:999px;
  }

  /* Always visible — no reveal to wait for. Full width of the tile so it
     reads as the card's primary action rather than a floating pill. */
  .pair-cta{
    width:100%;height:50px;border-radius:999px;border:1.5px solid var(--ink);
    background:#fff;color:var(--ink);font-weight:800;font-size:13.5px;letter-spacing:.06em;
    text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;
    cursor:pointer;
