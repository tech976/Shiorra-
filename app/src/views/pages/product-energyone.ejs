<script>
// Drag the day — one slider, two meters. Curves are piecewise-linear over
// keyframes so the shape stays editable without touching the interpolation.
(function () {
  var range = document.getElementById('ddRange');
  if (!range) return;
  var clock = document.getElementById('ddClock'),
      stA  = document.getElementById('ddSa'), stB  = document.getElementById('ddSb'),
      clipR = document.getElementById('ddClipR'),
      headL = document.getElementById('ddHead'),
      dotA = document.getElementById('ddDotA'), dotB = document.getElementById('ddDotB');

  // [minutes-from-midnight, level 0-100]
  // Caffeine deliberately leads early — that is the honest part of its story,
  // and the contrast only means something if its peak is allowed to be high.
  // The two lines cross around midday, after which one holds and one does not.
  var CAFF = [[360,10],[450,14],[480,34],[540,74],[600,93],[630,95],[690,80],
              [750,52],[810,28],[870,18],[900,20],[960,44],[1000,45],[1080,28],
              [1170,18],[1260,12],[1320,10]];
  var OURS = [[360,18],[450,26],[540,40],[630,56],[690,66],[750,71],[840,73],
              [930,72],[1020,70],[1110,66],[1200,60],[1320,52]];

  function levelAt(curve, t) {
    if (t <= curve[0][0]) return curve[0][1];
    for (var i = 1; i < curve.length; i++) {
      if (t <= curve[i][0]) {
        var a = curve[i - 1], b = curve[i];
        return a[1] + (b[1] - a[1]) * ((t - a[0]) / (b[0] - a[0]));
      }
    }
    return curve[curve.length - 1][1];
  }

  // Each row gets its OWN vocabulary, for two reasons. A pure slope reading
  // called the caffeine line "Slipping" at the very top of its peak, and — far
  // worse — called EnergyOne+ "Spiking" while it climbed in the morning, which
  // contradicts the one claim this whole section exists to make. This formula
  // is never described as spiking or crashing, because it does neither.
  function slope(curve, t) {
    return levelAt(curve, t + 30) - levelAt(curve, t - 30);
  }
  function caffStatus(t) {
    var lvl = levelAt(CAFF, t), d = slope(CAFF, t);
    if (lvl >= 88) return 'Peaking';
    if (d > 8)     return 'Spiking';
    if (d < -8)    return 'Crashing';
    if (lvl <= 25) return t > 720 ? 'Crashed' : 'Low';
    if (d < -3)    return 'Slipping';
    if (d > 3)     return 'Climbing';
    return 'Flat';
  }
  function oursStatus(t) {
    var d = slope(OURS, t);
    if (d > 3)  return 'Building';
    if (d < -3) return 'Easing';
    return 'Steady';
  }

  function fmt(t) {
    var h = Math.floor(t / 60), m = t % 60, ap = h >= 12 ? 'PM' : 'AM';
    var hh = h % 12; if (hh === 0) hh = 12;
    return hh + ':' + (m < 10 ? '0' : '') + m + ' ' + ap;
  }

  // ---- graph ------------------------------------------------------------
  // Its own copies of the day bounds: the playback block below declares MIN and
  // MAX later, and these run at build time.
  var C_MIN = 360, C_MAX = 1320, CW = 1000, CH = 250, PAD_T = 16, PAD_B = 16;
  function cx(t) { return (t - C_MIN) / (C_MAX - C_MIN) * CW; }
  function cy(l) { return PAD_T + (1 - l / 100) * (CH - PAD_T - PAD_B); }
  function pathFor(curve) {
    var d = '';
    for (var t = C_MIN; t <= C_MAX; t += 4) {
      d += (t === C_MIN ? 'M' : 'L') + cx(t).toFixed(1) + ' ' + cy(levelAt(curve, t)).toFixed(1) + ' ';
    }
    return d;
  }
  function areaFor(d) { return d + 'L' + CW + ' ' + CH + ' L0 ' + CH + ' Z'; }

  var dA = pathFor(CAFF), dB = pathFor(OURS);
  [['ddGhostA', dA], ['ddGhostB', dB], ['ddLineA', dA], ['ddLineB', dB],
   ['ddFillA', areaFor(dA)], ['ddFillB', areaFor(dB)]].forEach(function (p) {
    var el = document.getElementById(p[0]);
    if (el) el.setAttribute('d', p[1]);
  });

  function render(t) {
    var x = cx(t);
    // the clip rect reveals the solid line and its fill up to now
    if (clipR) clipR.setAttribute('width', x.toFixed(1));
    if (headL) { headL.setAttribute('x1', x.toFixed(1)); headL.setAttribute('x2', x.toFixed(1)); }
    if (dotA) { dotA.setAttribute('cx', x.toFixed(1)); dotA.setAttribute('cy', cy(levelAt(CAFF, t)).toFixed(1)); }
    if (dotB) { dotB.setAttribute('cx', x.toFixed(1)); dotB.setAttribute('cy', cy(levelAt(OURS, t)).toFixed(1)); }
    stA.textContent  = caffStatus(t);
    stB.textContent  = oursStatus(t);
    clock.textContent = fmt(t);
  }

  // ---- playback -------------------------------------------------------
  var MIN = 360, MAX = 1320, SPAN = MAX - MIN;
  var DAY_MS = 17000,   // a full 6 AM -> 10 PM pass
      HOLD_MS = 1200;   // beat at 10 PM before looping back
  var btn = document.getElementById('ddPlay');
  var reduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var t = MIN, hold = 0, playing = false, prev = 0, raf = null, userPaused = false;

  function apply(v) { var r = Math.round(v); range.value = r; render(r); }

  function sync() {
    if (!btn) return;
    btn.classList.toggle('is-playing', playing);
    btn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
  }

  function frame(now) {
    if (!playing) return;
    if (!prev) prev = now;
    // Clamp the delta: a backgrounded tab hands back one enormous frame, which
    // would otherwise jump most of the day in a single step.
    var dt = Math.min(now - prev, 64); prev = now;

    if (hold > 0) {
      hold -= dt;
      if (hold <= 0) { t = MIN; apply(t); }     // loop back to the morning
    } else {
      t += SPAN * dt / DAY_MS;
      if (t >= MAX) { t = MAX; hold = HOLD_MS; }
      apply(t);
    }
    raf = requestAnimationFrame(frame);
  }

  function play() {
    if (playing) return;
    playing = true; prev = 0;
    t = +range.value;
    if (t >= MAX) { t = MIN; }                  // restart rather than sit at the end
    sync();
    raf = requestAnimationFrame(frame);
  }

  function pause() {
    if (!playing) return;
    playing = false;
    if (raf) { cancelAnimationFrame(raf); raf = null; }
    sync();
  }

  // A hand on the slider always wins, and it stays won — playback does not
  // creep back and start moving under them.
  range.addEventListener('input', function () {
    userPaused = true;
    pause();
    t = +range.value; hold = 0;
    render(t);
  });

  if (btn) btn.addEventListener('click', function () {
    if (playing) { userPaused = true; pause(); }
    else { userPaused = false; play(); }
  });

  // Only run while it is actually on screen: off-screen animation is wasted
  // battery, and it should not have silently played through before you arrived.
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { if (!userPaused && !reduced) play(); }
        else pause();
      });
    }, { threshold: .25 }).observe(range.closest('.dd-stage'));
  } else if (!reduced) {
    play();
  }

  if (reduced) {
    // No self-starting motion. Park it at the moment that makes the point,
    // rather than at an uninformative 6 AM. The play button still works if
    // someone asks for it.
    userPaused = true; t = 870; sync();
  }
  apply(t);
})();
</script>

<!-- KEY INGREDIENTS -->
<style>
  /* Three tracks: labels | product shot | labels. The outer tracks are 1fr
     each so the shot stays optically centred no matter how long the copy
     runs, and the columns mirror each other (right-aligned on the left,
     left-aligned on the right) so both point inward at the pill. */
  .ki{background:#fff}
  /* Explicit rows, not two independent flex columns: the left items carry a
     dosage sub-line and the right ones do not, so free-flowing columns drift
     out of step. Placing all four on a shared 2-row grid keeps each pair's
     headings on exactly the same baseline. */
  .ki-grid{
    display:grid;
    grid-template-columns:1fr minmax(280px,440px) 1fr;
    grid-template-rows:auto auto;
    column-gap:76px;row-gap:66px;align-items:start;
  }
  .ki-item{position:relative;max-width:300px}
  .ki-item:nth-of-type(1){grid-column:1;grid-row:1;justify-self:end;text-align:right}
  .ki-item:nth-of-type(2){grid-column:1;grid-row:2;justify-self:end;text-align:right}
  .ki-item:nth-of-type(3){grid-column:3;grid-row:1;justify-self:start;text-align:left}
  .ki-item:nth-of-type(4){grid-column:3;grid-row:2;justify-self:start;text-align:left}
  .ki-item h3{font-size:24px;font-weight:600;letter-spacing:-0.015em;color:var(--ink);margin:0 0 9px;line-height:1.2}
  .ki-item h3 span{display:block;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--honey-deep);margin-top:5px}
  .ki-item p{font-size:15px;font-weight:600;color:var(--muted);line-height:1.55;margin:0}
  .ki-media{grid-column:2;grid-row:1 / span 2;align-self:center;display:grid;place-items:center}
  /* multiply drops the shot's white studio backdrop out against the white
     section, so the pill reads as placed on the page rather than pasted. */
  /* The shot is 1536x1024 but the pill itself only occupies ~46% of that
     width — the rest is blank margin. Sizing the file to the column would
     render a small pill in a big empty box, so it is deliberately oversized
     past the column instead. Only the blank margin overflows; the pill
     itself still lands inside the centre track, clear of the connectors.
     multiply is what makes that safe — the overflowing white margin leaves
     anything behind it untouched instead of masking it.
     The enlargement is a transform rather than a width, deliberately:
     transforms do not feed back into layout, so the row stays as tall as the
     copy needs instead of inheriting ~150px of blank canvas above and below
     the pill. */
  .ki-media img{
    width:100%;max-width:440px;height:auto;display:block;
    /* The pill occupies 64.7% of the file's width, so it is scaled up to fill
       the column instead of floating small inside it. 1.35 lands it at the
       same optical size as the Iron+ pill (which needed 1.9, its cut-out
       carrying far more empty canvas). A transform, not a width, so the row
       height stays driven by the copy rather than by blank margin. */
    transform:scale(1.35);transform-origin:center;
  }

  /* ---- connectors: one per ingredient, aimed at the pill ---- */
  .ki-arrow{position:absolute;top:13px;height:2px;width:72px;pointer-events:none}
  .ki-arrow::before{content:'';position:absolute;top:50%;width:7px;height:7px;border-radius:50%;background:rgba(183,58,146,.4);transform:translateY(-50%)}
  .ki-arrow::after{content:'';position:absolute;top:50%;width:8px;height:8px}
  /* left pair — line runs rightward, arrowhead nearest the pill */
  .ki-item:nth-of-type(1) .ki-arrow,
  .ki-item:nth-of-type(2) .ki-arrow{left:100%;margin-left:14px;background:linear-gradient(90deg,rgba(183,58,146,.16),rgba(183,58,146,.8))}
  .ki-item:nth-of-type(1) .ki-arrow::before,
  .ki-item:nth-of-type(2) .ki-arrow::before{left:0}
  .ki-item:nth-of-type(1) .ki-arrow::after,
  .ki-item:nth-of-type(2) .ki-arrow::after{right:-1px;border-top:2px solid var(--honey);border-right:2px solid var(--honey);transform:translateY(-50%) rotate(45deg)}
  /* right pair — mirrored */
  .ki-item:nth-of-type(3) .ki-arrow,
  .ki-item:nth-of-type(4) .ki-arrow{right:100%;margin-right:14px;background:linear-gradient(270deg,rgba(183,58,146,.16),rgba(183,58,146,.8))}
  .ki-item:nth-of-type(3) .ki-arrow::before,
  .ki-item:nth-of-type(4) .ki-arrow::before{right:0}
  .ki-item:nth-of-type(3) .ki-arrow::after,
  .ki-item:nth-of-type(4) .ki-arrow::after{left:-1px;border-bottom:2px solid var(--honey);border-left:2px solid var(--honey);transform:translateY(-50%) rotate(45deg)}

  @media (max-width:980px){
    .ki-grid{grid-template-columns:1fr minmax(220px,330px) 1fr;column-gap:52px;row-gap:48px}
    .ki-media img{max-width:330px;transform:scale(1.32)}
    .ki-item h3{font-size:21px}
    .ki-item p{font-size:14px}
    .ki-arrow{width:46px;top:11px}
  }
  /* Below 760px the side-by-side reads as cramped columns — stack it, shot
     first, and centre the copy so the section keeps its symmetry. */
  @media (max-width:760px){
    .ki-grid{grid-template-columns:1fr;grid-template-rows:none;row-gap:24px}
    /* single column: reset every explicit placement and let source order rule,
       with the shot pulled to the top */
    .ki-media{grid-column:1;grid-row:1;margin-bottom:2px}
    .ki-media img{width:min(300px,62vw);max-width:none;transform:scale(1.3)}
    /* stacked: nothing sits beside the pill to point at */
    .ki-arrow{display:none}
    .ki-item:nth-of-type(1),.ki-item:nth-of-type(2),
    .ki-item:nth-of-type(3),.ki-item:nth-of-type(4){
      grid-column:1;grid-row:auto;justify-self:center;text-align:center;
    }
    .ki-item{max-width:430px}
    .ki-item h3{font-size:19px;margin-bottom:6px}
    .ki-item p{font-size:14px;line-height:1.5}
  }
</style>

