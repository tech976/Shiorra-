<!-- BENEFITS -->
<style>
  /* ============================================================
     BENEFITS — drag the day
     One slider drives two energy meters across a single day. Caffeine surges
     then collapses; this formula holds its level. Deliberately almost
     wordless: the movement carries the argument, not a paragraph.

     The comparison is with CAFFEINATED ENERGY PRODUCTS AS A CATEGORY. No
     brand is named or depicted, and no figure is claimed for anyone else —
     the meters are an illustrative pattern, captioned as such, built from
     claims already on this page (pack: "CAFFEINE FREE"; FAQ: "no spike, no
     crash and no disrupted sleep").
     ============================================================ */
  .dd{background:linear-gradient(180deg,#FFFFFF 0%,#FCF4F9 55%,#FFFFFF 100%);border-top:1px solid var(--line);padding:60px 0}
  .dd__head{text-align:center;margin-bottom:8px}
  .dd__head .s-title{margin-inline:auto;margin-bottom:0}
  .dd__hint{text-align:center;font-size:12.5px;color:var(--muted-2);margin:0 0 22px}


  /* 560px was sized for two small square cards. The stage now holds two
     cut-outs and a full-day curve, so it gets the room the wrap allows.
     A side effect worth keeping: the range input now spans the same width
     as the graph, so the thumb sits under the playhead it controls. */
  .dd-stage{max-width:1000px;margin-inline:auto}

  /* ---- the clock readout ---- */
  .dd-clockrow{display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:13px}
  .dd-clock{
    display:block;text-align:center;font-family:'Helvetica Neue',Arial,sans-serif;
    font-size:clamp(23px,3vw,30px);font-weight:800;letter-spacing:-0.035em;
    color:var(--honey);line-height:1;
    /* tabular figures — without them the clock jitters the whole row as the
       digits change during playback */
    font-variant-numeric:tabular-nums;
  }
  /* WCAG 2.2.2: content that moves on its own for more than five seconds needs
     a way to stop it. Dragging the slider pauses too, but that is not
     discoverable, so this is an explicit control. */
  .dd-play{
    flex:none;width:30px;height:30px;border-radius:50%;cursor:pointer;
    border:1.5px solid rgba(183,58,146,.35);background:#fff;color:var(--honey-deep);
    display:grid;place-items:center;padding:0;
    transition:background .2s ease,color .2s ease,border-color .2s ease;
  }
  .dd-play:hover{background:var(--honey);border-color:var(--honey);color:#fff}
  .dd-play:focus-visible{outline:2px solid var(--honey);outline-offset:2px}
  .dd-play svg{width:12px;height:12px;display:block}
  /* one button, two glyphs — swap on state rather than rewriting innerHTML */
  .dd-play .dd-play__pause{display:none}
  .dd-play.is-playing .dd-play__pause{display:block}
  .dd-play.is-playing .dd-play__play{display:none}

  /* ---- slider ---- */
  .dd-scrub{position:relative;padding:0 2px;margin-bottom:24px}
  .dd-range{
    -webkit-appearance:none;appearance:none;width:100%;height:32px;background:transparent;
    cursor:grab;display:block;margin:0;
  }
  .dd-range:active{cursor:grabbing}
  /* track + thumb need vendor-split rules; a combined selector is dropped
     wholesale by both engines */
  .dd-range::-webkit-slider-runnable-track{
    height:6px;border-radius:99px;
    background:linear-gradient(90deg,rgba(183,58,146,.30),rgba(183,58,146,.10));
  }
  .dd-range::-moz-range-track{
    height:6px;border-radius:99px;
    background:linear-gradient(90deg,rgba(183,58,146,.30),rgba(183,58,146,.10));
  }
  .dd-range::-webkit-slider-thumb{
    -webkit-appearance:none;appearance:none;width:22px;height:22px;border-radius:50%;
    background:#fff;border:2.5px solid var(--honey);margin-top:-8.5px;
    box-shadow:0 6px 18px rgba(107,34,85,.28);transition:transform .15s ease;
  }
  .dd-range::-moz-range-thumb{
    width:22px;height:22px;border-radius:50%;background:#fff;border:2.5px solid var(--honey);
    box-shadow:0 6px 18px rgba(107,34,85,.28);
  }
  .dd-range:active::-webkit-slider-thumb{transform:scale(1.12)}
  .dd-range:focus-visible{outline:none}
  .dd-range:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 4px rgba(183,58,146,.28)}
  .dd-ends{display:flex;justify-content:space-between;font-size:10.5px;font-weight:700;
    letter-spacing:.08em;text-transform:uppercase;color:var(--muted-2);margin-top:-4px}

  /* ---- the two cards ---- */
  /* Stays two columns on phones too — a stacked "side by side" is not a
     comparison any more, and these cards are small enough to hold up. */
  /* Two full-width rows, not two square cards. With the product shots gone
     there was nothing left in a card but a name and a bar, and a square frame
     around that is mostly empty. Stacked rows let the meter run the full width
     of the stage, which is what the scrubber is actually about, and puts the
     two bars directly above one another so the gap between them is the point. */
  /* ---- the two sides ----
     No card chrome at all: the lineup and the capsule sit straight on the
     section, which is what makes "seventeen of those, one of these" read as a
     picture rather than as two boxes. A drop-shadow does the lifting a card
     border used to do. Both files are 1536x1024 cut-outs, so the two columns
     align without either being cropped. */
  /* The lineup is landscape (1.5) and the pack panel is portrait (0.58), so
     they cannot both fill their column — one would tower over the other. They
     share a baseline instead: different footprints standing on the same shelf.
     The pack is sized RELATIVE TO THE COLUMN, not with a pixel cap, because
     what matters is its scale against the cans beside it. In the lineup file
     the tallest can is 64% of the frame, so at column width C the cans render
     ~0.42C tall; 32% of C puts the pack at ~1.3x a tall can — a 30-capsule
     carton, roughly life-size next to a Red Bull. Being a ratio, it holds at
     every breakpoint instead of drifting the way a px height did. */
  .dd-duo{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:end;margin:0 0 26px}
  .dd-side{display:flex;flex-direction:column;gap:10px;text-align:center}
  .dd-side__img{margin:0;order:-1;display:flex;align-items:flex-end;justify-content:center}
  .dd-side__img img{width:auto;max-width:100%;height:auto;display:block;
    filter:drop-shadow(0 20px 30px rgba(107,34,85,.16))}
  .dd-side--us .dd-side__img img{max-width:32%;border-radius:3px;filter:drop-shadow(0 14px 26px rgba(107,34,85,.22))}
  .dd-side__k{display:flex;align-items:center;justify-content:center;gap:8px;
    font-size:14px;font-weight:700;letter-spacing:-0.01em;color:var(--ink);line-height:1.3}
  .dd-side__k em{font-style:normal;color:var(--honey);font-weight:800}
  /* the swatch ties each side to its curve in the graph below */
  .dd-side__sw{width:10px;height:10px;border-radius:50%;background:#B0A0AB;flex:none}
  .dd-side--us .dd-side__sw{background:var(--honey)}
  /* the status word is the only copy that moves — a fixed line box stops the
     column from shifting as the word length changes */
  .dd-side__s{min-height:1.2em;font-size:11.5px;font-weight:800;letter-spacing:.09em;
    text-transform:uppercase;color:var(--muted-2);white-space:nowrap}
  .dd-side--us .dd-side__s{color:var(--honey-deep)}

  /* ---- the graph ----
     Same CAFF/OURS keyframes that used to drive the two bars — as curves the
     data finally shows its shape: one spikes and falls away, one climbs and
     holds. Ghost lines carry the whole day faintly so you can see where it is
     going; the solid line and its fill are revealed up to the playhead by a
     clip rect, so scrubbing draws the day rather than just moving a marker. */
  .dd-chartwrap{margin:0;position:relative}
  .dd-chart{display:block;width:100%;height:auto;overflow:visible}
  .dd-cv{fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}
  .dd-cv--a{stroke:#B0A0AB}
  .dd-cv--b{stroke:var(--honey)}
  .dd-cv--ghost{opacity:.26}
  .dd-fill{stroke:none}
  .dd-fill--a{fill:#B0A0AB;fill-opacity:.10}
  .dd-fill--b{fill:var(--honey);fill-opacity:.13}
  .dd-head{stroke:var(--honey-deep);stroke-width:1;stroke-dasharray:3 4;opacity:.45;vector-effect:non-scaling-stroke}
  .dd-dot{stroke:#fff;stroke-width:2.6;vector-effect:non-scaling-stroke}
  .dd-dot--a{fill:#9C8B97}
  .dd-dot--b{fill:var(--honey)}

  .dd-note{margin:20px 0 0;text-align:center;font-size:11.5px;line-height:1.55;color:var(--muted-2)}
  .dd-tags{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-top:13px}
  .dd-tags span{
    font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
    color:var(--honey-deep);background:var(--honey-soft);border-radius:999px;padding:5px 11px;
  }

  @media (max-width:760px){
    .dd{padding:48px 0}
    .dd__hint{margin-bottom:20px;font-size:12.5px}
    .dd-clockrow{gap:10px;margin-bottom:14px}
    .dd-play{width:34px;height:34px}
    .dd-scrub{margin-bottom:26px}
    .dd-duo{gap:14px;margin-bottom:16px}
    .dd-side__k{font-size:11.5px;gap:6px}
    .dd-side__sw{width:8px;height:8px}
    .dd-side__s{font-size:10px;letter-spacing:.07em}
    .dd-cv{stroke-width:2.2}
    .dd-note{text-align:left}
  }
  @media (prefers-reduced-motion:reduce){
  }
</style>

<section class="dd" aria-labelledby="ddTitle">
  <div class="wrap">
    <div class="dd__head">
      <span class="s-eyebrow">Benefits</span>
      <h2 class="s-title" id="ddTitle">A day, <em>side by side.</em></h2>
    </div>
    <p class="dd__hint">A full day, on loop &mdash; or drag it yourself.</p>

    <div class="dd-stage">
      <div class="dd-clockrow">
        <output class="dd-clock" id="ddClock" for="ddRange">6:00 AM</output>
        <button type="button" class="dd-play is-playing" id="ddPlay" aria-label="Pause">
          <svg class="dd-play__pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4.5" height="16" rx="1.4"/><rect x="13.5" y="4" width="4.5" height="16" rx="1.4"/></svg>
          <svg class="dd-play__play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.53.85l12-7.5a1 1 0 0 0 0-1.7l-12-7.5A1 1 0 0 0 7 4.5Z"/></svg>
        </button>
      </div>

      <figure class="dd-chartwrap">
        <svg class="dd-chart" id="ddChart" viewBox="0 0 1000 250" role="img"
             aria-label="Energy through the day. Caffeinated products rise sharply, peak late morning and fall away by mid-afternoon. EnergyOne+ climbs gradually and holds through the evening.">
          <defs>
            <clipPath id="ddClip"><rect id="ddClipR" x="0" y="0" width="0" height="250"/></clipPath>
          </defs>
          <path class="dd-cv dd-cv--a dd-cv--ghost" id="ddGhostA" d=""/>
          <path class="dd-cv dd-cv--b dd-cv--ghost" id="ddGhostB" d=""/>
          <g clip-path="url(#ddClip)">
            <path class="dd-fill dd-fill--a" id="ddFillA" d=""/>
            <path class="dd-fill dd-fill--b" id="ddFillB" d=""/>
            <path class="dd-cv dd-cv--a" id="ddLineA" d=""/>
            <path class="dd-cv dd-cv--b" id="ddLineB" d=""/>
          </g>
          <line class="dd-head" id="ddHead" x1="0" y1="0" x2="0" y2="250"/>
          <circle class="dd-dot dd-dot--a" id="ddDotA" r="5.5" cx="0" cy="0"/>
          <circle class="dd-dot dd-dot--b" id="ddDotB" r="5.5" cx="0" cy="0"/>
        </svg>
      </figure>

      <div class="dd-scrub">
        <%# A real range input: keyboard, screen-reader and touch support all
            come free, and it is the control people already know how to drag. %>
        <input class="dd-range" id="ddRange" type="range"
               min="360" max="1320" step="5" value="360"
               aria-label="Time of day">
        <div class="dd-ends"><span>6 AM</span><span>10 PM</span></div>
      </div>

      <%# The lineup is real, identifiable, trademarked packaging (Red Bull,
          Monster, Celsius, Bang, Reign, NOS, Starbucks, Lavazza, 5-hour
          Energy, Dunkin', McCafe and others). A deliberate client decision,
          taken with the comparative-advertising risk spelled out. The note
          under the graph can no longer claim brand neutrality, and must not
          be reverted to that wording while this image is here. Swapping this
          one src for an unbranded lineup is all it takes to de-risk it. %>
      <div class="dd-duo">
        <div class="dd-side dd-side--other" role="group" aria-labelledby="ddKa">
          <figure class="dd-side__img">
            <img src="/img/products/caffiene-products.png"
                 alt="A lineup of widely sold caffeinated drinks, shots, tablets and coffees"
                 loading="lazy" width="1536" height="1024">
          </figure>
          <span class="dd-side__k" id="ddKa"><i class="dd-side__sw" aria-hidden="true"></i>Most energy products</span>
          <span class="dd-side__s" id="ddSa">Climbing</span>
