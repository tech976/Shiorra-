        <div class="dd-side dd-side--us" role="group" aria-labelledby="ddKb">
          <figure class="dd-side__img">
            <%# Trimmed from the supplied print flat energy_frontpanel.png: that file
                carries registration marks at the corners and a glue flap at the
                bottom, neither of which belongs on a web page. Re-trim from the
                original if the artwork is re-exported. %>
            <img src="/img/products/energy-frontpanel-web.png"
                 alt="The front of the Shiorra Advanced EnergyOne+ pack"
                 loading="lazy" width="800" height="1383">
          </figure>
          <span class="dd-side__k" id="ddKb"><i class="dd-side__sw" aria-hidden="true"></i>Advanced <em>EnergyOne+</em></span>
          <span class="dd-side__s" id="ddSb">Steady</span>
